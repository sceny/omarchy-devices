#!/usr/bin/python3
"""KDE Connect bridge for the sceny.devices Omarchy shell plugin.

The shell has no generic D-Bus binding, and every shell-callable D-Bus client
(busctl, gdbus) opens a fresh connection per call. One Python process holding
one connection is cheaper and can also listen: `watch` prints a JSON snapshot
of every KDE Connect device on start, again shortly after any signal the
daemon emits, and every HEARTBEAT_SEC as a backstop. Unchanged snapshots are
not re-printed, so the shell only wakes when something moved.

  kdeconnect-bridge watch                          snapshot per line, until killed
  kdeconnect-bridge snapshot                       one snapshot, then exit
  kdeconnect-bridge ring <device>
  kdeconnect-bridge ping <device> [message]       a message shows in the notification
  kdeconnect-bridge clipboard <device>
  kdeconnect-bridge share <device> [path...]       no paths: open the file chooser
  kdeconnect-bridge text <device> <text>           lands on the device's clipboard
  kdeconnect-bridge url <device> <url>             opens on the device
  kdeconnect-bridge dial <device> <number>         the device's dialer, ready to call
  kdeconnect-bridge media <device> <PlayPause|Next|Previous>
  kdeconnect-bridge dismiss <device> <notification>
  kdeconnect-bridge reply <device> <replyId> <message>
  kdeconnect-bridge action <device> <notification> <action>
  kdeconnect-bridge pair|accept|reject|unpair <device>
  kdeconnect-bridge photos <device> [count]        the newest photos and screenshots on
                                              it, with thumbnails, as JSON
  kdeconnect-bridge photos-cached <device>         the last list, at once (from the cache)
  kdeconnect-bridge save-file <path> <name>        a copy in Pictures/<name>/
  kdeconnect-bridge received-dismiss <device> <path>   forget one received file
  kdeconnect-bridge open-file <path>               in its app (uwsm-app, GIO's default),
                                              else shown in Files
  kdeconnect-bridge copy-file <path>               the file on the clipboard
  kdeconnect-bridge doctor                    setup checks, as JSON
  kdeconnect-bridge fix install|start|firewall|sshfs|screen|search   fix one
                                              (install, firewall, sshfs and screen ask
                                              for a password; search looks for devices again)
  kdeconnect-bridge screen <device>                where its screen and apps stand, as JSON
  kdeconnect-bridge screen-pair <device>           pair adb over Wi-Fi with a QR code:
                                              JSON lines (qr, found, paired, connected, error)
  kdeconnect-bridge screen-open <device> [package] [label] [--tiled]   its screen,
                                              or one app, in a window here (scrcpy),
                                              docked by the bar unless --tiled (--at
                                              x,y,w,h: the panel's card); returns once
                                              the window is there
  kdeconnect-bridge screen-focus <device>          bring its open window forward
  kdeconnect-bridge screen-watch <device> <serial> --ctx <json>   keep its docked
                                              window in the device's shape; JSON lines
                                              (refit: turn or morph; revealed)
  kdeconnect-bridge screen-dock <device> on|off [--at x,y,w,h]   dock or undock
                                              its window (--at: where, on the monitor)
  kdeconnect-bridge screen-apps <device>           its apps, as JSON
  kdeconnect-bridge sms <device>                   text messages: JSON commands on
                                              stdin, JSON events on stdout

Actions print one human line and exit 0 on success, 1 when the user backed
out (closed the file chooser), 2 on failure.
"""

import base64
import concurrent.futures
import hashlib
import html
import ipaddress
import json
import shutil
import os
import quopri
import re
import shlex
import subprocess
import sys
import tempfile
import threading
import time
import urllib.parse

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

BUS_NAME = "org.kde.kdeconnect"
ROOT = "/modules/kdeconnect"
IFACE = "org.kde.kdeconnect"
CALL_TIMEOUT_MS = 2500
DEBOUNCE_MS = 250
HEARTBEAT_SEC = 30

EXIT_OK, EXIT_CANCELLED, EXIT_FAILED = 0, 1, 2


def bus():
    return Gio.bus_get_sync(Gio.BusType.SESSION, None)


def call(conn, path, iface, method, args=None, sig=None):
    params = GLib.Variant(sig, args) if sig else None
    result = conn.call_sync(BUS_NAME, path, iface, method, params, None,
                            Gio.DBusCallFlags.NONE, CALL_TIMEOUT_MS, None)
    return result.unpack() if result is not None else ()


def props(conn, path, iface):
    try:
        return call(conn, path, "org.freedesktop.DBus.Properties", "GetAll",
                    (iface,), "(s)")[0]
    except GLib.Error:
        return None


def device_path(device_id):
    return "%s/devices/%s" % (ROOT, device_id)


def daemon_running(conn):
    owner = conn.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus",
                           "org.freedesktop.DBus", "NameHasOwner",
                           GLib.Variant("(s)", (BUS_NAME,)), None,
                           Gio.DBusCallFlags.NONE, CALL_TIMEOUT_MS, None)
    return owner.unpack()[0]


# A conversation's text (WhatsApp, Signal, Messages...) comes from the daemon
# as markup it builds itself (kdeconnect-kde, getConversationMessages): each
# message's content HTML-escaped, a new sender as "<b>sender</b>\n" before
# it, messages joined by "<br/>". It is split on exactly those markers into
# plain {sender, text} pairs, never rendered: the entities become characters,
# so a message that says "<script>" is shown as those characters. Text that
# does not follow the format is one message from nobody, as it came.
CONVERSATION_BREAK = "<br/>"
SENDER_OPEN, SENDER_CLOSE = "<b>", "</b>\n"


def parse_conversation(markup):
    messages = []
    for chunk in str(markup or "").split(CONVERSATION_BREAK):
        sender = ""
        if chunk.startswith(SENDER_OPEN) and SENDER_CLOSE in chunk:
            end = chunk.index(SENDER_CLOSE)
            sender, chunk = chunk[len(SENDER_OPEN):end], chunk[end + len(SENDER_CLOSE):]
        messages.append({"sender": html.unescape(sender).strip(), "text": html.unescape(chunk).strip()})
    return [m for m in messages if m["sender"] or m["text"]]


def conversation_text(messages):
    """The whole conversation as plain lines, for where one string is read."""
    return "\n".join(("%s: %s" % (m["sender"], m["text"])) if m["sender"] else m["text"]
                     for m in messages)


def read_notifications(conn, dpath):
    npath = dpath + "/notifications"
    try:
        ids = call(conn, npath, IFACE + ".device.notifications",
                   "activeNotifications")[0]
    except GLib.Error:
        return None
    out = []
    for nid in ids:
        p = props(conn, "%s/%s" % (npath, nid),
                  IFACE + ".device.notifications.notification")
        if not p:
            continue
        icon = p.get("iconPath", "") if p.get("hasIcon") else ""
        text = p.get("text", "")
        conversation = parse_conversation(text) if p.get("isConversation") else []
        if conversation:
            text = conversation_text(conversation)
        out.append({
            "id": nid,
            "key": p.get("internalId", ""),
            "app": p.get("appName", ""),
            "title": p.get("title", ""),
            "text": text,
            "conversation": conversation,
            "ticker": p.get("ticker", ""),
            "dismissable": bool(p.get("dismissable", False)),
            "replyId": p.get("replyId", ""),
            "actions": list(p.get("actions", []) or []),
            "icon": safe_image(icon, NOTE_ICON_BOX) if icon else "",
            "silent": bool(p.get("silent", False)),
        })
    # activeNotifications is in arrival order; newest first reads better.
    out.reverse()
    return out


# Calls: KDE Connect's telephony plugin signals `callReceived(event, number,
# contactName)` for a ringing call (event "callReceived") and a missed one
# ("missedCall"), and for nothing else: not when the call is answered or ends
# (#60). A declined call arrives as missed. The last one per device is kept
# here, with when it came; how long it counts is the panel's to decide.
# KDE Connect puts the number in contactName when it has no name.
CALL_EVENTS = {"callReceived": "ringing", "missedCall": "missed"}


def call_event(event, number, name, at_ms):
    kind = CALL_EVENTS.get(str(event))
    if not kind:
        return None
    number, name = str(number or "").strip(), str(name or "").strip()
    return {"event": kind, "number": number,
            "name": "" if name == number else name, "at": int(at_ms)}


def read_device(conn, device_id, calls=None):
    dpath = device_path(device_id)
    d = props(conn, dpath, IFACE + ".device")
    if d is None:
        return None
    plugins = []
    try:
        plugins = list(call(conn, dpath, IFACE + ".device", "loadedPlugins")[0])
    except GLib.Error:
        pass
    has = lambda name: ("kdeconnect_" + name) in plugins

    dev = {
        "id": device_id,
        "name": d.get("name", ""),
        "type": d.get("type", ""),
        "reachable": bool(d.get("isReachable", False)),
        "paired": bool(d.get("isPaired", False)),
        "pairRequested": bool(d.get("isPairRequested", False)),
        "pairRequestedByPeer": bool(d.get("isPairRequestedByPeer", False)),
        # Shown while pairing, so both screens can be compared.
        "verificationKey": d.get("verificationKey", "") if (d.get("isPairRequested") or d.get("isPairRequestedByPeer")) else "",
        "links": list(d.get("activeProviderNames", []) or []),
        "addresses": list(d.get("reachableAddresses", []) or []),
        "can": {
            "ring": has("findmyphone"),
            "clipboard": has("clipboard"),
            "share": has("share"),
            "sms": has("sms"),
            "media": has("mprisremote"),
            "notifications": has("notifications"),
            "ping": has("ping"),
            "calls": has("telephony"),
            "files": has("sftp"),
        },
        "battery": None,
        "network": None,
        "notifications": [],
        "call": None,
    }

    # Away, or not paired: nothing more can be read from it.
    if not dev["reachable"] or not dev["paired"]:
        return dev

    if has("battery"):
        b = props(conn, dpath + "/battery", IFACE + ".device.battery")
        if b and b.get("hasBattery"):
            dev["battery"] = {"charge": int(b.get("charge", -1)),
                              "charging": bool(b.get("isCharging", False))}

    if has("connectivity_report"):
        c = props(conn, dpath + "/connectivity_report",
                  IFACE + ".device.connectivity_report")
        if c and c.get("cellularNetworkType"):
            dev["network"] = {"type": c.get("cellularNetworkType", ""),
                              "strength": int(c.get("cellularNetworkStrength", -1))}

    # Media is not read here: KDE Connect also exports every phone player as
    # an MPRIS player, which the shell tracks natively (Service.players). The
    # mprisremote object only ever shows one "current" player, which went
    # stale when the phone switched apps.

    if has("notifications"):
        n = read_notifications(conn, dpath)
        dev["notifications"] = n if n is not None else []

    dev["call"] = (calls or {}).get(device_id)
    return dev


def snapshot(conn, calls=None):
    try:
        if not daemon_running(conn):
            return {"daemon": False, "devices": []}
        # Every device the daemon knows: paired ones, and unpaired ones in reach
        # (to pair with, or asking to pair).
        ids = call(conn, ROOT, IFACE + ".daemon", "devices",
                   (False, False), "(bb)")[0]
    except GLib.Error as error:
        return {"daemon": False, "devices": [], "error": error.message}
    devices = []
    for device_id in ids:
        try:
            dev = read_device(conn, device_id, calls)
        except GLib.Error:
            dev = None
        if dev:
            devices.append(dev)
    return {"daemon": True, "devices": devices}


# ---- Last seen ---------------------------------------------------------------
#
# Where each paired device was while it was last connected: its link, its
# address and when. An away device's page says it ("last seen on Wi-Fi at
# 192.168.1.20, 12 min ago"), after a restart too: it is kept in the cache.
# While a device is connected its time moves on in memory and reaches the
# file at most every SEEN_SAVE_MS, so a restart is off by that at most.

SEEN_SAVE_MS = 5 * 60 * 1000


def state_dir():
    base = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    path = os.path.join(base, "sceny.devices")
    os.makedirs(path, exist_ok=True)
    return path


def seen_path():
    return os.path.join(state_dir(), "last-seen.json")


def load_seen(path):
    try:
        with open(path) as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def save_seen(path, seen):
    tmp = path + ".tmp"
    try:
        with open(tmp, "w") as f:
            json.dump(seen, f, sort_keys=True)
        os.replace(tmp, path)
    except OSError:
        pass


def note_seen(seen, devices, now_ms):
    """Updates `seen` from a snapshot's devices; returns whether the file
    should be written now: a device's link or address changed, it left, or
    the time of a connected one is SEEN_SAVE_MS old on disk."""
    write = False
    for d in devices:
        if not d.get("paired"):
            continue
        old = seen.get(d["id"])
        if d.get("reachable"):
            entry = {"link": (d.get("links") or [""])[0], "address": (d.get("addresses") or [""])[0],
                     "at": now_ms, "here": True, "saved": (old or {}).get("saved", 0)}
            if not old or not old.get("here") or old.get("link") != entry["link"] \
                    or old.get("address") != entry["address"] or now_ms - entry["saved"] >= SEEN_SAVE_MS:
                write = True
            seen[d["id"]] = entry
        elif old and old.get("here"):
            seen[d["id"]] = dict(old, here=False)
            write = True
    if write:
        for entry in seen.values():
            entry["saved"] = now_ms
    return write


def with_seen(snap, seen):
    """An away paired device carries where it was last seen, or None."""
    for d in snap.get("devices", []):
        s = seen.get(d["id"])
        d["lastSeen"] = {"link": s.get("link", ""), "address": s.get("address", ""), "at": s.get("at", 0)} \
            if s and d.get("paired") and not d.get("reachable") else None
    return snap


# ---- Files: received from a device, and its newest photos ----------------
#
# Received (#37): KDE Connect signals `shareReceived(url)` when a file
# arrives and keeps no history, so the list is ours: newest first, in the
# cache (received-<device>.json; file paths are private, so not shell.json).
# An entry goes when the user dismisses it or its file is gone.
#
# Gallery (#65): the device's storage, mounted by KDE Connect's sftp plugin
# (sshfs), read when the panel asks: the newest photos and videos as the
# phone's own gallery finds them. Android's media index (MediaStore) holds
# every image and video in shared storage except in hidden folders, folders
# marked .nomedia, and Android/data and Android/obb (apps' private files);
# an item's album is the folder that holds it (its "bucket"). Thumbnails are
# cached here.
#
RECEIVED_MAX = 50
IMAGE_EXTENSIONS = (".jpg", ".jpeg", ".png", ".webp", ".heic", ".heif", ".avif", ".gif", ".dng", ".jxl")
VIDEO_EXTENSIONS = (".mp4", ".mov", ".m4v", ".3gp", ".mkv", ".webm")
PHOTO_COUNT = 8
# Apps' private folders, under a storage root: not in the gallery.
MEDIA_SKIP = ("Android/data", "Android/obb")
# Every folder is a round trip to the phone, so each one's listing is kept
# (media-dirs.json) and listed again only when its date changed (a file
# added, removed or renamed in it). The first look lists everything, in at
# most MEDIA_SCAN_SEC; what it did not reach is read on the next look.
MEDIA_DEPTH = 12
MEDIA_SCAN_SEC = 60
MEDIA_THREADS = 16
MEDIA_DIRS = "media-dirs.json"
ALBUM_LINKS = 8
MOUNT_TIMEOUT_MS = 30000


def received_path(device_id):
    return os.path.join(state_dir(), "received-%s.json" % re.sub(r"[^A-Za-z0-9_-]", "_", device_id))


def load_received(path):
    try:
        with open(path) as f:
            data = json.load(f)
        return data if isinstance(data, list) else []
    except (OSError, ValueError):
        return []


def save_received(path, entries):
    tmp = path + ".tmp"
    try:
        with open(tmp, "w") as f:
            json.dump(entries, f)
        os.replace(tmp, path)
    except OSError:
        pass


def local_path(url):
    """The file a file:// URL names, or "" for anything else (text, links)."""
    parsed = urllib.parse.urlparse(str(url or ""))
    return urllib.parse.unquote(parsed.path) if parsed.scheme == "file" else ""


def note_received(entries, url, now_ms):
    """A new entry for a received file, newest first, once per path;
    returns whether the list changed. Text and links are not files."""
    path = local_path(url)
    if not path or not os.path.isfile(path):
        return False
    entries[:] = [e for e in entries if e.get("path") != path]
    entries.insert(0, {"path": path, "name": os.path.basename(path),
                       "size": os.path.getsize(path), "at": now_ms})
    del entries[RECEIVED_MAX:]
    return True


def rename_received(entries, old_path, new_path):
    """A listed file renamed in its folder (as its folder's watch reports
    it): the entry follows it. Returns whether one did."""
    changed = False
    for e in entries:
        if e.get("path") == old_path and new_path:
            e["path"] = new_path
            e["name"] = os.path.basename(new_path)
            changed = True
    return changed


class FolderWatch:
    """Watches the folders that hold received files, so a file deleted,
    moved away or renamed updates the list at once. One watch per folder,
    only while it holds a listed file; no file is held open. Best effort on
    any machine: a watch the system refuses (its limits, a network or FUSE
    folder) is skipped silently (a line on stderr would show as an error),
    and the existence check on every snapshot, at least every 30 s, still
    catches a deletion."""

    def __init__(self, on_event, make_monitor=None):
        self.on_event = on_event                  # (kind, path, new_path)
        self.make_monitor = make_monitor or self._gio_monitor
        self.monitors = {}                        # folder -> monitor

    @staticmethod
    def _gio_monitor(folder, callback):
        monitor = Gio.File.new_for_path(folder).monitor_directory(Gio.FileMonitorFlags.WATCH_MOVES, None)
        monitor.connect("changed", callback)
        return monitor

    def sync(self, folders):
        want = set(f for f in folders if f)
        for folder in list(self.monitors):
            if folder not in want:
                self.cancel(folder)
        for folder in want:
            if folder in self.monitors:
                continue
            try:
                self.monitors[folder] = self.make_monitor(folder, self.changed)
            except (GLib.Error, OSError):
                pass

    def cancel(self, folder):
        monitor = self.monitors.pop(folder, None)
        try:
            if monitor is not None:
                monitor.cancel()
        except (GLib.Error, OSError, AttributeError):
            pass

    def changed(self, _monitor, file, other, event):
        path = file.get_path() if file is not None else ""
        if event == Gio.FileMonitorEvent.RENAMED:
            self.on_event("renamed", path, other.get_path() if other is not None else "")
        elif event in (Gio.FileMonitorEvent.DELETED, Gio.FileMonitorEvent.MOVED_OUT):
            self.on_event("gone", path, "")


def prune_received(entries):
    """Drops entries whose file is gone (moved, deleted); returns whether
    any went."""
    kept = [e for e in entries if os.path.isfile(e.get("path", ""))]
    changed = len(kept) != len(entries)
    entries[:] = kept
    return changed


def media_kind(name):
    """"photo", "video", or None for a file that is not gallery media."""
    lower = name.lower()
    if lower.endswith(IMAGE_EXTENSIONS):
        return "photo"
    if lower.endswith(VIDEO_EXTENSIONS):
        return "video"
    return None


def scan_media(roots, known=None, depth=MEDIA_DEPTH, seconds=MEDIA_SCAN_SEC, clock=time.monotonic):
    """Every photo and video in the mounted storage roots (sftp's
    getDirectories), as the phone's gallery finds them: (found, albums,
    folders, complete). found: [{path, name, at, album, video}], newest
    first; albums: {folder: {name, path, count}}; folders: each folder's
    listing, {path: {m, n, f: [[name, at, video]], d: [names]}}, to pass back
    as `known` next time, when a folder whose date is the same is not listed
    again. Out of time, a folder already known is taken as it was; one never
    listed is left out and `complete` is false. A root inside another (some
    phones list DCIM/Camera apart) is read once."""
    known = known or {}
    folders, visited = {}, set()
    until = clock() + seconds
    complete = [True]

    def listing(folder):
        with os.scandir(folder) as it:
            entries = list(it)
        if any(e.name == ".nomedia" for e in entries):
            return {"n": True, "f": [], "d": []}
        files, dirs = [], []
        for e in entries:
            if e.name.startswith("."):
                continue
            try:
                if e.is_dir(follow_symlinks=False):
                    dirs.append(e.name)
                    continue
                kind = media_kind(e.name) if e.is_file(follow_symlinks=False) else None
                if kind:
                    files.append([e.name, int(e.stat().st_mtime * 1000), kind == "video"])
            except OSError:
                continue
        return {"n": False, "f": files, "d": sorted(dirs)}

    def resolve(folder):
        """The folder's listing: the known one while its date is the same,
        else read again; None when it cannot be read or was never read in
        time."""
        entry = known.get(folder)
        if clock() > until:
            # Taken as it was: a folder added since is not seen this time.
            complete[0] = False
            return entry
        try:
            mtime = os.stat(folder).st_mtime_ns
            if entry is None or entry.get("m") != mtime:
                entry = dict(listing(folder), m=mtime)
        except OSError:
            return None
        return entry

    # Level by level, each level's folders at once: every check is a round
    # trip to the phone, and sshfs answers many together.
    level = [(root.rstrip("/") or "/", "") for root in sorted(roots, key=len)]
    with concurrent.futures.ThreadPoolExecutor(max_workers=MEDIA_THREADS) as pool:
        for depth_now in range(depth + 1):
            level = [(f, rel) for f, rel in level if f not in visited and not visited.add(f)]
            if not level:
                break
            entries = list(pool.map(lambda fr: resolve(fr[0]), level))
            below = []
            for (folder, rel), entry in zip(level, entries):
                if entry is None:
                    continue
                folders[folder] = entry
                if depth_now < depth:
                    for name in entry["d"]:
                        sub = rel + "/" + name if rel else name
                        if sub not in MEDIA_SKIP:
                            below.append((os.path.join(folder, name), sub))
            level = below

    found, albums = [], {}
    for folder, entry in folders.items():
        if entry.get("n") or not entry["f"]:
            continue
        name = os.path.basename(folder)
        albums[folder] = {"name": name, "path": folder, "count": len(entry["f"])}
        for fname, at, video in entry["f"]:
            found.append({"path": os.path.join(folder, fname), "name": fname, "at": at, "album": name, "video": video})
    found.sort(key=lambda p: (-p["at"], p["name"]))
    return found, albums, folders, complete[0]


def album_links(albums, count=ALBUM_LINKS):
    """The biggest albums, as links that open them: [{name, path, count}]."""
    return sorted(albums.values(), key=lambda a: (-a["count"], a["name"]))[:count]


def thumb_name(photo):
    return hashlib.sha1(("%s|%d" % (photo["path"], photo["at"])).encode()).hexdigest()[:20] + ".jpg"


# A file from the phone is untrusted: a crafted image or video could exploit
# a decoder. Nothing here decodes it in this process or the shell's:
# - images go through GdkPixbuf, which on Omarchy decodes with glycin: each
#   decode in its own bubblewrap sandbox with a syscall filter;
# - a video's frame comes from ffmpegthumbnailer inside a bubblewrap sandbox
#   of ours (no network, no home, only that one file, read-only; limits on
#   memory, time and output), and is then decoded as an image is;
# - what the shell loads is a JPEG written here from the decoded pixels.
# Without the sandbox (no bwrap), a video gets no thumbnail; a photo larger
# than THUMB_MAX_BYTES gets none either. A tile without one shows its kind.
THUMB_SIZE = 256
THUMB_MAX_BYTES = 64 << 20
SANDBOX_SEC = 30
SANDBOX_MEMORY = 2 << 30
SANDBOX_OUTPUT = 32 << 20


def sandbox_args(cmd, inputs, out_dir):
    """bwrap around `cmd`: /usr read-only, nothing of the user's but the
    `inputs` ({path: inside}, read-only) and `out_dir` (at /out); no network,
    no other process, no environment."""
    args = ["bwrap", "--unshare-all", "--die-with-parent", "--new-session", "--clearenv",
            "--ro-bind", "/usr", "/usr", "--symlink", "usr/lib", "/lib", "--symlink", "usr/lib64", "/lib64",
            "--symlink", "usr/bin", "/bin", "--ro-bind-try", "/etc/ld.so.cache", "/etc/ld.so.cache",
            "--dev", "/dev", "--tmpfs", "/tmp", "--setenv", "HOME", "/tmp"]
    for path, inside in inputs.items():
        args += ["--ro-bind", path, inside]
    return args + ["--bind", out_dir, "/out", "--"] + cmd


def sandbox_limits():
    import resource
    resource.setrlimit(resource.RLIMIT_AS, (SANDBOX_MEMORY, SANDBOX_MEMORY))
    resource.setrlimit(resource.RLIMIT_FSIZE, (SANDBOX_OUTPUT, SANDBOX_OUTPUT))
    resource.setrlimit(resource.RLIMIT_CPU, (SANDBOX_SEC, SANDBOX_SEC))


def video_frame(src, out_dir):
    """A frame of the video as a PNG in out_dir, made in the sandbox; None
    without one."""
    if not shutil.which("bwrap"):
        return None
    cmd = ["/usr/bin/ffmpegthumbnailer", "-i", "/in/video", "-o", "/out/frame.png", "-s", "512", "-c", "png"]
    try:
        subprocess.run(sandbox_args(cmd, {src: "/in/video"}, out_dir), capture_output=True,
                       timeout=SANDBOX_SEC, preexec_fn=sandbox_limits)
    except (OSError, subprocess.SubprocessError):
        return None
    frame = os.path.join(out_dir, "frame.png")
    return frame if os.path.isfile(frame) and not os.path.islink(frame) else None


def square_thumb(src, dst, size=THUMB_SIZE):
    """A size x size JPEG of the image's middle, from its decoded pixels
    (GdkPixbuf: glycin's sandbox on Omarchy). False when it cannot be read."""
    try:
        gi.require_version("GdkPixbuf", "2.0")
        from gi.repository import GdkPixbuf
        pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(src, size * 3, size * 3, True)
        pix = pix.apply_embedded_orientation() or pix
        w, h = pix.get_width(), pix.get_height()
        scale = size / min(w, h)
        sw, sh = max(size, round(w * scale)), max(size, round(h * scale))
        scaled = pix.scale_simple(sw, sh, GdkPixbuf.InterpType.BILINEAR)
        square = scaled.new_subpixbuf((sw - size) // 2, (sh - size) // 2, size, size).copy()
        if square.get_has_alpha():
            # JPEG has no alpha (a PNG screenshot has): flattened on black.
            flat = GdkPixbuf.Pixbuf.new(GdkPixbuf.Colorspace.RGB, False, 8, size, size)
            flat.fill(0x000000ff)
            square.composite(flat, 0, 0, size, size, 0, 0, 1, 1, GdkPixbuf.InterpType.NEAREST, 255)
            square = flat
        tmp = dst + ".part"
        square.savev(tmp, "jpeg", ["quality"], ["85"])
        os.replace(tmp, dst)
        return True
    except (GLib.Error, ValueError, ImportError, OSError, ZeroDivisionError):
        return False


# Every other image from the device (a notification's icon, a track's art, a
# picture message's preview, a received picture) is shown only as a copy
# made here the same way: decoded through GdkPixbuf (glycin's sandbox),
# fitted in a box, written as a PNG of ours (alpha kept: icons have it). The
# copies are a cache, named by the source and its size and date, the least
# recently used removed past SAFE_MAX.
SAFE_SOURCE_MAX = 16 << 20
NOTE_ICON_BOX = 96
RECEIVED_PREVIEW_BOX = 128
MESSAGE_PREVIEW_BOX = 512
ART_BOX = 512
SAFE_MAX = 64 << 20


def safe_dir():
    path = os.path.join(state_dir(), "safe")
    os.makedirs(path, exist_ok=True)
    return path


def fit_image(src, dst, box, fmt="png"):
    """The image, fitted in box x box (never enlarged), from its decoded
    pixels (GdkPixbuf: glycin's sandbox on Omarchy), written as a PNG (alpha
    kept) or a JPEG (alpha flattened). False when it cannot be read."""
    try:
        gi.require_version("GdkPixbuf", "2.0")
        from gi.repository import GdkPixbuf
        _fmt, w, h = GdkPixbuf.Pixbuf.get_file_info(src)
        if _fmt is None:
            return False
        pix = GdkPixbuf.Pixbuf.new_from_file(src) if w <= box and h <= box else \
            GdkPixbuf.Pixbuf.new_from_file_at_scale(src, box, box, True)
        pix = pix.apply_embedded_orientation() or pix
        if pix.get_width() > box or pix.get_height() > box:
            scale = box / max(pix.get_width(), pix.get_height())
            pix = pix.scale_simple(max(1, round(pix.get_width() * scale)), max(1, round(pix.get_height() * scale)),
                                   GdkPixbuf.InterpType.BILINEAR)
        tmp = dst + ".part"
        if fmt == "jpeg":
            if pix.get_has_alpha():
                flat = GdkPixbuf.Pixbuf.new(GdkPixbuf.Colorspace.RGB, False, 8, pix.get_width(), pix.get_height())
                flat.fill(0x000000ff)
                pix.composite(flat, 0, 0, pix.get_width(), pix.get_height(), 0, 0, 1, 1, GdkPixbuf.InterpType.NEAREST, 255)
                pix = flat
            pix.savev(tmp, "jpeg", ["quality"], ["92"])
        else:
            pix.savev(tmp, "png", [], [])
        os.replace(tmp, dst)
        return True
    except (GLib.Error, ValueError, ImportError, OSError, ZeroDivisionError, TypeError):
        if os.path.exists(dst + ".part"):
            os.remove(dst + ".part")
        return False


# A picture from the device opened full size (a picture message's, a click):
# the viewer gets a JPEG decoded in the sandbox, never the device's bytes.
FULL_PICTURE_BOX = 4096


def safe_full_picture(src, cache=None, limit=None):
    """A full-size copy of a picture from the device, made in the sandbox,
    kept with the copies a click opens; "" when it cannot be read."""
    try:
        st = os.stat(src)
    except OSError:
        return ""
    cache = cache or open_cache()
    folder = os.path.join(cache, hashlib.sha1(("%s|%d|%d" % (src, st.st_size, int(st.st_mtime))).encode()).hexdigest()[:16])
    target = os.path.join(folder, os.path.splitext(os.path.basename(src))[0] + ".jpg")
    if os.path.isfile(target):
        os.utime(folder)
        return target
    os.makedirs(folder, exist_ok=True)
    if not fit_image(src, target, FULL_PICTURE_BOX, "jpeg"):
        shutil.rmtree(folder, ignore_errors=True)
        return ""
    os.utime(folder)
    trim_cache(cache, OPEN_CACHE_MAX if limit is None else limit, keep=folder)
    return target


def safe_image(src, box, folder=None, limit=SAFE_MAX):
    """The path of a safe copy of an image from the device (made once while
    the source is unchanged); "" when there is none."""
    try:
        st = os.stat(src)
    except (OSError, TypeError, ValueError):
        return ""
    if not os.path.isfile(src) or st.st_size > SAFE_SOURCE_MAX:
        return ""
    folder = folder or safe_dir()
    key = "%s|%d|%d|%d" % (src, st.st_size, int(st.st_mtime), box)
    dst = os.path.join(folder, hashlib.sha1(key.encode()).hexdigest()[:24] + ".png")
    if os.path.isfile(dst):
        os.utime(dst)
        return dst
    if not fit_image(src, dst, box):
        return ""
    trim_files(folder, limit, keep=dst)
    return dst


def trim_files(folder, limit, keep=None):
    """Removes the least recently used files until the folder fits."""
    entries = []
    for name in os.listdir(folder):
        path = os.path.join(folder, name)
        try:
            st = os.stat(path)
            entries.append((st.st_mtime, path, st.st_size))
        except OSError:
            continue
    total = sum(e[2] for e in entries)
    for _at, path, size in sorted(entries):
        if total <= limit:
            break
        if path != keep:
            try:
                os.remove(path)
                total -= size
            except OSError:
                pass


def make_thumb(src, dst, video=False):
    """A square thumbnail of a file from the device, decoded only in a
    sandbox (see above). False when there is none."""
    try:
        if video:
            work = tempfile.mkdtemp(dir=os.path.dirname(dst))
            try:
                frame = video_frame(src, work)
                return bool(frame) and square_thumb(frame, dst)
            finally:
                shutil.rmtree(work, ignore_errors=True)
        if os.path.getsize(src) > THUMB_MAX_BYTES:
            return False
        return square_thumb(src, dst)
    except OSError:
        return False


def photos(device_id, count=PHOTO_COUNT):
    """The device's newest photos and videos as JSON: {ok, photos, albums}
    or {ok: false, missing: "sshfs"} or {ok: false, error}."""
    if not shutil.which("sshfs"):
        return {"ok": False, "missing": "sshfs"}
    conn = bus()
    path = device_path(device_id) + "/sftp"
    iface = IFACE + ".device.sftp"
    try:
        result = conn.call_sync(BUS_NAME, path, iface, "mountAndWait", None, None,
                                Gio.DBusCallFlags.NONE, MOUNT_TIMEOUT_MS, None).unpack()
        if not result or not result[0]:
            error = call(conn, path, iface, "getMountError")[0]
            return {"ok": False, "error": error or "The device did not allow its storage"}
        roots = list(call(conn, path, iface, "getDirectories")[0].keys()) or [call(conn, path, iface, "mountPoint")[0]]
    except GLib.Error as error:
        return {"ok": False, "error": error.message}
    cache = photos_cache(device_id)
    dirs_path = os.path.join(cache, MEDIA_DIRS)
    try:
        with open(dirs_path) as f:
            known = json.load(f)
    except (OSError, ValueError):
        known = {}
    every, albums, folders, complete = scan_media(roots, known if isinstance(known, dict) else {})
    save_received(dirs_path, folders)
    found = every[:count]
    keep = {PHOTO_LIST, MEDIA_DIRS}
    for p in found:
        name = thumb_name(p)
        keep.add(name)
        thumb = os.path.join(cache, name)
        p["thumb"] = thumb if os.path.isfile(thumb) or make_thumb(p["path"], thumb, p["video"]) else ""
    for old in os.listdir(cache):
        if old not in keep:
            try:
                os.remove(os.path.join(cache, old))
            except OSError:
                pass
    save_received(os.path.join(cache, PHOTO_LIST), found)
    # The biggest albums, for the links that open them in the file manager.
    return {"ok": True, "photos": found, "albums": album_links(albums), "complete": complete}


# The last list read from the device, with its thumbnails: the panel shows it
# at once when it opens, while `photos` reads the device again.
PHOTO_LIST = "list.json"


def photos_cache(device_id):
    path = os.path.join(state_dir(), "photos", re.sub(r"[^A-Za-z0-9_-]", "_", device_id))
    os.makedirs(path, exist_ok=True)
    return path


def cached_photos(device_id):
    """The last list, only entries whose thumbnail is still here; {ok: false}
    when there is none."""
    entries = load_received(os.path.join(photos_cache(device_id), PHOTO_LIST))
    kept = [p for p in entries if isinstance(p, dict) and p.get("thumb") and os.path.isfile(p["thumb"])]
    return {"ok": True, "cached": True, "photos": kept} if kept else {"ok": False, "none": True}


def pictures_dir():
    """The user's Pictures folder (xdg-user-dir), else ~/Pictures."""
    try:
        out = subprocess.run(["xdg-user-dir", "PICTURES"], capture_output=True, text=True, timeout=5).stdout.strip()
        if out and out != os.path.expanduser("~"):
            return out
    except (OSError, subprocess.TimeoutExpired):
        pass
    return os.path.expanduser("~/Pictures")


def save_target(folder, name, size):
    """Where a copy of `name` goes in `folder`: its own name, else "name (2)"
    and on; None when the same file (same name and size) is already there."""
    base, ext = os.path.splitext(name)
    target, n = os.path.join(folder, name), 1
    while os.path.lexists(target):
        if os.path.isfile(target) and os.path.getsize(target) == size:
            return None
        n += 1
        target = os.path.join(folder, "%s (%d)%s" % (base, n, ext))
    return target


def save_file(path, device_name):
    """A copy of a file from the device in Pictures/<device name>/, with its
    own date; never over another file, and not twice."""
    if not os.path.isfile(path):
        return say("The file is gone", EXIT_FAILED)
    folder_name = re.sub(r"[/\\]", "_", device_name.strip()) or "Device"
    folder = os.path.join(pictures_dir(), folder_name)
    os.makedirs(folder, exist_ok=True)
    shown = os.path.join(os.path.basename(pictures_dir()), folder_name)
    target = save_target(folder, os.path.basename(path), os.path.getsize(path))
    if target is None:
        return say("Already in %s" % shown)
    try:
        shutil.copy2(path, target)
    except OSError as error:
        return say(str(error), EXIT_FAILED)
    return say("Saved to %s" % os.path.join(shown, os.path.basename(target)))


def file_uri(path):
    """A path as a file:// address, each part encoded apart."""
    return "file://" + "/".join(urllib.parse.quote(p) for p in path.split("/"))


def default_app(path):
    """The app the desktop opens this file with, following the type's
    parents as GIO does (JSON is text, so a text editor opens it; xdg-open
    looks up the exact type only and opens nothing). None when no app can."""
    if os.path.isdir(path):
        ctype = "inode/directory"
    else:
        ctype, _uncertain = Gio.content_type_guess(path, None)
    return Gio.AppInfo.get_default_for_type(ctype, False)


# Files from the device are opened from a copy here: an app reading over the
# network plays a video slower than its pace. The copies are a cache, the
# oldest removed first past OPEN_CACHE_MAX.
OPEN_CACHE_MAX = 2 << 30


def open_cache():
    path = os.path.join(state_dir(), "open")
    os.makedirs(path, exist_ok=True)
    return path


def local_copy(path, cache=None, limit=OPEN_CACHE_MAX):
    """A copy of the device's file in the cache, under its own name (apps
    show it): the one already there while the file is unchanged."""
    cache = cache or open_cache()
    st = os.stat(path)
    folder = os.path.join(cache, hashlib.sha1(path.encode()).hexdigest()[:16])
    target = os.path.join(folder, os.path.basename(path))
    try:
        t = os.stat(target)
        if t.st_size == st.st_size and int(t.st_mtime) == int(st.st_mtime):
            os.utime(folder)
            return target
    except OSError:
        pass
    os.makedirs(folder, exist_ok=True)
    tmp = target + ".part"
    shutil.copyfile(path, tmp)
    os.utime(tmp, (st.st_atime, st.st_mtime))
    os.replace(tmp, target)
    os.utime(folder)
    trim_cache(cache, limit, keep=folder)
    return target


def trim_cache(cache, limit, keep=None):
    """Removes the least recently opened copies until the cache fits."""
    entries = []
    for name in os.listdir(cache):
        folder = os.path.join(cache, name)
        try:
            size = sum(os.path.getsize(os.path.join(folder, f)) for f in os.listdir(folder))
            entries.append((os.stat(folder).st_mtime, folder, size))
        except OSError:
            continue
    total = sum(e[2] for e in entries)
    for _at, folder, size in sorted(entries):
        if total <= limit:
            break
        if folder != keep:
            shutil.rmtree(folder, ignore_errors=True)
            total -= size


def open_file(path, launch=None, local=False, from_device=False):
    """Opens a file in its app, as Omarchy launches apps (uwsm-app), or
    when no app can open its type, shows it selected in Files and says so.
    A file from the device (`local`: read over its storage; `from_device`:
    received) that is a picture opens as a copy decoded in the sandbox
    (safe_full_picture), never as the device's bytes; one that does not
    decode is not opened. `launch` runs a command (replaced in tests)."""
    launch = launch or (lambda cmd: subprocess.Popen(cmd, start_new_session=True,
                                                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))
    if not os.path.exists(path):
        return say("The file is gone", EXIT_FAILED)
    if (local or from_device) and os.path.isfile(path) and os.path.splitext(path)[1].lower() in IMAGE_EXTENSIONS:
        copy = safe_full_picture(path)
        if not copy:
            return say("This picture could not be read safely, so it was not opened", EXIT_FAILED)
        path = copy
    elif local and os.path.isfile(path):
        try:
            path = local_copy(path)
        except OSError as error:
            return say("Could not copy it from the device: %s" % error.strerror, EXIT_FAILED)
    if default_app(path) is None:
        launch(["uwsm-app", "--", "nautilus", "--select", file_uri(path)])
        ext = os.path.splitext(path)[1] or "these"
        return say("No app opens %s files here; shown in Files" % ext, EXIT_CANCELLED)
    launch(["uwsm-app", "--", "gio", "open", path])
    return EXIT_OK


def copy_file(path):
    """The file on the clipboard: an image as image data, anything else as
    a file (a URI list, as file managers copy)."""
    if not os.path.isfile(path):
        return say("The file is gone", EXIT_FAILED)
    ext = os.path.splitext(path)[1].lower().lstrip(".")
    mime = {"jpg": "image/jpeg", "jpeg": "image/jpeg", "png": "image/png", "webp": "image/webp"}.get(ext)
    try:
        if mime:
            with open(path, "rb") as f:
                subprocess.run(["wl-copy", "--type", mime], stdin=f, timeout=15, check=True)
        else:
            subprocess.run(["wl-copy", "--type", "text/uri-list"], input=("file://" + urllib.parse.quote(path) + "\n").encode(),
                           timeout=15, check=True)
    except (OSError, subprocess.SubprocessError) as error:
        return say(str(error), EXIT_FAILED)
    return say("Copied")


def watch():
    conn = bus()
    loop = GLib.MainLoop()
    state = {"pending": 0, "last": None}
    calls = {}
    seen = load_seen(seen_path())
    # Known here only while connected: a device away at start keeps the time
    # it left, not "now".
    for entry in seen.values():
        entry["here"] = False

    def emit():
        state["pending"] = 0
        snap = snapshot(conn, calls)
        # Received files, re-read each time (a dismiss writes the file from
        # another process), without the ones that are gone; their folders
        # are watched, so a change there comes at once (FolderWatch).
        ids, dirs = [], set()
        for d in snap.get("devices", []):
            if not d.get("paired"):
                continue
            path = received_path(d["id"])
            entries = load_received(path)
            if prune_received(entries):
                save_received(path, entries)
            # A picture shows as a safe copy (preview), never the file itself.
            d["received"] = [dict(e, preview=safe_image(e["path"], RECEIVED_PREVIEW_BOX)
                                  if os.path.splitext(e.get("path", ""))[1].lower() in IMAGE_EXTENSIONS else "")
                             for e in entries]
            ids.append(d["id"])
            dirs.update(os.path.dirname(e.get("path", "")) for e in entries)
        state["received_ids"] = ids
        folders.sync(dirs)
        if note_seen(seen, snap.get("devices", []), GLib.get_real_time() // 1000):
            save_seen(seen_path(), seen)
        line = json.dumps(with_seen(snap, seen), sort_keys=True, ensure_ascii=False)
        if line != state["last"]:
            state["last"] = line
            try:
                sys.stdout.write(line + "\n")
                sys.stdout.flush()
            except BrokenPipeError:
                loop.quit()
        return False

    def schedule(*_args):
        # Signals come in bursts (a notification posts, then updates, then the
        # battery refreshes); one snapshot after the burst settles is enough.
        if state["pending"]:
            GLib.source_remove(state["pending"])
        state["pending"] = GLib.timeout_add(DEBOUNCE_MS, emit)

    def heartbeat():
        schedule()
        return True

    def on_call(_conn, _sender, path, _iface, _signal, params):
        # /modules/kdeconnect/devices/<id>/telephony
        parts = path.split("/")
        if len(parts) < 2:
            return
        c = call_event(*params.unpack(), GLib.get_real_time() // 1000)
        if c:
            calls[parts[-2]] = c
        # The daemon forgets calls across a restart; so does this.

    def on_owner(*_args):
        calls.clear()

    def on_folder(kind, path, new_path):
        # A listed file renamed in its folder: its entry follows it. Gone
        # (deleted, moved away): the next snapshot's check drops it.
        if kind == "renamed":
            for device_id in state.get("received_ids", []):
                rpath = received_path(device_id)
                entries = load_received(rpath)
                if rename_received(entries, path, new_path):
                    save_received(rpath, entries)
        schedule()

    folders = FolderWatch(on_folder)

    def on_share(_conn, _sender, path, _iface, _signal, params):
        # /modules/kdeconnect/devices/<id>/share
        parts = path.split("/")
        if len(parts) < 2:
            return
        rpath = received_path(parts[-2])
        entries = load_received(rpath)
        if note_received(entries, params.unpack()[0], GLib.get_real_time() // 1000):
            save_received(rpath, entries)

    conn.signal_subscribe(BUS_NAME, IFACE + ".device.share", "shareReceived", None,
                          None, Gio.DBusSignalFlags.NONE, on_share)
    # Calls first, so the snapshot the next line schedules already has it.
    conn.signal_subscribe(BUS_NAME, IFACE + ".device.telephony", "callReceived", None,
                          None, Gio.DBusSignalFlags.NONE, on_call)
    conn.signal_subscribe("org.freedesktop.DBus", "org.freedesktop.DBus",
                          "NameOwnerChanged", "/org/freedesktop/DBus",
                          BUS_NAME, Gio.DBusSignalFlags.NONE, on_owner)
    # Every signal the daemon emits, on any object: device list, reachability,
    # pairing, battery, notifications, media. Subscribing by well-known name
    # follows the daemon across restarts.
    conn.signal_subscribe(BUS_NAME, None, None, None, None,
                          Gio.DBusSignalFlags.NONE, schedule)
    conn.signal_subscribe("org.freedesktop.DBus", "org.freedesktop.DBus",
                          "NameOwnerChanged", "/org/freedesktop/DBus",
                          BUS_NAME, Gio.DBusSignalFlags.NONE, schedule)
    GLib.timeout_add_seconds(HEARTBEAT_SEC, heartbeat)
    emit()
    loop.run()


def say(message, code=EXIT_OK):
    print(message, file=sys.stdout if code == EXIT_OK else sys.stderr)
    return code


def device_name(conn, device_id):
    d = props(conn, device_path(device_id), IFACE + ".device")
    return (d or {}).get("name", "phone")


def pick_files(title):
    try:
        out = subprocess.run(["omarchy-file-select", "--title", title, "--multiple"],
                             capture_output=True, text=True, timeout=660)
    except (OSError, subprocess.TimeoutExpired) as error:
        return None, str(error)
    if out.returncode == 1:
        return [], ""
    if out.returncode != 0:
        return None, (out.stderr or "file chooser failed").strip()
    return [p for p in out.stdout.splitlines() if p], ""


def act(argv):
    if len(argv) < 2:
        return say(__doc__.strip(), EXIT_FAILED)
    verb, device_id, rest = argv[0], argv[1], argv[2:]
    conn = bus()
    dpath = device_path(device_id)
    try:
        if verb == "ring":
            call(conn, dpath + "/findmyphone", IFACE + ".device.findmyphone", "ring")
            return say("Ringing %s" % device_name(conn, device_id))

        if verb in ("pair", "accept", "reject", "unpair"):
            method = {"pair": "requestPairing", "accept": "acceptPairing",
                      "reject": "cancelPairing", "unpair": "unpair"}[verb]
            call(conn, dpath, IFACE + ".device", method)
            name = device_name(conn, device_id)
            return say({"pair": "Asked %s to pair; accept on it" % name,
                        "accept": "Paired with %s" % name,
                        "reject": "Pairing with %s cancelled" % name,
                        "unpair": "Unpaired %s" % name}[verb])

        if verb == "ping":
            # sendPing is overloaded: no argument, or a message to show.
            message = " ".join(rest).strip()
            if message:
                call(conn, dpath + "/ping", IFACE + ".device.ping", "sendPing",
                     (message,), "(s)")
            else:
                call(conn, dpath + "/ping", IFACE + ".device.ping", "sendPing")
            return say("Pinged %s" % device_name(conn, device_id))

        if verb in ("text", "url"):
            value = " ".join(rest)
            if not value.strip():
                return say("Nothing to send", EXIT_CANCELLED)
            if verb == "url":
                call(conn, dpath + "/share", IFACE + ".device.share", "shareUrl",
                     (value.strip(),), "(s)")
                return say("Link sent to %s" % device_name(conn, device_id))
            call(conn, dpath + "/share", IFACE + ".device.share", "shareText",
                 (value,), "(s)")
            return say("Text sent to %s" % device_name(conn, device_id))

        if verb == "dial":
            # A tel: link: the phone opens its dialer on the number (or, from
            # the background, offers to in a notification). The call itself is
            # the user's tap on the phone.
            number = re.sub(r"[^\d+*#]", "", " ".join(rest))
            if not number:
                return say("No number to call", EXIT_CANCELLED)
            call(conn, dpath + "/share", IFACE + ".device.share", "shareUrl",
                 ("tel:" + number,), "(s)")
            return say("%s offers to call %s" % (device_name(conn, device_id), number))

        if verb == "clipboard":
            call(conn, dpath + "/clipboard", IFACE + ".device.clipboard", "sendClipboard")
            return say("Clipboard sent")

        if verb == "share":
            paths = rest
            if not paths:
                paths, error = pick_files("Send to %s" % device_name(conn, device_id))
                if paths is None:
                    return say(error, EXIT_FAILED)
                if not paths:
                    return say("Nothing sent", EXIT_CANCELLED)
            missing = [p for p in paths if not os.path.exists(p)]
            if missing:
                return say("Not found: %s" % missing[0], EXIT_FAILED)
            uris = [Gio.File.new_for_path(p).get_uri() for p in paths]
            call(conn, dpath + "/share", IFACE + ".device.share", "shareUrls",
                 (uris,), "(as)")
            if len(paths) == 1:
                return say("Sending %s" % os.path.basename(paths[0]))
            return say("Sending %d files" % len(paths))

        if verb == "media":
            action = rest[0] if rest else "PlayPause"
            if action not in ("PlayPause", "Play", "Pause", "Next", "Previous", "Stop"):
                return say("Unknown media action %s" % action, EXIT_FAILED)
            call(conn, dpath + "/mprisremote", IFACE + ".device.mprisremote",
                 "sendAction", (action,), "(s)")
            # The play/pause glyph already shows it worked; no status line.
            return EXIT_OK

        if verb == "dismiss":
            call(conn, "%s/notifications/%s" % (dpath, rest[0]),
                 IFACE + ".device.notifications.notification", "dismiss")
            return say("Dismissed")

        if verb == "reply":
            reply_id, message = rest[0], " ".join(rest[1:]).strip()
            if not message:
                return say("Empty reply", EXIT_CANCELLED)
            call(conn, dpath + "/notifications", IFACE + ".device.notifications",
                 "sendReply", (reply_id, message), "(ss)")
            return say("Reply sent")

        if verb == "action":
            nid, action = rest[0], rest[1]
            p = props(conn, "%s/notifications/%s" % (dpath, nid),
                      IFACE + ".device.notifications.notification") or {}
            call(conn, dpath + "/notifications", IFACE + ".device.notifications",
                 "sendAction", (p.get("internalId", nid), action), "(ss)")
            return say(action)
    except GLib.Error as error:
        message = error.message
        if "UnknownObject" in message or "No such object" in message:
            message = "The phone does not offer that right now"
        elif "ServiceUnknown" in message:
            message = "KDE Connect is not running"
        return say(message, EXIT_FAILED)
    except IndexError:
        return say("Missing argument for %s" % verb, EXIT_FAILED)

    return say("Unknown command %s" % verb, EXIT_FAILED)


# ---- Setup checks ----------------------------------------------------------
#
# What stands between the user and a working device: KDE Connect installed
# and running, the firewall letting it through on the local network, and a
# device paired. `doctor` reports; `fix` repairs one, only when asked. Root
# steps go through pkexec (the shell's polkit agent prompts); nothing here
# runs without the user's click.

KDE_PORTS = "1714:1764"
DAEMON_UNIT = "app-org.kde.kdeconnect.daemon@autostart.service"


def local_network():
    """The IPv4 network of the default route, e.g. 192.168.1.0/24."""
    try:
        route = json.loads(subprocess.run(["ip", "-j", "-4", "route", "show", "default"],
                                          capture_output=True, text=True, timeout=5).stdout or "[]")
        dev = route[0]["dev"]
        addr = json.loads(subprocess.run(["ip", "-j", "-4", "addr", "show", "dev", dev],
                                         capture_output=True, text=True, timeout=5).stdout or "[]")
        info = addr[0]["addr_info"][0]
        return str(ipaddress.ip_interface("%s/%s" % (info["local"], info["prefixlen"])).network)
    except (OSError, ValueError, KeyError, IndexError, subprocess.TimeoutExpired):
        return ""


def firewall_state():
    """ufw on or off, and whether KDE Connect's ports are allowed (TCP and
    UDP). ufw keeps its rules world-readable, so no root is needed to look."""
    try:
        enabled = any(line.strip() == "ENABLED=yes" for line in open("/etc/ufw/ufw.conf"))
    except OSError:
        return {"present": False, "active": False, "allowed": True}
    protos = set()
    try:
        for line in open("/etc/ufw/user.rules"):
            if line.startswith("### tuple ###") and " allow " in line and " %s " % KDE_PORTS in line:
                parts = line.split()
                if len(parts) > 5:
                    protos.add(parts[4])
    except OSError:
        pass
    return {"present": True, "active": enabled, "allowed": {"tcp", "udp"} <= protos or "any" in protos}


def doctor():
    checks = []
    installed = shutil.which("kdeconnect-cli") is not None
    checks.append({"key": "installed", "ok": installed, "label": "KDE Connect installed",
                   "status": "Installed" if installed else "Not installed",
                   "detail": "" if installed else "The kdeconnect package is not installed",
                   "fix": "" if installed else "install", "fixLabel": "Install"})
    running = False
    devices = []
    if installed:
        try:
            conn = bus()
            running = daemon_running(conn)
            if running:
                devices = snapshot(conn).get("devices", [])
        except GLib.Error:
            running = False
    checks.append({"key": "running", "ok": running, "label": "KDE Connect running",
                   "status": "Running" if running else "Stopped",
                   "detail": "" if running else "It starts at login; it is not running now",
                   "fix": "" if running or not installed else "start", "fixLabel": "Start"})
    fw = firewall_state()
    lan = local_network()
    fw_ok = not fw["active"] or fw["allowed"]
    checks.append({"key": "firewall", "ok": fw_ok,
                   "label": "Firewall lets devices in",
                   "status": ("Open to %s" % (lan or "the local network")) if fw["active"] and fw_ok
                             else ("Off" if fw["present"] else "None") if fw_ok else "Closed",
                   "detail": "" if fw_ok else "Ports %s are closed; allow them from %s" % (KDE_PORTS, lan or "the local network"),
                   "fix": "" if fw_ok else "firewall", "fixLabel": "Allow"})
    checks.append({"key": "network", "ok": bool(lan), "label": "On a network",
                   "status": lan or "No network",
                   "detail": "" if lan else "Join the Wi-Fi your devices are on",
                   "fix": "", "fixLabel": ""})
    paired = [d for d in devices if d.get("paired")]
    reachable = [d for d in paired if d.get("reachable")]
    checks.append({"key": "paired", "ok": len(paired) > 0, "label": "A device is paired",
                   "detail": "" if paired else "Open KDE Connect on the phone or tablet and pair it with this computer",
                   "fix": "", "fixLabel": ""})
    checks.append({"key": "reachable", "ok": len(reachable) > 0, "label": "A paired device is connected",
                   "detail": "" if reachable or not paired else "Same network as this computer, with the KDE Connect app running",
                   "fix": "", "fixLabel": ""})
    # Optional: only the screen and apps need it, so it never lights the
    # gear's dot.
    tools = screen_tools()
    checks.append({"key": "screen", "ok": tools["ok"], "optional": True, "label": "Screen and apps",
                   "status": ("scrcpy " + tools["version"]) if tools["ok"] else "Not installed",
                   "detail": "" if tools["ok"] else "Mirror a device and open its apps in windows here: scrcpy and adb",
                   # Installed: the next step is on a device, so it leads there.
                   "fix": "setup" if tools["ok"] else "screen", "fixLabel": "Set up a device" if tools["ok"] else "Install"})
    return {"checks": checks, "network": lan, "firewall": fw}


OMARCHY_BIN = os.path.join(os.environ.get("OMARCHY_PATH", "/usr/share/omarchy"), "bin")


def pkg_add(packages):
    """Omarchy's `omarchy pkg add`, as root through pkexec (the panel has no
    terminal for sudo). pkexec clears PATH, so Omarchy's bin goes back on it
    for the helpers the command calls."""
    return ["pkexec", "/usr/bin/env", "PATH=%s:/usr/bin:/bin" % OMARCHY_BIN,
            os.path.join(OMARCHY_BIN, "omarchy-pkg-add")] + list(packages)


def fix(what):
    if what == "search":
        # What `kdeconnect-cli --refresh` does: the daemon announces itself on
        # every network, and a device that hears it connects back. Nothing on
        # the system changes, and connected devices stay connected.
        try:
            call(bus(), ROOT, IFACE + ".daemon", "forceOnNetworkChange")
        except GLib.Error as error:
            return say(error.message, EXIT_FAILED)
        return say("Looking for devices on the network")
    if what == "install":
        cmd = pkg_add(["kdeconnect"])
    elif what == "start":
        if subprocess.run(["systemctl", "--user", "start", DAEMON_UNIT], timeout=15).returncode == 0:
            return say("KDE Connect started")
        daemon = "/usr/lib/kdeconnectd"
        if os.path.exists(daemon):
            subprocess.Popen([daemon], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return say("KDE Connect started")
        return say("Could not start KDE Connect", EXIT_FAILED)
    elif what == "sshfs":
        # KDE Connect mounts a device's storage with it (photos).
        cmd = pkg_add(["sshfs"])
    elif what == "screen":
        # The device's screen and apps here (scrcpy over adb); android-udev
        # lets adb reach a device on a USB cable.
        cmd = pkg_add(SCREEN_PACKAGES)
    elif what == "firewall":
        lan = local_network()
        if not lan:
            return say("Could not tell which network this computer is on", EXIT_FAILED)
        rules = " && ".join(
            "/usr/bin/ufw allow from %s to any port %s proto %s comment 'KDE Connect'" % (lan, KDE_PORTS, proto)
            for proto in ("tcp", "udp"))
        cmd = ["pkexec", "/bin/sh", "-c", rules]
    else:
        return say("Unknown fix %s" % what, EXIT_FAILED)
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=600)
    except (OSError, subprocess.TimeoutExpired) as error:
        return say(str(error), EXIT_FAILED)
    if out.returncode in (126, 127):
        return say("Not changed: the password prompt was dismissed", EXIT_CANCELLED)
    if out.returncode != 0:
        return say((out.stderr or out.stdout or "It did not work").strip().splitlines()[-1], EXIT_FAILED)
    if what == "firewall":
        return say("Firewall now allows KDE Connect from %s" % local_network())
    return say({"install": "KDE Connect installed", "sshfs": "sshfs installed: photos can show",
                "screen": "scrcpy and adb installed: set up a device's screen and apps"}[what])


# ---- Screen and apps (scrcpy over adb) -------------------------------------
#
# The device's screen, and its apps each in a window of their own, come from
# scrcpy over adb: KDE Connect offers neither (AGENTS.md, the boundary). adb
# reaches the device over Wi-Fi once it is paired through Android's Wireless
# debugging (Android 11 and later: the panel shows a QR code, the device
# scans it) or over a USB cable. The adb device is matched to the KDE
# Connect device by the device's own serial (ro.serialno), learnt when it
# pairs here (adb names the paired device) and kept in the cache, so a
# device reached at another address (a VPN, a second network) is still
# itself; failing that, by address (Wi-Fi) or by name (USB). Reading the
# state connects to a device adb already trusts; pairing and opening run
# only on the user's click.
#
# The device announces Wireless debugging over mDNS. Arch's adb is built
# without mDNS, so Avahi finds it: Omarchy installs and enables it, and its
# ufw rules let mDNS in.

SCREEN_PACKAGES = ["scrcpy", "android-tools", "android-udev"]
SCRCPY_APPS = (3, 0)    # --new-display and --start-app
SCRCPY_FLEX = (4, 0)    # --flex-display: the device's display follows the window
APPS_MIN_SDK = 29       # a virtual display to run an app on: Android 10
WIRELESS_MIN_SDK = 30   # Wireless debugging: Android 11
PAIR_WAIT_SEC = 120     # how long the QR code waits to be scanned
CONNECT_WAIT_SEC = 20
SCREEN_FILE = "screen.json"


def scrcpy_version(text):
    """(major, minor) from `scrcpy --version`, or () when it cannot be read."""
    m = re.search(r"scrcpy\s+(\d+)\.(\d+)", text or "")
    return (int(m.group(1)), int(m.group(2))) if m else ()


def screen_tools(run=subprocess.run):
    """Whether scrcpy and adb are here, and what this scrcpy can do."""
    scrcpy, adb = shutil.which("scrcpy"), shutil.which("adb")
    version = ()
    if scrcpy:
        try:
            version = scrcpy_version(run([scrcpy, "--version"], capture_output=True, text=True, timeout=10).stdout)
        except (OSError, subprocess.TimeoutExpired):
            pass
    return {"scrcpy": bool(scrcpy), "adb": bool(adb), "ok": bool(scrcpy and adb),
            "version": "%d.%d" % version if version else "",
            "apps": bool(version) and version >= SCRCPY_APPS, "flex": bool(version) and version >= SCRCPY_FLEX}


def parse_adb_devices(text):
    """`adb devices -l` as [{serial, state, usb, model}]."""
    out = []
    for line in (text or "").splitlines():
        parts = line.split()
        if len(parts) < 2 or line.startswith(("List of", "*")):
            continue
        extra = dict(p.split(":", 1) for p in parts[2:] if ":" in p)
        out.append({"serial": parts[0], "state": parts[1], "usb": "usb" in extra,
                    "model": extra.get("model", "").replace("_", " ")})
    return out


def parse_avahi(text):
    """`avahi-browse -rpt` (resolved, parsable) as [{name, kind, host,
    port}]: IPv4 entries of adb's two services, kind "pairing" (a device
    showing a pairing code or QR) or "connect" (Wireless debugging on). A
    line: =;iface;IPv4;name;type;domain;host;address;port;txt."""
    out = []
    for line in (text or "").splitlines():
        f = line.split(";")
        if len(f) < 9 or f[0] != "=" or f[2] != "IPv4" or "_adb-tls-" not in f[4] or not f[8].isdigit():
            continue
        out.append({"name": f[3], "kind": "pairing" if "pairing" in f[4] else "connect", "host": f[7], "port": int(f[8])})
    return out


def mdns_services():
    """What devices announce for adb now (Avahi), both services at once."""
    def browse(kind):
        try:
            return parse_avahi(subprocess.run(["avahi-browse", "-rpt", kind], capture_output=True,
                                              text=True, timeout=8).stdout)
        except (OSError, subprocess.TimeoutExpired):
            return []
    with concurrent.futures.ThreadPoolExecutor(2) as pool:
        return [s for found in pool.map(browse, ("_adb-tls-pairing._tcp", "_adb-tls-connect._tcp")) for s in found]


def parse_scrcpy_apps(text):
    """`scrcpy --list-apps` as [{name, package, system}]: a line holds
    "* " (system) or "- ", the name, then the package; a name of 30
    characters or more puts the package on the next line."""
    apps, pending = [], None
    for raw in (text or "").splitlines():
        line = re.sub(r"^\[server\]\s+\w+:\s?", "", raw)
        m = re.match(r"^ ([*-]) (.*?)\s+(\S+)$", line)
        if m and re.match(r"^[A-Za-z][\w]*(\.[\w]+)+$", m.group(3)):
            apps.append({"name": m.group(2).strip(), "package": m.group(3), "system": m.group(1) == "*"})
            pending = None
            continue
        m = re.match(r"^ ([*-]) (.+)$", line)
        if m:
            pending = {"name": m.group(2).strip(), "system": m.group(1) == "*"}
            continue
        m = re.match(r"^\s+([A-Za-z][\w]*(\.[\w]+)+)$", line)
        if m and pending:
            apps.append(dict(pending, package=m.group(1)))
            pending = None
    return apps


def pairing_qr(name, password):
    """What Android's *Pair device with QR code* reads: the name the device
    then announces itself under (mDNS), and the pairing password."""
    return "WIFI:T:ADB;S:%s;P:%s;;" % (name, password)


def serial_of_service(name):
    """The device's own serial in adb's mDNS name, adb-<serial>-<suffix>
    (also the guid `adb pair` prints), or ""."""
    m = re.match(r"^adb-(.+)-[^-]+$", (name or "").split(".")[0])
    return m.group(1) if m else ""


def paired_serial(out):
    """The serial of the device `adb pair` paired with, from its
    "Successfully paired to host:port [guid=adb-<serial>-<suffix>]"."""
    m = re.search(r"guid=([^\]\s]+)", out or "")
    return serial_of_service(m.group(1)) if m else ""


def adb_identity(d, mdns):
    """The device's own serial for an adb entry, from what adb and mDNS
    already say: a USB serial is it; a Wi-Fi one names it, or its
    host:port is an announced service's. "" when only the device knows."""
    serial = d["serial"]
    if d["usb"]:
        return serial
    if "._adb-tls-" in serial:
        return serial_of_service(serial)
    host, _, port = serial.rpartition(":")
    for s in mdns:
        if s["kind"] == "connect" and s["host"] == host and str(s["port"]) == port:
            return serial_of_service(s["name"])
    return ""


def match_adb(device, adb_devices, mdns, names=None, serial="", identities=None):
    """The adb serial for a KDE Connect device, and how it is reached:
    (serial, "wifi" | "usb", state) or (None, "", ""). The device's own
    serial (`serial`, remembered from pairing) matches first, USB before
    Wi-Fi; else over Wi-Fi the device's address (a serial "host:port", or
    an mDNS name whose host is the device's); else over USB its name
    (`names`: adb serial to the device's own name). `identities`: adb
    serial to the device's own serial, where asking the device found it."""
    ids = identities or {}
    if serial:
        mine = [d for d in adb_devices if (ids.get(d["serial"]) or adb_identity(d, mdns)) == serial]
        mine.sort(key=lambda d: (d["state"] != "device", not d["usb"]))
        if mine:
            return mine[0]["serial"], "usb" if mine[0]["usb"] else "wifi", mine[0]["state"]
    addresses = set(device.get("addresses") or [])
    hosts = {s["name"]: s["host"] for s in mdns if s["kind"] == "connect"}
    for d in adb_devices:
        if d["usb"]:
            continue
        host = d["serial"].rpartition(":")[0] if re.match(r"^[\d.]+:\d+$", d["serial"]) else hosts.get(d["serial"].split(".")[0], "")
        if host and host in addresses:
            return d["serial"], "wifi", d["state"]
    name = (device.get("name") or "").strip().lower()
    for d in adb_devices:
        if d["usb"] and name and ((names or {}).get(d["serial"], "").strip().lower() == name
                                   or d["model"].strip().lower() == name):
            return d["serial"], "usb", d["state"]
    return None, "", ""


def screen_record(device_id, update=None):
    """What this computer remembers of a device's screen setup (paired over
    Wi-Fi, when), in the cache: Wireless debugging turned off later reads as
    *off*, not as never set up."""
    path = os.path.join(state_dir(), SCREEN_FILE)
    try:
        data = json.load(open(path))
    except (OSError, ValueError):
        data = {}
    if update is None:
        return data.get(device_id, {})
    data[device_id] = dict(data.get(device_id, {}), **update)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f)
    os.replace(tmp, path)
    return data[device_id]


def adb(args, timeout=10):
    """One adb call: (exit code, stdout and stderr)."""
    try:
        out = subprocess.run(["adb"] + args, capture_output=True, text=True, timeout=timeout)
        return out.returncode, (out.stdout or "") + (out.stderr or "")
    except (OSError, subprocess.TimeoutExpired) as error:
        return 1, str(error)


def screen_device(device_id):
    """The KDE Connect device (name, addresses, reachable), or None."""
    for d in snapshot(bus()).get("devices", []):
        if d.get("id") == device_id:
            return d
    return None


def screen_status(device_id):
    """Where a device stands for its screen and apps, as JSON:

    state: tools (scrcpy or adb missing), away (not reachable on Wi-Fi or
           USB), pair (never set up), off (paired before; Wireless debugging
           is off now), unauthorized (USB: allow it on the device), ready.
    """
    tools = screen_tools()
    status = {"tools": tools, "state": "tools", "serial": "", "via": "", "sdk": 0, "android": "",
              "apps": False, "wireless": True, "seen": False, "display": [0, 0]}
    if not tools["ok"]:
        return status
    device = screen_device(device_id) or {"id": device_id}
    adb(["start-server"], timeout=15)
    mdns = mdns_services()
    addresses = set(device.get("addresses") or [])
    known = screen_record(device_id).get("serial", "")
    ours = lambda s: (known and serial_of_service(s["name"]) == known) or s["host"] in addresses
    # Wireless debugging on, seen before pairing: the steps on the device
    # before the code are done.
    status["seen"] = any(ours(s) for s in mdns)
    devices = parse_adb_devices(adb(["devices", "-l"])[1])
    # A Wi-Fi entry mDNS does not name (its port changed): ask the device.
    identities = {d["serial"]: adb(["-s", d["serial"], "shell", "getprop", "ro.serialno"])[1].strip()
                  for d in devices if known and not d["usb"] and d["state"] == "device" and not adb_identity(d, mdns)}
    serial, via, state = match_adb(device, devices, mdns, serial=known, identities=identities)
    if not serial:
        # A device adb trusts with Wireless debugging on shows up in mDNS
        # before adb connects to it by itself: connect now.
        for s in mdns:
            if s["kind"] == "connect" and ours(s):
                adb(["connect", "%s:%d" % (s["host"], s["port"])], timeout=CONNECT_WAIT_SEC)
                devices = parse_adb_devices(adb(["devices", "-l"])[1])
                serial, via, state = match_adb(device, devices, mdns, serial=known, identities=identities)
                break
    if not serial:
        usb = [d for d in devices if d["usb"]]
        names = {d["serial"]: adb(["-s", d["serial"], "shell", "settings", "get", "global", "device_name"])[1].strip()
                 for d in usb if d["state"] == "device"}
        serial, via, state = match_adb(device, devices, mdns, names)
        if not serial and any(d["state"] == "unauthorized" for d in usb):
            serial, via, state = next(d["serial"] for d in usb if d["state"] == "unauthorized"), "usb", "unauthorized"
    if not serial:
        status["state"] = "away" if not device.get("reachable") else \
            ("off" if screen_record(device_id).get("paired") else "pair")
        return status
    status.update(serial=serial, via=via)
    # Found by address or name: remember its own serial from now on.
    if state == "device" and not known:
        own = adb(["-s", serial, "shell", "getprop", "ro.serialno"])[1].strip()
        if own and " " not in own:
            screen_record(device_id, {"serial": own})
    if state != "device":
        status["state"] = "unauthorized" if state == "unauthorized" else "away"
        return status
    sdk = adb(["-s", serial, "shell", "getprop", "ro.build.version.sdk"])[1].strip()
    status["sdk"] = int(sdk) if sdk.isdigit() else 0
    status["android"] = adb(["-s", serial, "shell", "getprop", "ro.build.version.release"])[1].strip()
    status["display"] = list(device_display(serial))
    status["apps"] = tools["apps"] and status["sdk"] >= APPS_MIN_SDK
    status["wireless"] = status["sdk"] >= WIRELESS_MIN_SDK or status["sdk"] == 0
    status["state"] = "ready"
    return status


def screen_pair(device_id, wait=PAIR_WAIT_SEC, sleep=time.sleep, emit=None):
    """Pairs adb with the device over Wi-Fi, as Android Studio does: prints
    a QR code to show, waits for the device to scan it (it then announces
    the name in the code over mDNS), pairs with the password in the code,
    and connects. JSON lines on stdout: qr, found, paired, connected or
    error. Stops when the panel closes the page (the process is ended)."""
    emit = emit or (lambda ev: print(json.dumps(ev), flush=True))
    if not screen_tools()["ok"]:
        emit({"ev": "error", "message": "scrcpy and adb are not installed"})
        return EXIT_FAILED
    name = "sceny-" + base64.b32encode(os.urandom(5)).decode().lower().rstrip("=")
    password = base64.b32encode(os.urandom(10)).decode().lower().rstrip("=")
    payload = pairing_qr(name, password)
    ascii_code = ""
    try:
        ascii_code = subprocess.run(["qrencode", "-t", "ASCII", "-m", "0", payload],
                                    capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired):
        pass
    adb(["start-server"], timeout=15)
    emit({"ev": "qr", "ascii": ascii_code, "seconds": wait})
    found = None
    for _ in range(int(wait)):
        found = next((s for s in mdns_services() if s["kind"] == "pairing" and s["name"] == name), None)
        if found:
            break
        sleep(1)
    if not found:
        emit({"ev": "error", "message": "The code was not scanned in time"})
        return EXIT_CANCELLED
    emit({"ev": "found"})
    code, out = adb(["pair", "%s:%d" % (found["host"], found["port"]), password], timeout=30)
    if code != 0 or "Successfully paired" not in out:
        emit({"ev": "error", "message": (out.strip().splitlines() or ["Pairing failed"])[-1]})
        return EXIT_FAILED
    screen_record(device_id, dict({"paired": True, "at": int(time.time())},
                                  **({"serial": paired_serial(out)} if paired_serial(out) else {})))
    emit({"ev": "paired"})
    for _ in range(CONNECT_WAIT_SEC):
        service = next((s for s in mdns_services() if s["kind"] == "connect" and s["host"] == found["host"]), None)
        if service:
            adb(["connect", "%s:%d" % (service["host"], service["port"])], timeout=CONNECT_WAIT_SEC)
            break
        sleep(1)
    emit({"ev": "connected"})
    return EXIT_OK


# ---- The screen's window: docked or tiled (Hyprland) ----
#
# On Wayland a window cannot place itself, so scrcpy's own position flags do
# nothing: Hyprland does it. Docked is Omarchy's pop-out (floating, pinned on
# every workspace, tagged `pop`, opaque like Omarchy's picture-in-picture),
# in the device's own shape under its chip, where the panel's card is. A
# window rule set just before the launch (`hyprctl eval`) opens it there at
# once; an open window moves with dispatches by its address.
#
# Rectangles here are the card's: Hyprland draws a window's border outside
# its geometry, so the window itself is the rectangle inset by the border
# (inner), and window plus border cover the card exactly.

DOCK_HEIGHT = 0.7       # the docked window's box: of the monitor's height
DOCK_WIDTH = 0.45       # and of its width (a tablet in landscape meets this one)
DOCK_GAP = 10
WINDOW_WAIT_SEC = 20


def title_regex(title):
    """An exact match for a window title, for Hyprland's (RE2) rules."""
    return "^" + re.sub(r"([\\.^$|?*+()\[\]{}])", r"\\\1", title) + "$"


def lua_string(text):
    return json.dumps(text, ensure_ascii=False)


def parse_display(window_dump, wm_size=""):
    """The device's display as it is now, (width, height): `dumpsys window
    displays`' cur= follows rotation and, on a foldable, the screen in use;
    `wm size` (the override when set) is the fallback, upright."""
    m = re.search(r"\bcur=(\d+)x(\d+)", window_dump or "")
    if m:
        return int(m.group(1)), int(m.group(2))
    sizes = re.findall(r"(\d+)x(\d+)", wm_size or "")
    return (int(sizes[-1][0]), int(sizes[-1][1])) if sizes else (0, 0)


def device_display(serial):
    return parse_display(adb(["-s", serial, "shell", "dumpsys", "window", "displays"])[1],
                         adb(["-s", serial, "shell", "wm", "size"])[1])


def fit_display(display, box_w, box_h):
    """The device's display scaled to fit a box, (width, height): a phone
    meets the box's height, a tablet in landscape its width."""
    w, h = display if display and display[0] > 0 and display[1] > 0 else (9, 19.5)
    k = min(box_w / w, box_h / h)
    return round(w * k), round(h * k)


def dock_rect(ctx, display):
    """Model.dockRect, for the bridge: where the docked window goes for a
    display shape, under the device's chip as the panel places its card.
    ctx (from the panel): barPos, screenW, screenH, barW, barH, gap, margin,
    anchorX, anchorY, anchorW, anchorH. (x, y, w, h) on the monitor."""
    g = lambda k: float(ctx.get(k) or 0)
    side = ctx.get("barPos") in ("left", "right")
    room_w = g("screenW") - (g("barW") + g("gap") + g("margin") if side else 2 * g("margin"))
    room_h = g("screenH") - (2 * g("margin") if side else g("barH") + g("gap") + g("margin"))
    w, h = fit_display(display, min(room_w, g("screenW") * DOCK_WIDTH), min(room_h, g("screenH") * DOCK_HEIGHT))
    pos = ctx.get("barPos")
    if pos == "bottom":
        x, y = g("anchorX") + g("anchorW") / 2 - w / 2, g("screenH") - g("barH") - h - g("gap")
    elif pos == "left":
        x, y = g("barW") + g("gap"), g("anchorY") + g("anchorH") / 2 - h / 2
    elif pos == "right":
        x, y = g("screenW") - g("barW") - w - g("gap"), g("anchorY") + g("anchorH") / 2 - h / 2
    else:
        x, y = g("anchorX") + g("anchorW") / 2 - w / 2, g("barH") + g("gap")
    x = max(g("margin"), min(x, g("screenW") - w - g("margin")))
    y = max(g("margin"), min(y, g("screenH") - h - g("margin")))
    return round(x), round(y), w, h


def parse_ctx(text):
    """--ctx: the panel's chip geometry (JSON), or None."""
    try:
        ctx = json.loads(text or "")
        return ctx if isinstance(ctx, dict) else None
    except ValueError:
        return None


def parse_rect(text):
    """--at x,y,w,h (on the monitor) as a tuple, or None."""
    parts = (text or "").split(",")
    return tuple(int(float(p)) for p in parts) if len(parts) == 4 and all(re.match(r"^-?\d+(\.\d+)?$", p) for p in parts) else None


def border_size():
    try:
        return int(json.loads(subprocess.run(["hyprctl", "getoption", "general:border_size", "-j"],
                                             capture_output=True, text=True, timeout=5).stdout or "{}").get("int", 0))
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return 0


def inner(rect, border):
    """The window's own geometry for a card rectangle (x, y, w, h)."""
    x, y, w, h = rect
    return x + border, y + border, w - 2 * border, h - 2 * border


def dock_rule_lua(name, title, aspect, top, docked, rect=None, border=0):
    """Lua that sets (or replaces, or with docked False just ends) the rule
    docking windows titled `title`. The position names the docked width
    itself: a rule's window_w is the size before the rule's own.
    Handles are kept in a table of ours so a later launch replaces the rule
    instead of adding another."""
    lua = ("_G.sceny_devices_rules = _G.sceny_devices_rules or {}\n"
           "local old = _G.sceny_devices_rules[%s]\n"
           "if old then old:set_enabled(false) end\n"
           "_G.sceny_devices_rules[%s] = nil\n") % (lua_string(name), lua_string(name))
    if docked and rect:
        # Where the panel's card is, as the card ends its opening: the window
        # takes its place exactly and fades in (and out when it closes), as
        # Hyprland's pop-in at full size is a fade alone.
        x, y, w, h = inner(rect, border)
        lua += ("_G.sceny_devices_rules[%s] = hl.window_rule({ name = %s, match = { title = %s }, "
                "tag = \"+pop\", float = true, pin = true, animation = \"popin 100%%\", keep_aspect_ratio = true, "
                "opacity = \"1 1\", "
                "size = { %d, %d }, move = { %d, %d } })\n") % (
            lua_string(name), lua_string(name), lua_string(title_regex(title)), w, h, x, y)
    elif docked:
        h = "(monitor_h*%s)" % DOCK_HEIGHT
        lua += ("_G.sceny_devices_rules[%s] = hl.window_rule({ name = %s, match = { title = %s }, "
                "tag = \"+pop\", float = true, pin = true, keep_aspect_ratio = true, "
                "size = { \"(monitor_h*%s*%.4f)\", \"%s\" }, "
                "move = { \"(monitor_w-monitor_h*%s*%.4f-%d)\", \"(%d)\" } })\n") % (
            lua_string(name), lua_string(name), lua_string(title_regex(title)), DOCK_HEIGHT, aspect, h,
            DOCK_HEIGHT, aspect, DOCK_GAP, top + DOCK_GAP)
    return lua


def hypr_json(what):
    try:
        return json.loads(subprocess.run(["hyprctl", what, "-j"], capture_output=True, text=True, timeout=5).stdout or "[]")
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return []


def find_window(title):
    return next((c for c in hypr_json("clients") if c.get("title") == title), None)


def dock_geometry(mon, display, rect=None):
    """Where a docked window goes (`hyprctl monitors`): (width, height, x,
    y), in the desktop's coordinates. `rect` is the panel's (x, y, w, h on
    the monitor); without one, the device's display fitted to the box at
    the right edge under the bar."""
    if rect:
        x, y, w, h = rect
        return w, h, mon.get("x", 0) + x, mon.get("y", 0) + y
    scale = mon.get("scale") or 1
    mw, mh = mon.get("width", 1920) / scale, mon.get("height", 1080) / scale
    w, h = fit_display(display, mw * DOCK_WIDTH, mh * DOCK_HEIGHT)
    top = (mon.get("reserved") or [0, 0])[1]
    return w, h, round(mon.get("x", 0) + mw - w - DOCK_GAP), round(mon.get("y", 0) + top + DOCK_GAP)


def dock_window(win, docked, display, rect=None):
    """Docks an open window (floating, pinned, tagged `pop`, at the card's
    rectangle) or undocks it (tiled, unpinned), as Omarchy's pop-out does,
    by its address: the panel keeps the keyboard. Each step only when the
    window is not in that state already."""
    q = lua_string("address:" + win["address"])
    run = lambda lua: subprocess.run(["hyprctl", "dispatch", lua], capture_output=True, timeout=5)
    if docked:
        mon = next((m for m in hypr_json("monitors") if m.get("id") == win.get("monitor")), None) or {}
        w, h, x, y = dock_geometry(mon, display, rect)
        b = border_size()
        if not win.get("floating"):
            run('hl.dsp.window.float({ window = %s, action = "toggle" })' % q)
        run("hl.dsp.window.resize({ window = %s, x = %d, y = %d })" % (q, w - 2 * b, h - 2 * b))
        run("hl.dsp.window.move({ window = %s, x = %d, y = %d })" % (q, x + b, y + b))
        if not win.get("pinned"):
            run("hl.dsp.window.pin({ window = %s })" % q)
        run('hl.dsp.window.tag({ window = %s, tag = "+pop" })' % q)
    else:
        if win.get("pinned"):
            run("hl.dsp.window.pin({ window = %s })" % q)
        run('hl.dsp.window.tag({ window = %s, tag = "-pop" })' % q)
        if win.get("floating"):
            run('hl.dsp.window.float({ window = %s, action = "toggle" })' % q)


# ---- Re-fit: the docked window follows the device's shape ----
#
# While a docked window is open, `screen-watch` (run by the panel's service,
# JSON lines out) keeps it in the device's shape. scrcpy runs verbose, so its
# output (a log the watcher reads every 10 ms) says when the device's
# display changes, before the new picture is even sent:
#
#   [server] VERBOSE: DisplayMonitor: 1080x2316 [rotation=0] -> 2316x1080 [rotation=1]
#
# Then, in order: a `refit` event (the panel's ScreenTurn card appears over
# the window: a turn turns it, the way the device turned; anything else, a
# fold, morphs it); the window hides and moves under the card; scrcpy's
# "Texture: WxH" says the new picture arrived (scrcpy resizes its window
# then, so it is put back); once the picture is there and the card has
# had its head start (TURN_MIN_SEC), the window shows and `revealed` goes
# out, and the card fades over it wherever it is in its journey. "Texture" alone (an older scrcpy, a
# missed line) starts the same, a frame late. The window's size and the
# device's display are looked at as well, for a change the log missed. A
# window the user moved stays where they put it (placement). An undocked
# window is left alone; the watcher ends with the window.

WATCH_LOOK_SEC = 0.25
WATCH_ASK_SEC = 2
WATCH_LOG_SEC = 0.01
TURN_TRAVEL_SEC = 0.31  # the card's journey (Model.MOTION.outMs + inMs): the live window shows when it ends
TURN_STILL_SEC = 0.2    # a grab of the last picture, at most
TURN_WAIT_SEC = 1.5     # the new picture, at most; then the window shows anyway
LOG_MAX = 1 << 20       # verbose scrcpy logs every pointer move: emptied past this


def current_display(serial):
    """The display now and its rotation (0–3), asked of the device in two
    short lines: ((width, height), rotation)."""
    out = adb(["-s", serial, "shell", "dumpsys window displays | grep -m1 -oE 'cur=[0-9]+x[0-9]+'; "
               "dumpsys input | grep -m1 -oE 'SurfaceOrientation: [0-3]'"], timeout=8)[1]
    m = re.search(r"SurfaceOrientation: ([0-3])", out)
    return parse_display(out), int(m.group(1)) if m else -1


def parse_display_change(line):
    """scrcpy's server, verbose: the display changing, as ((w, h, rotation)
    before, (w, h, rotation) after), or None."""
    m = re.search(r"DisplayMonitor: (\d+)x(\d+) \[rotation=(\d)\] -> (\d+)x(\d+) \[rotation=(\d)\]", line or "")
    if not m:
        return None
    g = [int(v) for v in m.groups()]
    return (g[0], g[1], g[2]), (g[3], g[4], g[5])


def same_shape(a, b):
    """Two sizes of the same proportions (an encoder may round a side)."""
    return bool(a and b and a[1] and b[1]) and abs(a[0] / a[1] - b[0] / b[1]) < 0.02 * (a[0] / a[1])


def turn_of(old, new, old_rot=-1, new_rot=-1):
    """How the shape changed: ("turn", degrees) when width and height
    swapped, ("morph", 0) otherwise (a fold, an unfold, a new resolution).
    Degrees as Qt turns a picture (clockwise is positive), the way the
    device turned: Android's rotation is the drawing's, opposite to the
    device, so a step of 1 is the device turned counter-clockwise (-90).
    Rotation unknown: a quarter turn counter-clockwise."""
    step = (new_rot - old_rot) % 4 if old_rot >= 0 and new_rot >= 0 else -1
    if old and new and same_shape(old, (new[1], new[0])):
        return "turn", {1: -90, 2: 180, 3: 90}.get(step, -90)
    if step == 2 and same_shape(old, new):
        return "turn", 180   # upside down: the same shape, a half turn in place
    return "morph", 0


def placement(ctx, settled, old, new, mon):
    """Where the card goes for a new display shape, on the monitor: under
    the chip when the window was there (dock_rect); where the user moved it
    otherwise, keeping its centre and its size against the docked one,
    in the new shape and kept on the screen. `settled`: its last resting
    card rectangle (x, y, w, h on the monitor)."""
    home = dock_rect(ctx, old)
    if not settled or all(abs(a - b) <= 3 for a, b in zip(settled, home)):
        return dock_rect(ctx, new)
    sx, sy, sw, sh = settled
    _, _, nw, nh = dock_rect(ctx, new)
    k = max(sw / home[2], sh / home[3]) if home[2] and home[3] else 1
    w, h = round(nw * k), round(nh * k)
    scale = mon.get("scale") or 1
    mw, mh = mon.get("width", 1920) / scale, mon.get("height", 1080) / scale
    top = (mon.get("reserved") or [0, 0])[1]
    w, h = min(w, round(mw)), min(h, round(mh - top))
    x = max(0, min(round(sx + sw / 2 - w / 2), round(mw - w)))
    y = max(top, min(round(sy + sh / 2 - h / 2), round(mh - h)))
    return x, y, w, h


def refit(win, rect, mons, border=0):
    """The window put at the card rectangle `rect` (inset by the border):
    the dispatches to send, [] when it is there already."""
    x, y, w, h = inner(rect, border)
    mon = next((m for m in mons if m.get("id") == win.get("monitor")), None) or {}
    ax, ay = mon.get("x", 0) + x, mon.get("y", 0) + y
    if [ax, ay] == list(win.get("at") or []) and [w, h] == list(win.get("size") or []):
        return []
    q = lua_string("address:" + win["address"])
    return ["hl.dsp.window.resize({ window = %s, x = %d, y = %d })" % (q, w, h),
            "hl.dsp.window.move({ window = %s, x = %d, y = %d })" % (q, ax, ay)]


def resting(win, mons, border=0):
    """A window's card rectangle on its monitor: its geometry and border."""
    mon = next((m for m in mons if m.get("id") == win.get("monitor")), None) or {}
    return (win["at"][0] - mon.get("x", 0) - border, win["at"][1] - mon.get("y", 0) - border,
            win["size"][0] + 2 * border, win["size"][1] + 2 * border)


def turn_still(win, title, which):
    """A still of the window's own picture (grim -T: the window itself, by
    its toplevel id, even while it is hidden), taken on this computer: the
    old picture as the device starts to turn, the new one as it comes. The
    card turns them into each other, as Android does. Kept in memory
    ($XDG_RUNTIME_DIR) and removed after the turn; "" when it could not be
    grabbed in time."""
    folder = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir(), "sceny.devices")
    os.makedirs(folder, mode=0o700, exist_ok=True)
    path = os.path.join(folder, "turn-%s-%s-%d.ppm" % (hashlib.sha1(title.encode()).hexdigest()[:8], which, int(time.time() * 1000)))
    try:
        out = subprocess.run(["grim", "-t", "ppm", "-T", str(win.get("stableId", "")), path],
                             capture_output=True, timeout=TURN_STILL_SEC)
        return path if out.returncode == 0 and os.path.exists(path) else ""
    except (OSError, subprocess.TimeoutExpired):
        return ""


def read_ppm(path):
    """A binary PPM (grim -t ppm) as (width, height, bytes), or None."""
    try:
        data = open(path, "rb").read()
    except OSError:
        return None
    m = re.match(rb"P6\s+(\d+)\s+(\d+)\s+(\d+)\s", data)
    if not m:
        return None
    return int(m.group(1)), int(m.group(2)), data[m.end():]


def looks_stretched(old, new, grid=24):
    """Whether `new` is only `old` scaled to another size: the compositor
    shows a window's last picture stretched to its new size until the app
    draws again, and a still grabbed then is not the device's new picture.
    Compares a grid of points at the same place in both (0–1 across each)."""
    if not old or not new:
        return False
    (ow, oh, od), (nw, nh, nd) = old, new
    diff = 0
    for i in range(grid):
        for j in range(grid):
            u, v = (i + 0.5) / grid, (j + 0.5) / grid
            a = 3 * (int(v * oh) * ow + int(u * ow))
            b = 3 * (int(v * nh) * nw + int(u * nw))
            if a + 2 < len(od) and b + 2 < len(nd):
                diff += sum(abs(od[a + k] - nd[b + k]) for k in range(3))
    return diff / (grid * grid * 3) < 12


def window_prop(win, prop, value):
    q = lua_string("address:" + win["address"])
    subprocess.run(["hyprctl", "dispatch", 'hl.dsp.window.set_prop({ window = %s, prop = "%s", value = "%s" })' % (q, prop, value)],
                   capture_output=True, timeout=5)


def watch_lock(title):
    return os.path.join(state_dir(), "screen-watch-%s.pid" % hashlib.sha1(title.encode()).hexdigest()[:12])


def watch_running(lock):
    """A watcher holds the lock: its pid is alive and is a watcher (a pid
    the system gave to something else since does not count)."""
    try:
        pid = int(open(lock).read().strip() or 0)
        return b"screen-watch" in open("/proc/%d/cmdline" % pid, "rb").read()
    except (OSError, ValueError):
        return False


def screen_watch(device_id, serial, ctx, sleep=time.sleep, emit=None, clock=time.time):
    """Keeps the device's docked window in its shape, until the window
    closes. JSON lines: refit {kind, angle, from, to, monitor, device},
    revealed {device}."""
    emit = emit or (lambda ev: print(json.dumps(ev), flush=True))
    device = screen_device(device_id) or {}
    title = screen_title(device.get("name") or "Device")
    lock = watch_lock(title)
    if watch_running(lock):
        return EXIT_OK   # one watcher per window
    os.makedirs(os.path.dirname(lock), exist_ok=True)
    open(lock, "w").write(str(os.getpid()))
    try:
        for _ in range(20):   # the window may still be opening
            if find_window(title):
                break
            sleep(WATCH_LOOK_SEC)
        border = border_size()
        shape, rot = current_display(serial)
        log = open(screen_log(title), "r", errors="replace") if os.path.exists(screen_log(title)) else None
        if log:
            log.seek(0, os.SEEK_END)
        win, mons = find_window(title), hypr_json("monitors")
        if not win:
            return EXIT_OK
        looked = asked = clock()
        settled = resting(win, mons, border)
        pending = None   # a turn under way: {to, since, picture}

        def carry(new, kind_angle, picture):
            """The card event (with a still of the last picture when the new
            one has not come yet), then the hidden window moved under it."""
            nonlocal shape, settled, pending
            mon = next((m for m in mons if m.get("id") == win.get("monitor")), None) or {}
            to = placement(ctx, settled, shape, new, mon)
            kind, angle = kind_angle
            still = "" if picture else turn_still(win, title, "old")
            emit({"ev": "refit", "kind": kind, "angle": angle, "from": list(settled), "to": list(to),
                  "monitor": mon.get("name", ""), "device": device_id, "still": still})
            window_prop(win, "no_anim", "1")
            window_prop(win, "opacity", "0")
            for lua in refit(win, to, mons, border):
                subprocess.run(["hyprctl", "dispatch", lua], capture_output=True, timeout=5)
            shape, settled = tuple(new[:2]), tuple(to)
            pending = {"to": to, "since": clock(), "picture": picture, "picture_at": clock() if picture else None,
                       "still": still, "stills": [still] if still else []}
            if picture:
                new_picture()

        def new_picture():
            """The device's new picture is in the hidden window: a still of
            it goes to the card, which turns into it. A grab that is only the
            old picture stretched (drawn before the app redrew at its new
            size) is taken again, a few times."""
            old = read_ppm(pending["still"]) if pending.get("still") else None
            fresh = ""
            for _ in range(10):
                sleep(0.03)
                if fresh and os.path.exists(fresh):
                    os.remove(fresh)
                fresh = turn_still(find_window(title) or win, title, "new")
                if not fresh or not looks_stretched(old, read_ppm(fresh)):
                    break
            if fresh:
                pending["stills"].append(fresh)
                emit({"ev": "picture", "device": device_id, "still": fresh})

        def reveal():
            """The new picture is there: the window,
            put back where scrcpy's own resize moved it from, shows under
            the card, which then fades."""
            nonlocal pending, win
            win = find_window(title) or win
            for lua in refit(win, pending["to"], mons, border):
                subprocess.run(["hyprctl", "dispatch", lua], capture_output=True, timeout=5)
            window_prop(win, "opacity", "1 1")
            # How long the device took for its new picture, and when the
            # window showed (the service logs it).
            at = pending.get("picture_at")
            emit({"ev": "revealed", "device": device_id,
                  "picture_ms": round((at - pending["since"]) * 1000) if at else None,
                  "shown_ms": round((clock() - pending["since"]) * 1000)})
            sleep(0.15)   # the card's fade, over the window
            window_prop(win, "no_anim", "0")
            for p in pending.get("stills", []):
                threading.Timer(2.0, lambda p=p: os.path.exists(p) and os.remove(p)).start()
            pending = None

        while True:
            change, texture = None, None
            if log:
                for line in log.readlines():
                    change = parse_display_change(line) or change
                    texture = parse_texture(line) or texture
            pinned = bool(win and win.get("pinned"))
            # The display changed: before its new picture is sent. Upside
            # down keeps the shape but turns the picture: a half turn.
            if change and pinned and (not same_shape(change[1][:2], shape) or (change[1][2] - change[0][2]) % 4 == 2):
                carry(change[1][:2], turn_of(shape, change[1][:2], change[0][2], change[1][2]), False)
            # The new picture: a turn the log said nothing of starts now.
            if texture and pinned:
                if pending is None and not same_shape(texture, shape):
                    carry(texture, turn_of(shape, texture, rot), True)
                elif pending is not None and not pending["picture"]:
                    pending["picture"] = True
                    pending["picture_at"] = clock()
                    new_picture()
            now = clock()
            # The new picture is there and the card has arrived showing it:
            # the live window shows under it, the same picture, and the card
            # goes.
            ready_at = TURN_TRAVEL_SEC
            if pending and ((pending["picture"] and now - pending["since"] >= ready_at)
                            or now - pending["since"] >= TURN_WAIT_SEC):
                reveal()
            if log and not pending and log.tell() > LOG_MAX:
                os.truncate(screen_log(title), 0)
                log.seek(0)
            if now - looked >= WATCH_LOOK_SEC and not pending:
                looked = now
                win = find_window(title)
                if not win:
                    return EXIT_OK
                mons = hypr_json("monitors")
                # At rest in its shape: the user may have moved or resized it.
                here = resting(win, mons, border)
                if same_shape(here[2:], shape):
                    settled = here
                if win.get("pinned") and now - asked >= WATCH_ASK_SEC:
                    asked = now
                    new, new_rot = current_display(serial)
                    if new[0] and not same_shape(new, shape):
                        carry(new, turn_of(shape, new, rot, new_rot), True)
                    if new[0]:
                        rot = new_rot
            sleep(WATCH_LOG_SEC)
    finally:
        try:
            os.remove(lock)
        except OSError:
            pass


def screen_title(name, label=""):
    return "%s · %s" % (label, name) if label else "%s · Screen" % name


def screen_log(title):
    """scrcpy's output for a window: its "Texture: WxH" line is the moment
    the device's frame changes shape (a turn, a fold), read by the watcher."""
    return os.path.join(state_dir(), "screen-%s.log" % hashlib.sha1(title.encode()).hexdigest()[:12])


def parse_texture(line):
    """(width, height) from scrcpy's "INFO: Texture: 1080x2316", or None."""
    m = re.search(r"\bTexture: (\d+)x(\d+)", line or "")
    return (int(m.group(1)), int(m.group(2))) if m else None


def screen_command(serial, title, package="", tools=None, log=""):
    """The scrcpy command for the device's screen, or for one app in a
    window of its own (a virtual display on the device, so its own screen
    stays free; it follows the window's size with scrcpy 4). `log`: where
    its output goes."""
    # Line-buffered (stdbuf): written to a file, scrcpy's own lines were held
    # back and came in a late batch, after the turn they told of. Appended,
    # so the watcher can empty the file without leaving a hole.
    run = ["scrcpy"] if not log else ["sh", "-c", 'exec stdbuf -oL -eL "$0" "$@" >>%s 2>&1' % shlex.quote(log), "scrcpy"]
    cmd = ["uwsm-app", "--"] + run + ["--serial", serial, "--window-title", title]
    if log:
        # Verbose: its device side says when the display changes (the watcher).
        cmd += ["--verbosity=verbose"]
    if package:
        cmd += ["--new-display", "--start-app=" + package, "--no-vd-system-decorations"]
        if (tools or {}).get("flex"):
            cmd += ["--flex-display"]
    return cmd


def launch_or_focus(title, cmd):
    """Omarchy's `omarchy-launch-or-focus`: the window with this title is
    brought forward, else the command runs (it evals the command line, so
    each part is quoted)."""
    pattern = re.sub(r"([\\.^$|?*+()\[\]{}])", r"\\\1", title)
    subprocess.Popen(["omarchy-launch-or-focus", pattern, shlex.join(cmd)], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def screen_open(device_id, package="", label="", docked=True, launch=None, sleep=time.sleep, rect=None, ctx=None):
    """Opens the device's screen, or one of its apps, in a window here,
    docked or tiled, and returns once the window is there (the click waits
    meanwhile). Already open: brought forward instead of a second one."""
    device = screen_device(device_id) or {}
    name = device.get("name") or "Device"
    title = screen_title(name, label)
    launch = launch or (lambda cmd: launch_or_focus(title, cmd))
    if find_window(title):
        launch(["true"])   # focuses it; the command never runs
        return say("%s is open" % (label or name + "'s screen"))
    status = screen_status(device_id)
    if status["state"] != "ready":
        return say("Not set up: open Screen and apps in its settings", EXIT_FAILED)
    if package and not status["apps"]:
        return say("Apps in a window need Android 10 and scrcpy 3", EXIT_FAILED)
    top = next(((m.get("reserved") or [0, 0])[1] for m in hypr_json("monitors") if m.get("focused")), 0)
    disp = status.get("display") or device_display(status["serial"])
    aspect = disp[0] / disp[1] if disp and disp[1] else 9 / 19.5
    subprocess.run(["hyprctl", "eval", dock_rule_lua("screen:" + device_id + ":" + package, title,
                                                     aspect, top, docked, rect, border_size())],
                   capture_output=True, timeout=5)
    log = screen_log(title) if docked and not package else ""
    if log:
        os.makedirs(os.path.dirname(log), exist_ok=True)
        open(log, "w").close()   # a fresh log for this window
    launch(screen_command(status["serial"], title, package, status["tools"], log))
    for _ in range(WINDOW_WAIT_SEC * 4):
        if find_window(title):
            return say("%s is open" % (label or name + "'s screen"))
        sleep(0.25)
    return say("The window did not open: is %s unlocked and on this Wi-Fi?" % name, EXIT_FAILED)


def screen_dock(device_id, docked, package="", label="", rect=None, ctx=None):
    """Docks or undocks the device's open window (and the next ones)."""
    device = screen_device(device_id) or {}
    name = device.get("name") or "Device"
    title = screen_title(name, label)
    win = find_window(title)
    status = screen_status(device_id) if win or docked else {}
    disp = status.get("display") or [0, 0]
    aspect = disp[0] / disp[1] if disp[1] else 9 / 19.5
    top = next(((m.get("reserved") or [0, 0])[1] for m in hypr_json("monitors") if m.get("focused")), 0)
    subprocess.run(["hyprctl", "eval", dock_rule_lua("screen:" + device_id + ":" + package, title, aspect, top, docked, rect,
                                                     border_size())],
                   capture_output=True, timeout=5)
    if win:
        dock_window(win, docked, disp, rect)
    return say("Opens under the bar" if docked else "Opens as a window")


def screen_apps(device_id):
    """The device's launchable apps, user's first, as JSON."""
    status = screen_status(device_id)
    if status["state"] != "ready":
        return {"state": status["state"], "apps": []}
    try:
        out = subprocess.run(["scrcpy", "--serial", status["serial"], "--list-apps"],
                             capture_output=True, text=True, timeout=60)
        apps = parse_scrcpy_apps((out.stdout or "") + (out.stderr or ""))
    except (OSError, subprocess.TimeoutExpired):
        apps = []
    apps.sort(key=lambda a: (a["system"], a["name"].lower()))
    return {"state": "ready", "apps": apps}



# ---- Text messages ---------------------------------------------------------
#
# `sms` holds one connection to KDE Connect's conversations interface and
# speaks JSON lines: commands in on stdin, events out on stdout.
#
#   in   {"cmd":"load","thread":T,"start":0,"count":30}   a page of history
#        {"cmd":"reply","thread":T,"text":"..."}
#        {"cmd":"send","addresses":["+1..."],"text":"..."}
#        {"cmd":"attachment","part":P,"id":"..."}         fetch a full file
#        {"cmd":"refresh"}                                re-read everything
#   out  {"ev":"threads","threads":[...]}                 the whole list
#        {"ev":"thread","thread":{...}}                   one thread changed
#        {"ev":"messages","thread":T,"start":S,"messages":[...],"hasMore":b}
#        {"ev":"message","message":{...}}                 new or changed
#        {"ev":"attachment","part":P,"id":"...","path":"..."}
#        {"ev":"contacts","count":N}
#        {"ev":"sent"|"error", ...}
#
# Messages arrive from the daemon as conversationUpdated/Created signals, both
# for history we asked for and for live traffic. They all land in one cache;
# a message newer than its thread's latest, or a known one that changed, is
# pushed as "message", while older ones wait for their "messages" page.

SMS_IF = IFACE + ".device.conversations"
LOAD_TIMEOUT_SEC = 12
# The daemon re-sends history it already holds as a burst of signals and says
# nothing when done (conversationLoaded only follows a fetch from the phone),
# so a page is complete once it is full or the burst goes quiet this long.
LOAD_SETTLE_MS = 800
SENT_TYPES = (2, 4, 5, 6)          # Android: sent, outbox, failed, queued


def cache_dir():
    base = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    path = os.path.join(base, "sceny.devices", "sms")
    os.makedirs(path, exist_ok=True)
    return path


def digits_key(number):
    digits = re.sub(r"\D", "", number or "")
    return digits[-10:] if len(digits) >= 10 else digits


def vcard_qp(value, key):
    """A vCard 2.1 quoted-printable value (=C3=A1…) as text, in the charset
    the property names (UTF-8 when it names none)."""
    m = re.search(r"CHARSET=([A-Za-z0-9_-]+)", key)
    charset = m.group(1) if m else "utf-8"
    raw = quopri.decodestring(value.encode("ascii", "ignore"))
    try:
        return raw.decode(charset, errors="replace")
    except LookupError:
        return raw.decode("utf-8", errors="replace")


def read_contacts(device_id):
    """Names by phone number, from the vCards KDE Connect syncs (if allowed).
    Returns ({digits_key: name}, [{"name", "number"}])."""
    folder = os.path.expanduser("~/.local/share/kpeoplevcard/kdeconnect-%s" % device_id)
    names = {}
    entries = []
    try:
        files = os.listdir(folder)
    except OSError:
        return names, entries
    for name in files:
        try:
            text = open(os.path.join(folder, name), encoding="utf-8", errors="replace").read()
        except OSError:
            continue
        # Unfold continuation lines, then read FN and every TEL.
        text = re.sub(r"\r?\n[ \t]", "", text)
        full = ""
        tels = []
        lines = text.splitlines()
        i = 0
        while i < len(lines):
            line = lines[i]
            i += 1
            key, _, value = line.partition(":")
            key = key.upper()
            if key == "FN" or key.startswith("FN;"):
                if "QUOTED-PRINTABLE" in key:
                    # vCard 2.1: a soft break ends a line with "=".
                    while value.endswith("=") and i < len(lines):
                        value = value[:-1] + lines[i]
                        i += 1
                    value = vcard_qp(value, key)
                full = value.strip()
            elif key == "TEL" or key.startswith("TEL;"):
                tels.append(value.strip())
        for tel in tels:
            k = digits_key(tel)
            if k and full:
                names.setdefault(k, full)
                entries.append({"name": full, "number": tel})
    return names, entries


class Sms:
    def __init__(self, device_id):
        self.device_id = device_id
        self.path = device_path(device_id)
        self.conn = bus()
        self.loop = GLib.MainLoop()
        self.cache = {}        # thread -> {uid: message}
        self.latest = {}       # thread -> newest message (summary source)
        self.pending = {}      # thread -> [(start, count, timeout_source)]
        self.loaded = {}       # thread -> messages the daemon held when a page we asked for came in
        self.settle = {}       # thread -> quiet-period timer while a page loads
        self.contacts, self.contact_list = read_contacts(device_id)
        self.file_mimes = {}   # attachment id -> mime, for naming the fetched file
        self.thumbs = cache_dir()
        # Earlier versions kept the phone's previews as they came (thumb_*):
        # gone, so nothing shows them again.
        for name in os.listdir(self.thumbs):
            if name.startswith("thumb_") and name.endswith(".png"):
                try:
                    os.remove(os.path.join(self.thumbs, name))
                except OSError:
                    pass

    # -- output --
    def out(self, obj):
        try:
            sys.stdout.write(json.dumps(obj, ensure_ascii=False) + "\n")
            sys.stdout.flush()
        except BrokenPipeError:
            self.loop.quit()

    def name_for(self, address):
        return self.contacts.get(digits_key(address), "")

    # -- conversion --
    def attachment(self, a):
        part, mime, thumb64, uid = a
        entry = {"part": part, "mime": mime, "id": uid, "thumb": ""}
        if thumb64 and len(thumb64) <= SAFE_SOURCE_MAX:
            # The phone's preview (sent with the message) is shown only as a
            # copy decoded in the sandbox (fit_image), never as it came.
            safe = re.sub(r"[^A-Za-z0-9_.-]", "_", "%s_%s" % (part, uid))[:120]
            path = os.path.join(self.thumbs, "preview_%s.png" % safe)
            if not os.path.exists(path):
                raw = path + ".raw"
                try:
                    with open(raw, "wb") as f:
                        f.write(base64.b64decode(thumb64))
                    if not fit_image(raw, path, MESSAGE_PREVIEW_BOX):
                        path = ""
                except (OSError, ValueError):
                    path = ""
                finally:
                    if os.path.exists(raw):
                        os.remove(raw)
            entry["thumb"] = path
        return entry

    def message(self, v):
        event, body, addrs, date, mtype, read, tid, uid, sub, atts = v
        addresses = [a[0] for a in addrs]
        return {
            "uid": uid, "thread": tid, "body": body, "date": date,
            "type": mtype, "sent": mtype in SENT_TYPES, "read": read == 1,
            "event": event, "addresses": addresses,
            "attachments": [self.attachment(a) for a in atts],
        }

    def summary(self, m):
        addresses = m["addresses"]
        names = [self.name_for(a) for a in addresses]
        body = " ".join((m["body"] or "").split())
        return {
            "id": m["thread"], "addresses": addresses, "names": names,
            "date": m["date"], "snippet": body[:200], "sent": m["sent"],
            "read": m["read"], "attachments": len(m["attachments"]),
            "group": len(addresses) > 1,
        }

    # -- D-Bus --
    def call(self, method, args=None, sig=None, timeout=10000):
        params = GLib.Variant(sig, args) if sig else None
        return self.conn.call_sync(BUS_NAME, self.path, SMS_IF, method, params, None,
                                   Gio.DBusCallFlags.NONE, timeout, None)

    def active(self):
        av = self.call("activeConversations").get_child_value(0)
        out = []
        for i in range(av.n_children()):
            try:
                out.append(self.message(av.get_child_value(i).get_variant().unpack()))
            except (ValueError, TypeError):
                pass
        return out

    def emit_threads(self):
        msgs = self.active()
        for m in msgs:
            self.remember(m)
            cur = self.latest.get(m["thread"])
            if cur is None or m["date"] >= cur["date"]:
                self.latest[m["thread"]] = m
        threads = sorted((self.summary(m) for m in self.latest.values()),
                         key=lambda t: -t["date"])
        self.out({"ev": "threads", "threads": threads})
        self.out({"ev": "contacts", "count": len(self.contacts), "contacts": self.contact_list})

    def remember(self, m):
        bucket = self.cache.setdefault(m["thread"], {})
        old = bucket.get(m["uid"])
        bucket[m["uid"]] = m
        return old

    def on_signal(self, conn, sender, path, iface, signal, params):
        if path != self.path:
            return
        if signal in ("conversationCreated", "conversationUpdated"):
            try:
                m = self.message(params.get_child_value(0).get_variant().unpack())
            except (ValueError, TypeError):
                return
            old = self.remember(m)
            if m["thread"] in self.pending:
                self.progress(m["thread"])
            latest = self.latest.get(m["thread"])
            newest = latest is None or m["date"] >= latest["date"]
            if newest:
                self.latest[m["thread"]] = m
                self.out({"ev": "thread", "thread": self.summary(m)})
            # Live traffic, or a known message whose state moved (sending ->
            # sent, read): push it. History we asked for waits for its page.
            if (old is None and newest) or (old is not None and old != m):
                self.out({"ev": "message", "message": m})
        elif signal == "conversationLoaded":
            # Sent after every batch the daemon takes in, with how many
            # messages it holds for the thread, not how long the conversation
            # is: asking for every thread's latest message says 1 for each.
            # Only the answer to a page asked for here says how far it goes.
            tid, count = params.unpack()
            if tid in self.pending:
                self.loaded[tid] = count
                self.finish_loads(tid, count)
        elif signal == "conversationRemoved":
            tid = params.unpack()[0]
            self.cache.pop(tid, None)
            self.latest.pop(tid, None)
            self.out({"ev": "removed", "thread": tid})
        elif signal == "attachmentReceived":
            file_path, file_name = params.unpack()
            self.out(self.arrived(file_path, file_name))

    def arrived(self, path, name):
        """What the panel opens for a fetched attachment: a picture as a copy
        decoded in the sandbox (never the phone's bytes; one that does not
        decode is not opened), anything else as itself, under a name with
        its type."""
        mime = self.file_mimes.get(name, "")
        if mime.startswith("image/"):
            copy = safe_full_picture(path)
            if not copy:
                return {"ev": "error", "cmd": "attachment", "name": name,
                        "message": "This picture could not be read safely, so it was not opened"}
            return {"ev": "attachment", "path": copy, "name": name}
        return {"ev": "attachment", "path": self.named(path, name), "name": name}

    def named(self, path, name):
        """The daemon saves attachments without an extension, which some
        viewers refuse. Link it under a name that carries its type."""
        mime = self.file_mimes.get(name, "")
        ext = {"image/jpeg": "jpg", "image/jpg": "jpg", "image/png": "png", "image/gif": "gif",
               "video/3gpp": "3gp", "video/mp4": "mp4", "audio/amr": "amr", "audio/mpeg": "mp3"}.get(
            mime, mime.split("/")[-1] if "/" in mime else "")
        if not ext or path.lower().endswith("." + ext):
            return path
        safe = re.sub(r"[^A-Za-z0-9_.-]", "_", name)[:120]
        link = os.path.join(self.thumbs, "%s.%s" % (safe, ext))
        try:
            if os.path.islink(link) or os.path.exists(link):
                os.remove(link)
            os.symlink(path, link)
            return link
        except OSError:
            return path

    def page(self, tid, start, count):
        ordered = sorted(self.cache.get(tid, {}).values(), key=lambda m: -m["date"])
        return ordered[start:start + count], len(ordered)

    def answer(self, tid, start, want):
        msgs, have = self.page(tid, start, want)
        known = self.loaded.get(tid)
        self.out({"ev": "messages", "thread": tid, "start": start, "messages": msgs,
                  "hasMore": len(msgs) == want or (known is not None and known > start + len(msgs))})

    def finish_loads(self, tid, count=None):
        source = self.settle.pop(tid, None)
        if source:
            GLib.source_remove(source)
        for start, want, timeout in self.pending.pop(tid, []):
            GLib.source_remove(timeout)
            self.answer(tid, start, want)

    def progress(self, tid):
        """A message for a thread with a page on the way: answer pages that are
        now full, and restart the quiet-period timer for the rest."""
        have = len(self.cache.get(tid, {}))
        still = []
        for start, want, timeout in self.pending.get(tid, []):
            if have >= start + want:
                GLib.source_remove(timeout)
                self.answer(tid, start, want)
            else:
                still.append((start, want, timeout))
        if not still:
            self.pending.pop(tid, None)
            source = self.settle.pop(tid, None)
            if source:
                GLib.source_remove(source)
            return
        self.pending[tid] = still
        source = self.settle.pop(tid, None)
        if source:
            GLib.source_remove(source)

        def quiet():
            self.settle.pop(tid, None)
            self.finish_loads(tid)
            return False
        self.settle[tid] = GLib.timeout_add(LOAD_SETTLE_MS, quiet)

    def load(self, tid, start, count):
        # Already held: answer now. The daemon sends no conversationLoaded for
        # a range it already has, so waiting would only run into the timeout.
        msgs, have = self.page(tid, start, count)
        known = self.loaded.get(tid)
        if len(msgs) == count or (known is not None and have >= known):
            self.out({"ev": "messages", "thread": tid, "start": start, "messages": msgs,
                      "hasMore": have > start + count or (known is not None and known > have)
                                 or (known is None and len(msgs) == count)})
            if len(msgs) == count:
                # Still ask, so anything newer on the phone comes in as signals.
                try:
                    self.call("requestConversation", (tid, start, start + count), "(xii)")
                except GLib.Error:
                    pass
            return

        def timed_out():
            waiting = self.pending.get(tid, [])
            self.pending[tid] = [w for w in waiting if w[2] != source_holder[0]]
            if not self.pending[tid]:
                self.pending.pop(tid, None)
            msgs, have = self.page(tid, start, count)
            self.out({"ev": "messages", "thread": tid, "start": start, "messages": msgs,
                      "hasMore": False, "timedOut": True})
            return False
        source_holder = [0]
        source_holder[0] = GLib.timeout_add_seconds(LOAD_TIMEOUT_SEC, timed_out)
        self.pending.setdefault(tid, []).append((start, count, source_holder[0]))
        try:
            self.call("requestConversation", (tid, start, start + count), "(xii)")
        except GLib.Error as error:
            self.out({"ev": "error", "cmd": "load", "thread": tid, "message": error.message})

    def command(self, cmd):
        verb = cmd.get("cmd")
        try:
            if verb == "load":
                self.load(int(cmd["thread"]), int(cmd.get("start", 0)), int(cmd.get("count", 30)))
            elif verb == "reply":
                text = str(cmd.get("text", "")).strip()
                if text:
                    self.call("replyToConversation", (int(cmd["thread"]), text, []), "(xsav)")
                    self.out({"ev": "sent", "thread": int(cmd["thread"])})
            elif verb == "send":
                text = str(cmd.get("text", "")).strip()
                addrs = [GLib.Variant("(s)", (str(a),)) for a in cmd.get("addresses", []) if str(a).strip()]
                if text and addrs:
                    self.call("sendWithoutConversation", (addrs, text, []), "(avsav)")
                    self.out({"ev": "sent", "addresses": cmd.get("addresses", [])})
            elif verb == "attachment":
                if cmd.get("mime"):
                    self.file_mimes[str(cmd["id"])] = str(cmd["mime"])
                self.call("requestAttachmentFile", (int(cmd["part"]), str(cmd["id"])), "(xs)")
            elif verb == "refresh":
                self.contacts, self.contact_list = read_contacts(self.device_id)
                self.emit_threads()
                self.call("requestAllConversationThreads")
        except (GLib.Error, KeyError, ValueError, TypeError) as error:
            message = error.message if isinstance(error, GLib.Error) else str(error)
            self.out({"ev": "error", "cmd": verb, "message": message})

    def on_stdin(self, fd, condition):
        if condition & (GLib.IO_HUP | GLib.IO_ERR):
            self.loop.quit()
            return False
        line = sys.stdin.readline()
        if not line:
            self.loop.quit()
            return False
        try:
            self.command(json.loads(line))
        except json.JSONDecodeError:
            self.out({"ev": "error", "message": "unreadable command"})
        return True

    # A restarted daemon starts with an empty cache and knows nothing the
    # phone changed meanwhile (read state included). Once it is back, ask the
    # phone again: every thread's latest message then arrives as a signal and
    # replaces what the old run left here. The device needs a moment to
    # reconnect, so retry until the call goes through.
    RESYNC_RETRY_SEC = 3
    RESYNC_TRIES = 20

    def on_owner_changed(self, conn, sender, path, iface, signal, params):
        name, old_owner, new_owner = params.unpack()
        if name != BUS_NAME or not new_owner:
            return
        tries = [0]

        def attempt():
            tries[0] += 1
            try:
                self.call("requestAllConversationThreads")
                return False
            except GLib.Error:
                return tries[0] < self.RESYNC_TRIES
        GLib.timeout_add_seconds(self.RESYNC_RETRY_SEC, attempt)

    def run(self):
        self.conn.signal_subscribe(BUS_NAME, SMS_IF, None, self.path, None,
                                   Gio.DBusSignalFlags.NONE, self.on_signal)
        self.conn.signal_subscribe("org.freedesktop.DBus", "org.freedesktop.DBus",
                                   "NameOwnerChanged", "/org/freedesktop/DBus",
                                   BUS_NAME, Gio.DBusSignalFlags.NONE, self.on_owner_changed)
        GLib.io_add_watch(sys.stdin.fileno(), GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, self.on_stdin)
        try:
            self.emit_threads()
            # Ask the phone for anything the daemon has not seen yet; updates
            # come back as signals.
            self.call("requestAllConversationThreads")
        except GLib.Error as error:
            self.out({"ev": "error", "cmd": "start", "message": error.message})
        self.loop.run()


def main(argv):
    if not argv:
        return say(__doc__.strip(), EXIT_FAILED)
    if argv[0] == "watch":
        try:
            watch()
        except KeyboardInterrupt:
            pass
        return EXIT_OK
    if argv[0] == "sms":
        if len(argv) < 2:
            return say("sms needs a device id", EXIT_FAILED)
        try:
            Sms(argv[1]).run()
        except KeyboardInterrupt:
            pass
        return EXIT_OK
    if argv[0] == "photos":
        if len(argv) < 2:
            return say("photos needs a device id", EXIT_FAILED)
        count = int(argv[2]) if len(argv) > 2 and argv[2].isdigit() else PHOTO_COUNT
        print(json.dumps(photos(argv[1], count), ensure_ascii=False))
        return EXIT_OK
    if argv[0] == "photos-cached":
        if len(argv) < 2:
            return say("photos-cached needs a device id", EXIT_FAILED)
        print(json.dumps(cached_photos(argv[1]), ensure_ascii=False))
        return EXIT_OK
    if argv[0] == "save-file":
        if len(argv) < 3:
            return say("save-file needs a path and the device's name", EXIT_FAILED)
        return save_file(argv[1], argv[2])
    if argv[0] == "received-dismiss":
        if len(argv) < 3:
            return say("received-dismiss needs a device id and a path", EXIT_FAILED)
        path = received_path(argv[1])
        entries = load_received(path)
        entries[:] = [e for e in entries if e.get("path") != argv[2]]
        save_received(path, entries)
        return EXIT_OK
    if argv[0] == "open-file":
        return open_file(argv[1] if len(argv) > 1 else "", local="--local" in argv[2:], from_device="--from-device" in argv[2:])
    if argv[0] == "safe-image":
        # A safe copy of an image from the device (a track's art), for the
        # panel to show: its path, or nothing.
        print(safe_image(argv[1] if len(argv) > 1 else "", int(argv[2]) if len(argv) > 2 else ART_BOX))
        return EXIT_OK
    if argv[0] == "copy-file":
        return copy_file(argv[1] if len(argv) > 1 else "")
    if argv[0] == "doctor":
        print(json.dumps(doctor()))
        return EXIT_OK
    if argv[0] == "fix":
        return fix(argv[1] if len(argv) > 1 else "")
    if argv[0] == "screen-watch":
        ctx = next((parse_ctx(argv[i + 1]) for i, a in enumerate(argv) if a == "--ctx" and i + 1 < len(argv)), None)
        if len(argv) < 3 or not ctx:
            return say("screen-watch needs a device id, its adb serial and --ctx", EXIT_FAILED)
        try:
            return screen_watch(argv[1], argv[2], ctx)
        except KeyboardInterrupt:
            return EXIT_OK
    if argv[0] == "screen-focus":
        if len(argv) < 2:
            return say("screen-focus needs a device id", EXIT_FAILED)
        device = screen_device(argv[1]) or {}
        title = screen_title(device.get("name") or "Device")
        if find_window(title):
            launch_or_focus(title, ["true"])
        return EXIT_OK
    if argv[0] == "screen-dock":
        if len(argv) < 3:
            return say("screen-dock needs a device id and on or off", EXIT_FAILED)
        at = next((parse_rect(argv[i + 1]) for i, a in enumerate(argv) if a == "--at" and i + 1 < len(argv)), None)
        ctx = next((parse_ctx(argv[i + 1]) for i, a in enumerate(argv) if a == "--ctx" and i + 1 < len(argv)), None)
        return screen_dock(argv[1], argv[2] == "on", rect=at, ctx=ctx)
    if argv[0] in ("screen", "screen-pair", "screen-open", "screen-apps"):
        if len(argv) < 2:
            return say("%s needs a device id" % argv[0], EXIT_FAILED)
        if argv[0] == "screen":
            print(json.dumps(screen_status(argv[1])))
            return EXIT_OK
        if argv[0] == "screen-apps":
            print(json.dumps(screen_apps(argv[1]), ensure_ascii=False))
            return EXIT_OK
        if argv[0] == "screen-pair":
            try:
                return screen_pair(argv[1])
            except KeyboardInterrupt:
                return EXIT_CANCELLED
        at = next((parse_rect(argv[i + 1]) for i, a in enumerate(argv) if a == "--at" and i + 1 < len(argv)), None)
        ctx = next((parse_ctx(argv[i + 1]) for i, a in enumerate(argv) if a == "--ctx" and i + 1 < len(argv)), None)
        rest, skip = [], False
        for a in argv[2:]:
            if skip:
                skip = False
            elif a in ("--at", "--ctx"):
                skip = True
            elif a not in ("--tiled", "--docked"):
                rest.append(a)
        return screen_open(argv[1], rest[0] if rest else "", rest[1] if len(rest) > 1 else "",
                           docked="--tiled" not in argv, rect=at, ctx=ctx)
    if argv[0] == "snapshot":
        print(json.dumps(with_seen(snapshot(bus()), load_seen(seen_path())), indent=2, sort_keys=True, ensure_ascii=False))
        return EXIT_OK
    return act(argv)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
