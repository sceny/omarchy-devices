#!/usr/bin/python3
"""KDE Connect bridge for the sceny.devices Omarchy shell plugin.

The shell has no generic D-Bus binding, and every shell-callable D-Bus client
(busctl, gdbus) opens a fresh connection per call. One Python process holding
one connection is cheaper and can also listen: `watch` prints a JSON snapshot
of every KDE Connect device on start, again shortly after any signal the
daemon emits, and every HEARTBEAT_SEC as a backstop. Unchanged snapshots are
not re-printed, so the shell only wakes when something moved.

  kdeconnect-bridge watch                          snapshot per line, until killed
  kdeconnect-bridge snapshot                       one snapshot, then exit
  kdeconnect-bridge ring <device>
  kdeconnect-bridge ping <device> [message]       a message shows in the notification
  kdeconnect-bridge clipboard <device>
  kdeconnect-bridge share <device> [path...]       no paths: open the file chooser
  kdeconnect-bridge text <device> <text>           lands on the device's clipboard
  kdeconnect-bridge url <device> <url>             opens on the device
  kdeconnect-bridge dial <device> <number>         the device's dialer, ready to call
  kdeconnect-bridge media <device> <PlayPause|Next|Previous>
  kdeconnect-bridge dismiss <device> <notification>
  kdeconnect-bridge reply <device> <replyId> <message>
  kdeconnect-bridge action <device> <notification> <action>
  kdeconnect-bridge pair|accept|reject|unpair <device>
  kdeconnect-bridge photos <device> [count]        the newest photos and screenshots on
                                              it, with thumbnails, as JSON
  kdeconnect-bridge photos-cached <device>         the last list, at once (from the cache)
  kdeconnect-bridge save-file <path> <name>        a copy in Pictures/<name>/
  kdeconnect-bridge received-dismiss <device> <path>   forget one received file
  kdeconnect-bridge copy-file <path>               the file on the clipboard
  kdeconnect-bridge doctor                    setup checks, as JSON
  kdeconnect-bridge fix install|start|firewall|sshfs|search   fix one (install,
                                              firewall and sshfs ask for a password;
                                              search looks for devices again)
  kdeconnect-bridge sms <device>                   text messages: JSON commands on
                                              stdin, JSON events on stdout

Actions print one human line and exit 0 on success, 1 when the user backed
out (closed the file chooser), 2 on failure.
"""

import base64
import hashlib
import html
import ipaddress
import json
import shutil
import os
import re
import subprocess
import sys
import urllib.parse

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

BUS_NAME = "org.kde.kdeconnect"
ROOT = "/modules/kdeconnect"
IFACE = "org.kde.kdeconnect"
CALL_TIMEOUT_MS = 2500
DEBOUNCE_MS = 250
HEARTBEAT_SEC = 30

EXIT_OK, EXIT_CANCELLED, EXIT_FAILED = 0, 1, 2


def bus():
    return Gio.bus_get_sync(Gio.BusType.SESSION, None)


def call(conn, path, iface, method, args=None, sig=None):
    params = GLib.Variant(sig, args) if sig else None
    result = conn.call_sync(BUS_NAME, path, iface, method, params, None,
                            Gio.DBusCallFlags.NONE, CALL_TIMEOUT_MS, None)
    return result.unpack() if result is not None else ()


def props(conn, path, iface):
    try:
        return call(conn, path, "org.freedesktop.DBus.Properties", "GetAll",
                    (iface,), "(s)")[0]
    except GLib.Error:
        return None


def device_path(device_id):
    return "%s/devices/%s" % (ROOT, device_id)


def daemon_running(conn):
    owner = conn.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus",
                           "org.freedesktop.DBus", "NameHasOwner",
                           GLib.Variant("(s)", (BUS_NAME,)), None,
                           Gio.DBusCallFlags.NONE, CALL_TIMEOUT_MS, None)
    return owner.unpack()[0]


# A conversation's text (WhatsApp, Signal, Messages...) comes from the daemon
# as markup it builds itself (kdeconnect-kde, getConversationMessages): each
# message's content HTML-escaped, a new sender as "<b>sender</b>\n" before
# it, messages joined by "<br/>". It is split on exactly those markers into
# plain {sender, text} pairs, never rendered: the entities become characters,
# so a message that says "<script>" is shown as those characters. Text that
# does not follow the format is one message from nobody, as it came.
CONVERSATION_BREAK = "<br/>"
SENDER_OPEN, SENDER_CLOSE = "<b>", "</b>\n"


def parse_conversation(markup):
    messages = []
    for chunk in str(markup or "").split(CONVERSATION_BREAK):
        sender = ""
        if chunk.startswith(SENDER_OPEN) and SENDER_CLOSE in chunk:
            end = chunk.index(SENDER_CLOSE)
            sender, chunk = chunk[len(SENDER_OPEN):end], chunk[end + len(SENDER_CLOSE):]
        messages.append({"sender": html.unescape(sender).strip(), "text": html.unescape(chunk).strip()})
    return [m for m in messages if m["sender"] or m["text"]]


def conversation_text(messages):
    """The whole conversation as plain lines, for where one string is read."""
    return "\n".join(("%s: %s" % (m["sender"], m["text"])) if m["sender"] else m["text"]
                     for m in messages)


def read_notifications(conn, dpath):
    npath = dpath + "/notifications"
    try:
        ids = call(conn, npath, IFACE + ".device.notifications",
                   "activeNotifications")[0]
    except GLib.Error:
        return None
    out = []
    for nid in ids:
        p = props(conn, "%s/%s" % (npath, nid),
                  IFACE + ".device.notifications.notification")
        if not p:
            continue
        icon = p.get("iconPath", "") if p.get("hasIcon") else ""
        text = p.get("text", "")
        conversation = parse_conversation(text) if p.get("isConversation") else []
        if conversation:
            text = conversation_text(conversation)
        out.append({
            "id": nid,
            "key": p.get("internalId", ""),
            "app": p.get("appName", ""),
            "title": p.get("title", ""),
            "text": text,
            "conversation": conversation,
            "ticker": p.get("ticker", ""),
            "dismissable": bool(p.get("dismissable", False)),
            "replyId": p.get("replyId", ""),
            "actions": list(p.get("actions", []) or []),
            "icon": icon if icon and os.path.exists(icon) else "",
            "silent": bool(p.get("silent", False)),
        })
    # activeNotifications is in arrival order; newest first reads better.
    out.reverse()
    return out


# Calls: KDE Connect's telephony plugin signals `callReceived(event, number,
# contactName)` for a ringing call (event "callReceived") and a missed one
# ("missedCall"), and for nothing else: not when the call is answered or ends
# (#60). A declined call arrives as missed. The last one per device is kept
# here, with when it came; how long it counts is the panel's to decide.
# KDE Connect puts the number in contactName when it has no name.
CALL_EVENTS = {"callReceived": "ringing", "missedCall": "missed"}


def call_event(event, number, name, at_ms):
    kind = CALL_EVENTS.get(str(event))
    if not kind:
        return None
    number, name = str(number or "").strip(), str(name or "").strip()
    return {"event": kind, "number": number,
            "name": "" if name == number else name, "at": int(at_ms)}


def read_device(conn, device_id, calls=None):
    dpath = device_path(device_id)
    d = props(conn, dpath, IFACE + ".device")
    if d is None:
        return None
    plugins = []
    try:
        plugins = list(call(conn, dpath, IFACE + ".device", "loadedPlugins")[0])
    except GLib.Error:
        pass
    has = lambda name: ("kdeconnect_" + name) in plugins

    dev = {
        "id": device_id,
        "name": d.get("name", ""),
        "type": d.get("type", ""),
        "reachable": bool(d.get("isReachable", False)),
        "paired": bool(d.get("isPaired", False)),
        "pairRequested": bool(d.get("isPairRequested", False)),
        "pairRequestedByPeer": bool(d.get("isPairRequestedByPeer", False)),
        # Shown while pairing, so both screens can be compared.
        "verificationKey": d.get("verificationKey", "") if (d.get("isPairRequested") or d.get("isPairRequestedByPeer")) else "",
        "links": list(d.get("activeProviderNames", []) or []),
        "addresses": list(d.get("reachableAddresses", []) or []),
        "can": {
            "ring": has("findmyphone"),
            "clipboard": has("clipboard"),
            "share": has("share"),
            "sms": has("sms"),
            "media": has("mprisremote"),
            "notifications": has("notifications"),
            "ping": has("ping"),
            "calls": has("telephony"),
            "files": has("sftp"),
        },
        "battery": None,
        "network": None,
        "notifications": [],
        "call": None,
    }

    # Away, or not paired: nothing more can be read from it.
    if not dev["reachable"] or not dev["paired"]:
        return dev

    if has("battery"):
        b = props(conn, dpath + "/battery", IFACE + ".device.battery")
        if b and b.get("hasBattery"):
            dev["battery"] = {"charge": int(b.get("charge", -1)),
                              "charging": bool(b.get("isCharging", False))}

    if has("connectivity_report"):
        c = props(conn, dpath + "/connectivity_report",
                  IFACE + ".device.connectivity_report")
        if c and c.get("cellularNetworkType"):
            dev["network"] = {"type": c.get("cellularNetworkType", ""),
                              "strength": int(c.get("cellularNetworkStrength", -1))}

    # Media is not read here: KDE Connect also exports every phone player as
    # an MPRIS player, which the shell tracks natively (Service.players). The
    # mprisremote object only ever shows one "current" player, which went
    # stale when the phone switched apps.

    if has("notifications"):
        n = read_notifications(conn, dpath)
        dev["notifications"] = n if n is not None else []

    dev["call"] = (calls or {}).get(device_id)
    return dev


def snapshot(conn, calls=None):
    try:
        if not daemon_running(conn):
            return {"daemon": False, "devices": []}
        # Every device the daemon knows: paired ones, and unpaired ones in reach
        # (to pair with, or asking to pair).
        ids = call(conn, ROOT, IFACE + ".daemon", "devices",
                   (False, False), "(bb)")[0]
    except GLib.Error as error:
        return {"daemon": False, "devices": [], "error": error.message}
    devices = []
    for device_id in ids:
        try:
            dev = read_device(conn, device_id, calls)
        except GLib.Error:
            dev = None
        if dev:
            devices.append(dev)
    return {"daemon": True, "devices": devices}


# ---- Last seen ---------------------------------------------------------------
#
# Where each paired device was while it was last connected: its link, its
# address and when. An away device's page says it ("last seen on Wi-Fi at
# 192.168.1.20, 12 min ago"), after a restart too: it is kept in the cache.
# While a device is connected its time moves on in memory and reaches the
# file at most every SEEN_SAVE_MS, so a restart is off by that at most.

SEEN_SAVE_MS = 5 * 60 * 1000


def state_dir():
    base = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    path = os.path.join(base, "sceny.devices")
    os.makedirs(path, exist_ok=True)
    return path


def seen_path():
    return os.path.join(state_dir(), "last-seen.json")


def load_seen(path):
    try:
        with open(path) as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def save_seen(path, seen):
    tmp = path + ".tmp"
    try:
        with open(tmp, "w") as f:
            json.dump(seen, f, sort_keys=True)
        os.replace(tmp, path)
    except OSError:
        pass


def note_seen(seen, devices, now_ms):
    """Updates `seen` from a snapshot's devices; returns whether the file
    should be written now: a device's link or address changed, it left, or
    the time of a connected one is SEEN_SAVE_MS old on disk."""
    write = False
    for d in devices:
        if not d.get("paired"):
            continue
        old = seen.get(d["id"])
        if d.get("reachable"):
            entry = {"link": (d.get("links") or [""])[0], "address": (d.get("addresses") or [""])[0],
                     "at": now_ms, "here": True, "saved": (old or {}).get("saved", 0)}
            if not old or not old.get("here") or old.get("link") != entry["link"] \
                    or old.get("address") != entry["address"] or now_ms - entry["saved"] >= SEEN_SAVE_MS:
                write = True
            seen[d["id"]] = entry
        elif old and old.get("here"):
            seen[d["id"]] = dict(old, here=False)
            write = True
    if write:
        for entry in seen.values():
            entry["saved"] = now_ms
    return write


def with_seen(snap, seen):
    """An away paired device carries where it was last seen, or None."""
    for d in snap.get("devices", []):
        s = seen.get(d["id"])
        d["lastSeen"] = {"link": s.get("link", ""), "address": s.get("address", ""), "at": s.get("at", 0)} \
            if s and d.get("paired") and not d.get("reachable") else None
    return snap


# ---- Files: received from a device, and its newest photos ----------------
#
# Received (#37): KDE Connect signals `shareReceived(url)` when a file
# arrives and keeps no history, so the list is ours: newest first, in the
# cache (received-<device>.json; file paths are private, so not shell.json).
# An entry goes when the user dismisses it or its file is gone.
#
# Photos (#65): the device's storage, mounted by KDE Connect's sftp plugin
# (sshfs), read when the panel asks: the newest images in its camera and
# screenshot folders, with thumbnails cached here.

RECEIVED_MAX = 50
PHOTO_FOLDERS = ["DCIM/Camera", "Pictures/Screenshots", "DCIM/Screenshots"]
PHOTO_EXTENSIONS = (".jpg", ".jpeg", ".png", ".webp", ".heic")
PHOTO_COUNT = 8
MOUNT_TIMEOUT_MS = 30000


def received_path(device_id):
    return os.path.join(state_dir(), "received-%s.json" % re.sub(r"[^A-Za-z0-9_-]", "_", device_id))


def load_received(path):
    try:
        with open(path) as f:
            data = json.load(f)
        return data if isinstance(data, list) else []
    except (OSError, ValueError):
        return []


def save_received(path, entries):
    tmp = path + ".tmp"
    try:
        with open(tmp, "w") as f:
            json.dump(entries, f)
        os.replace(tmp, path)
    except OSError:
        pass


def local_path(url):
    """The file a file:// URL names, or "" for anything else (text, links)."""
    parsed = urllib.parse.urlparse(str(url or ""))
    return urllib.parse.unquote(parsed.path) if parsed.scheme == "file" else ""


def note_received(entries, url, now_ms):
    """A new entry for a received file, newest first, once per path;
    returns whether the list changed. Text and links are not files."""
    path = local_path(url)
    if not path or not os.path.isfile(path):
        return False
    entries[:] = [e for e in entries if e.get("path") != path]
    entries.insert(0, {"path": path, "name": os.path.basename(path),
                       "size": os.path.getsize(path), "at": now_ms})
    del entries[RECEIVED_MAX:]
    return True


def prune_received(entries):
    """Drops entries whose file is gone (moved, deleted); returns whether
    any went."""
    kept = [e for e in entries if os.path.isfile(e.get("path", ""))]
    changed = len(kept) != len(entries)
    entries[:] = kept
    return changed


def photo_folders(roots):
    """The camera and screenshot folders under the mounted storage roots
    (sftp's getDirectories), each once."""
    out, seen = [], set()
    for root in roots:
        for sub in [""] + PHOTO_FOLDERS:
            path = os.path.join(root, sub) if sub else root
            if sub == "" and not any(path.rstrip("/").endswith(f) for f in PHOTO_FOLDERS):
                continue
            real = os.path.realpath(path)
            if real not in seen and os.path.isdir(path):
                seen.add(real)
                out.append(path)
    return out


def newest_photos(folders, count=PHOTO_COUNT):
    """The newest images across the folders: {path, name, at, kind}."""
    found = []
    for folder in folders:
        kind = "screenshot" if "Screenshot" in folder else "camera"
        try:
            with os.scandir(folder) as it:
                for e in it:
                    if e.is_file() and e.name.lower().endswith(PHOTO_EXTENSIONS) and not e.name.startswith("."):
                        found.append({"path": e.path, "name": e.name,
                                      "at": int(e.stat().st_mtime * 1000), "kind": kind})
        except OSError:
            continue
    found.sort(key=lambda p: -p["at"])
    return found[:count]


def thumb_name(photo):
    return hashlib.sha1(("%s|%d" % (photo["path"], photo["at"])).encode()).hexdigest()[:20] + ".jpg"


def make_thumb(src, dst):
    """A square 256 px thumbnail (ImageMagick, part of Omarchy)."""
    try:
        subprocess.run(["magick", src + "[0]", "-auto-orient", "-thumbnail", "256x256^",
                        "-gravity", "center", "-extent", "256x256", "-quality", "85", dst],
                       capture_output=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        pass
    return os.path.isfile(dst)


def photos(device_id, count=PHOTO_COUNT):
    """The device's newest photos as JSON: {ok, photos} or {ok: false,
    missing: "sshfs"} or {ok: false, error}."""
    if not shutil.which("sshfs"):
        return {"ok": False, "missing": "sshfs"}
    conn = bus()
    path = device_path(device_id) + "/sftp"
    iface = IFACE + ".device.sftp"
    try:
        result = conn.call_sync(BUS_NAME, path, iface, "mountAndWait", None, None,
                                Gio.DBusCallFlags.NONE, MOUNT_TIMEOUT_MS, None).unpack()
        if not result or not result[0]:
            error = call(conn, path, iface, "getMountError")[0]
            return {"ok": False, "error": error or "The device did not allow its storage"}
        roots = list(call(conn, path, iface, "getDirectories")[0].keys()) or [call(conn, path, iface, "mountPoint")[0]]
    except GLib.Error as error:
        return {"ok": False, "error": error.message}
    folders = photo_folders(roots)
    found = newest_photos(folders, count)
    # Where all of them are, for "All photos" (the file manager): the camera.
    camera = next((f for f in folders if "Camera" in f), folders[0] if folders else "")
    cache = photos_cache(device_id)
    keep = {PHOTO_LIST}
    for p in found:
        name = thumb_name(p)
        keep.add(name)
        thumb = os.path.join(cache, name)
        p["thumb"] = thumb if os.path.isfile(thumb) or make_thumb(p["path"], thumb) else ""
    for old in os.listdir(cache):
        if old not in keep:
            try:
                os.remove(os.path.join(cache, old))
            except OSError:
                pass
    save_received(os.path.join(cache, PHOTO_LIST), found)
    return {"ok": True, "photos": found, "folder": camera}


# The last list read from the device, with its thumbnails: the panel shows it
# at once when it opens, while `photos` reads the device again.
PHOTO_LIST = "list.json"


def photos_cache(device_id):
    path = os.path.join(state_dir(), "photos", re.sub(r"[^A-Za-z0-9_-]", "_", device_id))
    os.makedirs(path, exist_ok=True)
    return path


def cached_photos(device_id):
    """The last list, only entries whose thumbnail is still here; {ok: false}
    when there is none."""
    entries = load_received(os.path.join(photos_cache(device_id), PHOTO_LIST))
    kept = [p for p in entries if isinstance(p, dict) and p.get("thumb") and os.path.isfile(p["thumb"])]
    return {"ok": True, "cached": True, "photos": kept} if kept else {"ok": False, "none": True}


def pictures_dir():
    """The user's Pictures folder (xdg-user-dir), else ~/Pictures."""
    try:
        out = subprocess.run(["xdg-user-dir", "PICTURES"], capture_output=True, text=True, timeout=5).stdout.strip()
        if out and out != os.path.expanduser("~"):
            return out
    except (OSError, subprocess.TimeoutExpired):
        pass
    return os.path.expanduser("~/Pictures")


def save_file(path, device_name):
    """A copy of a file from the device in Pictures/<device name>/, never over
    one already there (a number is added)."""
    if not os.path.isfile(path):
        return say("The file is gone", EXIT_FAILED)
    folder_name = re.sub(r"[/\\]", "_", device_name.strip()) or "Device"
    folder = os.path.join(pictures_dir(), folder_name)
    os.makedirs(folder, exist_ok=True)
    base, ext = os.path.splitext(os.path.basename(path))
    target = os.path.join(folder, base + ext)
    n = 1
    while os.path.exists(target):
        target = os.path.join(folder, "%s (%d)%s" % (base, n, ext))
        n += 1
    try:
        shutil.copyfile(path, target)
    except OSError as error:
        return say(str(error), EXIT_FAILED)
    return say("Saved to %s" % os.path.join(os.path.basename(pictures_dir()), folder_name, os.path.basename(target)))


def copy_file(path):
    """The file on the clipboard: an image as image data, anything else as
    a file (a URI list, as file managers copy)."""
    if not os.path.isfile(path):
        return say("The file is gone", EXIT_FAILED)
    ext = os.path.splitext(path)[1].lower().lstrip(".")
    mime = {"jpg": "image/jpeg", "jpeg": "image/jpeg", "png": "image/png", "webp": "image/webp"}.get(ext)
    try:
        if mime:
            with open(path, "rb") as f:
                subprocess.run(["wl-copy", "--type", mime], stdin=f, timeout=15, check=True)
        else:
            subprocess.run(["wl-copy", "--type", "text/uri-list"], input=("file://" + urllib.parse.quote(path) + "\n").encode(),
                           timeout=15, check=True)
    except (OSError, subprocess.SubprocessError) as error:
        return say(str(error), EXIT_FAILED)
    return say("Copied")


def watch():
    conn = bus()
    loop = GLib.MainLoop()
    state = {"pending": 0, "last": None}
    calls = {}
    seen = load_seen(seen_path())
    # Known here only while connected: a device away at start keeps the time
    # it left, not "now".
    for entry in seen.values():
        entry["here"] = False

    def emit():
        state["pending"] = 0
        snap = snapshot(conn, calls)
        # Received files, re-read each time (a dismiss writes the file from
        # another process), without the ones that are gone.
        for d in snap.get("devices", []):
            if not d.get("paired"):
                continue
            path = received_path(d["id"])
            entries = load_received(path)
            if prune_received(entries):
                save_received(path, entries)
            d["received"] = entries
        if note_seen(seen, snap.get("devices", []), GLib.get_real_time() // 1000):
            save_seen(seen_path(), seen)
        line = json.dumps(with_seen(snap, seen), sort_keys=True, ensure_ascii=False)
        if line != state["last"]:
            state["last"] = line
            try:
                sys.stdout.write(line + "\n")
                sys.stdout.flush()
            except BrokenPipeError:
                loop.quit()
        return False

    def schedule(*_args):
        # Signals come in bursts (a notification posts, then updates, then the
        # battery refreshes); one snapshot after the burst settles is enough.
        if state["pending"]:
            GLib.source_remove(state["pending"])
        state["pending"] = GLib.timeout_add(DEBOUNCE_MS, emit)

    def heartbeat():
        schedule()
        return True

    def on_call(_conn, _sender, path, _iface, _signal, params):
        # /modules/kdeconnect/devices/<id>/telephony
        parts = path.split("/")
        if len(parts) < 2:
            return
        c = call_event(*params.unpack(), GLib.get_real_time() // 1000)
        if c:
            calls[parts[-2]] = c
        # The daemon forgets calls across a restart; so does this.

    def on_owner(*_args):
        calls.clear()

    def on_share(_conn, _sender, path, _iface, _signal, params):
        # /modules/kdeconnect/devices/<id>/share
        parts = path.split("/")
        if len(parts) < 2:
            return
        rpath = received_path(parts[-2])
        entries = load_received(rpath)
        if note_received(entries, params.unpack()[0], GLib.get_real_time() // 1000):
            save_received(rpath, entries)

    conn.signal_subscribe(BUS_NAME, IFACE + ".device.share", "shareReceived", None,
                          None, Gio.DBusSignalFlags.NONE, on_share)
    # Calls first, so the snapshot the next line schedules already has it.
    conn.signal_subscribe(BUS_NAME, IFACE + ".device.telephony", "callReceived", None,
                          None, Gio.DBusSignalFlags.NONE, on_call)
    conn.signal_subscribe("org.freedesktop.DBus", "org.freedesktop.DBus",
                          "NameOwnerChanged", "/org/freedesktop/DBus",
                          BUS_NAME, Gio.DBusSignalFlags.NONE, on_owner)
    # Every signal the daemon emits, on any object: device list, reachability,
    # pairing, battery, notifications, media. Subscribing by well-known name
    # follows the daemon across restarts.
    conn.signal_subscribe(BUS_NAME, None, None, None, None,
                          Gio.DBusSignalFlags.NONE, schedule)
    conn.signal_subscribe("org.freedesktop.DBus", "org.freedesktop.DBus",
                          "NameOwnerChanged", "/org/freedesktop/DBus",
                          BUS_NAME, Gio.DBusSignalFlags.NONE, schedule)
    GLib.timeout_add_seconds(HEARTBEAT_SEC, heartbeat)
    emit()
    loop.run()


def say(message, code=EXIT_OK):
    print(message, file=sys.stdout if code == EXIT_OK else sys.stderr)
    return code


def device_name(conn, device_id):
    d = props(conn, device_path(device_id), IFACE + ".device")
    return (d or {}).get("name", "phone")


def pick_files(title):
    try:
        out = subprocess.run(["omarchy-file-select", "--title", title, "--multiple"],
                             capture_output=True, text=True, timeout=660)
    except (OSError, subprocess.TimeoutExpired) as error:
        return None, str(error)
    if out.returncode == 1:
        return [], ""
    if out.returncode != 0:
        return None, (out.stderr or "file chooser failed").strip()
    return [p for p in out.stdout.splitlines() if p], ""


def act(argv):
    if len(argv) < 2:
        return say(__doc__.strip(), EXIT_FAILED)
    verb, device_id, rest = argv[0], argv[1], argv[2:]
    conn = bus()
    dpath = device_path(device_id)
    try:
        if verb == "ring":
            call(conn, dpath + "/findmyphone", IFACE + ".device.findmyphone", "ring")
            return say("Ringing %s" % device_name(conn, device_id))

        if verb in ("pair", "accept", "reject", "unpair"):
            method = {"pair": "requestPairing", "accept": "acceptPairing",
                      "reject": "cancelPairing", "unpair": "unpair"}[verb]
            call(conn, dpath, IFACE + ".device", method)
            name = device_name(conn, device_id)
            return say({"pair": "Asked %s to pair; accept on it" % name,
                        "accept": "Paired with %s" % name,
                        "reject": "Pairing with %s cancelled" % name,
                        "unpair": "Unpaired %s" % name}[verb])

        if verb == "ping":
            # sendPing is overloaded: no argument, or a message to show.
            message = " ".join(rest).strip()
            if message:
                call(conn, dpath + "/ping", IFACE + ".device.ping", "sendPing",
                     (message,), "(s)")
            else:
                call(conn, dpath + "/ping", IFACE + ".device.ping", "sendPing")
            return say("Pinged %s" % device_name(conn, device_id))

        if verb in ("text", "url"):
            value = " ".join(rest)
            if not value.strip():
                return say("Nothing to send", EXIT_CANCELLED)
            if verb == "url":
                call(conn, dpath + "/share", IFACE + ".device.share", "shareUrl",
                     (value.strip(),), "(s)")
                return say("Link sent to %s" % device_name(conn, device_id))
            call(conn, dpath + "/share", IFACE + ".device.share", "shareText",
                 (value,), "(s)")
            return say("Text sent to %s" % device_name(conn, device_id))

        if verb == "dial":
            # A tel: link: the phone opens its dialer on the number (or, from
            # the background, offers to in a notification). The call itself is
            # the user's tap on the phone.
            number = re.sub(r"[^\d+*#]", "", " ".join(rest))
            if not number:
                return say("No number to call", EXIT_CANCELLED)
            call(conn, dpath + "/share", IFACE + ".device.share", "shareUrl",
                 ("tel:" + number,), "(s)")
            return say("%s offers to call %s" % (device_name(conn, device_id), number))

        if verb == "clipboard":
            call(conn, dpath + "/clipboard", IFACE + ".device.clipboard", "sendClipboard")
            return say("Clipboard sent")

        if verb == "share":
            paths = rest
            if not paths:
                paths, error = pick_files("Send to %s" % device_name(conn, device_id))
                if paths is None:
                    return say(error, EXIT_FAILED)
                if not paths:
                    return say("Nothing sent", EXIT_CANCELLED)
            missing = [p for p in paths if not os.path.exists(p)]
            if missing:
                return say("Not found: %s" % missing[0], EXIT_FAILED)
            uris = [Gio.File.new_for_path(p).get_uri() for p in paths]
            call(conn, dpath + "/share", IFACE + ".device.share", "shareUrls",
                 (uris,), "(as)")
            if len(paths) == 1:
                return say("Sending %s" % os.path.basename(paths[0]))
            return say("Sending %d files" % len(paths))

        if verb == "media":
            action = rest[0] if rest else "PlayPause"
            if action not in ("PlayPause", "Play", "Pause", "Next", "Previous", "Stop"):
                return say("Unknown media action %s" % action, EXIT_FAILED)
            call(conn, dpath + "/mprisremote", IFACE + ".device.mprisremote",
                 "sendAction", (action,), "(s)")
            # The play/pause glyph already shows it worked; no status line.
            return EXIT_OK

        if verb == "dismiss":
            call(conn, "%s/notifications/%s" % (dpath, rest[0]),
                 IFACE + ".device.notifications.notification", "dismiss")
            return say("Dismissed")

        if verb == "reply":
            reply_id, message = rest[0], " ".join(rest[1:]).strip()
            if not message:
                return say("Empty reply", EXIT_CANCELLED)
            call(conn, dpath + "/notifications", IFACE + ".device.notifications",
                 "sendReply", (reply_id, message), "(ss)")
            return say("Reply sent")

        if verb == "action":
            nid, action = rest[0], rest[1]
            p = props(conn, "%s/notifications/%s" % (dpath, nid),
                      IFACE + ".device.notifications.notification") or {}
            call(conn, dpath + "/notifications", IFACE + ".device.notifications",
                 "sendAction", (p.get("internalId", nid), action), "(ss)")
            return say(action)
    except GLib.Error as error:
        message = error.message
        if "UnknownObject" in message or "No such object" in message:
            message = "The phone does not offer that right now"
        elif "ServiceUnknown" in message:
            message = "KDE Connect is not running"
        return say(message, EXIT_FAILED)
    except IndexError:
        return say("Missing argument for %s" % verb, EXIT_FAILED)

    return say("Unknown command %s" % verb, EXIT_FAILED)


# ---- Setup checks ----------------------------------------------------------
#
# What stands between the user and a working device: KDE Connect installed
# and running, the firewall letting it through on the local network, and a
# device paired. `doctor` reports; `fix` repairs one, only when asked. Root
# steps go through pkexec (the shell's polkit agent prompts); nothing here
# runs without the user's click.

KDE_PORTS = "1714:1764"
DAEMON_UNIT = "app-org.kde.kdeconnect.daemon@autostart.service"


def local_network():
    """The IPv4 network of the default route, e.g. 192.168.1.0/24."""
    try:
        route = json.loads(subprocess.run(["ip", "-j", "-4", "route", "show", "default"],
                                          capture_output=True, text=True, timeout=5).stdout or "[]")
        dev = route[0]["dev"]
        addr = json.loads(subprocess.run(["ip", "-j", "-4", "addr", "show", "dev", dev],
                                         capture_output=True, text=True, timeout=5).stdout or "[]")
        info = addr[0]["addr_info"][0]
        return str(ipaddress.ip_interface("%s/%s" % (info["local"], info["prefixlen"])).network)
    except (OSError, ValueError, KeyError, IndexError, subprocess.TimeoutExpired):
        return ""


def firewall_state():
    """ufw on or off, and whether KDE Connect's ports are allowed (TCP and
    UDP). ufw keeps its rules world-readable, so no root is needed to look."""
    try:
        enabled = any(line.strip() == "ENABLED=yes" for line in open("/etc/ufw/ufw.conf"))
    except OSError:
        return {"present": False, "active": False, "allowed": True}
    protos = set()
    try:
        for line in open("/etc/ufw/user.rules"):
            if line.startswith("### tuple ###") and " allow " in line and " %s " % KDE_PORTS in line:
                parts = line.split()
                if len(parts) > 5:
                    protos.add(parts[4])
    except OSError:
        pass
    return {"present": True, "active": enabled, "allowed": {"tcp", "udp"} <= protos or "any" in protos}


def doctor():
    checks = []
    installed = shutil.which("kdeconnect-cli") is not None
    checks.append({"key": "installed", "ok": installed, "label": "KDE Connect installed",
                   "status": "Installed" if installed else "Not installed",
                   "detail": "" if installed else "The kdeconnect package is not installed",
                   "fix": "" if installed else "install", "fixLabel": "Install"})
    running = False
    devices = []
    if installed:
        try:
            conn = bus()
            running = daemon_running(conn)
            if running:
                devices = snapshot(conn).get("devices", [])
        except GLib.Error:
            running = False
    checks.append({"key": "running", "ok": running, "label": "KDE Connect running",
                   "status": "Running" if running else "Stopped",
                   "detail": "" if running else "It starts at login; it is not running now",
                   "fix": "" if running or not installed else "start", "fixLabel": "Start"})
    fw = firewall_state()
    lan = local_network()
    fw_ok = not fw["active"] or fw["allowed"]
    checks.append({"key": "firewall", "ok": fw_ok,
                   "label": "Firewall lets devices in",
                   "status": ("Open to %s" % (lan or "the local network")) if fw["active"] and fw_ok
                             else ("Off" if fw["present"] else "None") if fw_ok else "Closed",
                   "detail": "" if fw_ok else "Ports %s are closed; allow them from %s" % (KDE_PORTS, lan or "the local network"),
                   "fix": "" if fw_ok else "firewall", "fixLabel": "Allow"})
    checks.append({"key": "network", "ok": bool(lan), "label": "On a network",
                   "status": lan or "No network",
                   "detail": "" if lan else "Join the Wi-Fi your devices are on",
                   "fix": "", "fixLabel": ""})
    paired = [d for d in devices if d.get("paired")]
    reachable = [d for d in paired if d.get("reachable")]
    checks.append({"key": "paired", "ok": len(paired) > 0, "label": "A device is paired",
                   "detail": "" if paired else "Open KDE Connect on the phone or tablet and pair it with this computer",
                   "fix": "", "fixLabel": ""})
    checks.append({"key": "reachable", "ok": len(reachable) > 0, "label": "A paired device is connected",
                   "detail": "" if reachable or not paired else "Same network as this computer, with the KDE Connect app running",
                   "fix": "", "fixLabel": ""})
    return {"checks": checks, "network": lan, "firewall": fw}


def fix(what):
    if what == "search":
        # What `kdeconnect-cli --refresh` does: the daemon announces itself on
        # every network, and a device that hears it connects back. Nothing on
        # the system changes, and connected devices stay connected.
        try:
            call(bus(), ROOT, IFACE + ".daemon", "forceOnNetworkChange")
        except GLib.Error as error:
            return say(error.message, EXIT_FAILED)
        return say("Looking for devices on the network")
    if what == "install":
        cmd = ["pkexec", "/usr/bin/pacman", "-S", "--needed", "--noconfirm", "kdeconnect"]
    elif what == "start":
        if subprocess.run(["systemctl", "--user", "start", DAEMON_UNIT], timeout=15).returncode == 0:
            return say("KDE Connect started")
        daemon = "/usr/lib/kdeconnectd"
        if os.path.exists(daemon):
            subprocess.Popen([daemon], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return say("KDE Connect started")
        return say("Could not start KDE Connect", EXIT_FAILED)
    elif what == "sshfs":
        # KDE Connect mounts a device's storage with it (photos).
        cmd = ["pkexec", "/usr/bin/pacman", "-S", "--needed", "--noconfirm", "sshfs"]
    elif what == "firewall":
        lan = local_network()
        if not lan:
            return say("Could not tell which network this computer is on", EXIT_FAILED)
        rules = " && ".join(
            "/usr/bin/ufw allow from %s to any port %s proto %s comment 'KDE Connect'" % (lan, KDE_PORTS, proto)
            for proto in ("tcp", "udp"))
        cmd = ["pkexec", "/bin/sh", "-c", rules]
    else:
        return say("Unknown fix %s" % what, EXIT_FAILED)
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=600)
    except (OSError, subprocess.TimeoutExpired) as error:
        return say(str(error), EXIT_FAILED)
    if out.returncode in (126, 127):
        return say("Not changed: the password prompt was dismissed", EXIT_CANCELLED)
    if out.returncode != 0:
        return say((out.stderr or out.stdout or "It did not work").strip().splitlines()[-1], EXIT_FAILED)
    return say({"install": "KDE Connect installed", "sshfs": "sshfs installed: photos can show",
                "firewall": "Firewall now allows KDE Connect from %s" % local_network()}[what])



# ---- Text messages ---------------------------------------------------------
#
# `sms` holds one connection to KDE Connect's conversations interface and
# speaks JSON lines: commands in on stdin, events out on stdout.
#
#   in   {"cmd":"load","thread":T,"start":0,"count":30}   a page of history
#        {"cmd":"reply","thread":T,"text":"..."}
#        {"cmd":"send","addresses":["+1..."],"text":"..."}
#        {"cmd":"attachment","part":P,"id":"..."}         fetch a full file
#        {"cmd":"refresh"}                                re-read everything
#   out  {"ev":"threads","threads":[...]}                 the whole list
#        {"ev":"thread","thread":{...}}                   one thread changed
#        {"ev":"messages","thread":T,"start":S,"messages":[...],"hasMore":b}
#        {"ev":"message","message":{...}}                 new or changed
#        {"ev":"attachment","part":P,"id":"...","path":"..."}
#        {"ev":"contacts","count":N}
#        {"ev":"sent"|"error", ...}
#
# Messages arrive from the daemon as conversationUpdated/Created signals, both
# for history we asked for and for live traffic. They all land in one cache;
# a message newer than its thread's latest, or a known one that changed, is
# pushed as "message", while older ones wait for their "messages" page.

SMS_IF = IFACE + ".device.conversations"
LOAD_TIMEOUT_SEC = 12
# The daemon re-sends history it already holds as a burst of signals and says
# nothing when done (conversationLoaded only follows a fetch from the phone),
# so a page is complete once it is full or the burst goes quiet this long.
LOAD_SETTLE_MS = 800
SENT_TYPES = (2, 4, 5, 6)          # Android: sent, outbox, failed, queued


def cache_dir():
    base = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    path = os.path.join(base, "sceny.devices", "sms")
    os.makedirs(path, exist_ok=True)
    return path


def digits_key(number):
    digits = re.sub(r"\D", "", number or "")
    return digits[-10:] if len(digits) >= 10 else digits


def read_contacts(device_id):
    """Names by phone number, from the vCards KDE Connect syncs (if allowed).
    Returns ({digits_key: name}, [{"name", "number"}])."""
    folder = os.path.expanduser("~/.local/share/kpeoplevcard/kdeconnect-%s" % device_id)
    names = {}
    entries = []
    try:
        files = os.listdir(folder)
    except OSError:
        return names, entries
    for name in files:
        try:
            text = open(os.path.join(folder, name), encoding="utf-8", errors="replace").read()
        except OSError:
            continue
        # Unfold continuation lines, then read FN and every TEL.
        text = re.sub(r"\r?\n[ \t]", "", text)
        full = ""
        tels = []
        for line in text.splitlines():
            key, _, value = line.partition(":")
            key = key.upper()
            if key == "FN" or key.startswith("FN;"):
                full = value.strip()
            elif key == "TEL" or key.startswith("TEL;"):
                tels.append(value.strip())
        for tel in tels:
            k = digits_key(tel)
            if k and full:
                names.setdefault(k, full)
                entries.append({"name": full, "number": tel})
    return names, entries


class Sms:
    def __init__(self, device_id):
        self.device_id = device_id
        self.path = device_path(device_id)
        self.conn = bus()
        self.loop = GLib.MainLoop()
        self.cache = {}        # thread -> {uid: message}
        self.latest = {}       # thread -> newest message (summary source)
        self.pending = {}      # thread -> [(start, count, timeout_source)]
        self.loaded = {}       # thread -> messages the daemon held when a page we asked for came in
        self.settle = {}       # thread -> quiet-period timer while a page loads
        self.contacts, self.contact_list = read_contacts(device_id)
        self.file_mimes = {}   # attachment id -> mime, for naming the fetched file
        self.thumbs = cache_dir()

    # -- output --
    def out(self, obj):
        try:
            sys.stdout.write(json.dumps(obj, ensure_ascii=False) + "\n")
            sys.stdout.flush()
        except BrokenPipeError:
            self.loop.quit()

    def name_for(self, address):
        return self.contacts.get(digits_key(address), "")

    # -- conversion --
    def attachment(self, a):
        part, mime, thumb64, uid = a
        entry = {"part": part, "mime": mime, "id": uid, "thumb": ""}
        if thumb64:
            # KDE Connect's thumbnails are PNG whatever the original was.
            safe = re.sub(r"[^A-Za-z0-9_.-]", "_", "%s_%s" % (part, uid))[:120]
            path = os.path.join(self.thumbs, "thumb_%s.png" % safe)
            if not os.path.exists(path):
                try:
                    with open(path, "wb") as f:
                        f.write(base64.b64decode(thumb64))
                except (OSError, ValueError):
                    path = ""
            entry["thumb"] = path
        return entry

    def message(self, v):
        event, body, addrs, date, mtype, read, tid, uid, sub, atts = v
        addresses = [a[0] for a in addrs]
        return {
            "uid": uid, "thread": tid, "body": body, "date": date,
            "type": mtype, "sent": mtype in SENT_TYPES, "read": read == 1,
            "event": event, "addresses": addresses,
            "attachments": [self.attachment(a) for a in atts],
        }

    def summary(self, m):
        addresses = m["addresses"]
        names = [self.name_for(a) for a in addresses]
        body = " ".join((m["body"] or "").split())
        return {
            "id": m["thread"], "addresses": addresses, "names": names,
            "date": m["date"], "snippet": body[:200], "sent": m["sent"],
            "read": m["read"], "attachments": len(m["attachments"]),
            "group": len(addresses) > 1,
        }

    # -- D-Bus --
    def call(self, method, args=None, sig=None, timeout=10000):
        params = GLib.Variant(sig, args) if sig else None
        return self.conn.call_sync(BUS_NAME, self.path, SMS_IF, method, params, None,
                                   Gio.DBusCallFlags.NONE, timeout, None)

    def active(self):
        av = self.call("activeConversations").get_child_value(0)
        out = []
        for i in range(av.n_children()):
            try:
                out.append(self.message(av.get_child_value(i).get_variant().unpack()))
            except (ValueError, TypeError):
                pass
        return out

    def emit_threads(self):
        msgs = self.active()
        for m in msgs:
            self.remember(m)
            cur = self.latest.get(m["thread"])
            if cur is None or m["date"] >= cur["date"]:
                self.latest[m["thread"]] = m
        threads = sorted((self.summary(m) for m in self.latest.values()),
                         key=lambda t: -t["date"])
        self.out({"ev": "threads", "threads": threads})
        self.out({"ev": "contacts", "count": len(self.contacts), "contacts": self.contact_list})

    def remember(self, m):
        bucket = self.cache.setdefault(m["thread"], {})
        old = bucket.get(m["uid"])
        bucket[m["uid"]] = m
        return old

    def on_signal(self, conn, sender, path, iface, signal, params):
        if path != self.path:
            return
        if signal in ("conversationCreated", "conversationUpdated"):
            try:
                m = self.message(params.get_child_value(0).get_variant().unpack())
            except (ValueError, TypeError):
                return
            old = self.remember(m)
            if m["thread"] in self.pending:
                self.progress(m["thread"])
            latest = self.latest.get(m["thread"])
            newest = latest is None or m["date"] >= latest["date"]
            if newest:
                self.latest[m["thread"]] = m
                self.out({"ev": "thread", "thread": self.summary(m)})
            # Live traffic, or a known message whose state moved (sending ->
            # sent, read): push it. History we asked for waits for its page.
            if (old is None and newest) or (old is not None and old != m):
                self.out({"ev": "message", "message": m})
        elif signal == "conversationLoaded":
            # Sent after every batch the daemon takes in, with how many
            # messages it holds for the thread, not how long the conversation
            # is: asking for every thread's latest message says 1 for each.
            # Only the answer to a page asked for here says how far it goes.
            tid, count = params.unpack()
            if tid in self.pending:
                self.loaded[tid] = count
                self.finish_loads(tid, count)
        elif signal == "conversationRemoved":
            tid = params.unpack()[0]
            self.cache.pop(tid, None)
            self.latest.pop(tid, None)
            self.out({"ev": "removed", "thread": tid})
        elif signal == "attachmentReceived":
            file_path, file_name = params.unpack()
            self.out({"ev": "attachment", "path": self.named(file_path, file_name), "name": file_name})

    def named(self, path, name):
        """The daemon saves attachments without an extension, which some
        viewers refuse. Link it under a name that carries its type."""
        mime = self.file_mimes.get(name, "")
        ext = {"image/jpeg": "jpg", "image/jpg": "jpg", "image/png": "png", "image/gif": "gif",
               "video/3gpp": "3gp", "video/mp4": "mp4", "audio/amr": "amr", "audio/mpeg": "mp3"}.get(
            mime, mime.split("/")[-1] if "/" in mime else "")
        if not ext or path.lower().endswith("." + ext):
            return path
        safe = re.sub(r"[^A-Za-z0-9_.-]", "_", name)[:120]
        link = os.path.join(self.thumbs, "%s.%s" % (safe, ext))
        try:
            if os.path.islink(link) or os.path.exists(link):
                os.remove(link)
            os.symlink(path, link)
            return link
        except OSError:
            return path

    def page(self, tid, start, count):
        ordered = sorted(self.cache.get(tid, {}).values(), key=lambda m: -m["date"])
        return ordered[start:start + count], len(ordered)

    def answer(self, tid, start, want):
        msgs, have = self.page(tid, start, want)
        known = self.loaded.get(tid)
        self.out({"ev": "messages", "thread": tid, "start": start, "messages": msgs,
                  "hasMore": len(msgs) == want or (known is not None and known > start + len(msgs))})

    def finish_loads(self, tid, count=None):
        source = self.settle.pop(tid, None)
        if source:
            GLib.source_remove(source)
        for start, want, timeout in self.pending.pop(tid, []):
            GLib.source_remove(timeout)
            self.answer(tid, start, want)

    def progress(self, tid):
        """A message for a thread with a page on the way: answer pages that are
        now full, and restart the quiet-period timer for the rest."""
        have = len(self.cache.get(tid, {}))
        still = []
        for start, want, timeout in self.pending.get(tid, []):
            if have >= start + want:
                GLib.source_remove(timeout)
                self.answer(tid, start, want)
            else:
                still.append((start, want, timeout))
        if not still:
            self.pending.pop(tid, None)
            source = self.settle.pop(tid, None)
            if source:
                GLib.source_remove(source)
            return
        self.pending[tid] = still
        source = self.settle.pop(tid, None)
        if source:
            GLib.source_remove(source)

        def quiet():
            self.settle.pop(tid, None)
            self.finish_loads(tid)
            return False
        self.settle[tid] = GLib.timeout_add(LOAD_SETTLE_MS, quiet)

    def load(self, tid, start, count):
        # Already held: answer now. The daemon sends no conversationLoaded for
        # a range it already has, so waiting would only run into the timeout.
        msgs, have = self.page(tid, start, count)
        known = self.loaded.get(tid)
        if len(msgs) == count or (known is not None and have >= known):
            self.out({"ev": "messages", "thread": tid, "start": start, "messages": msgs,
                      "hasMore": have > start + count or (known is not None and known > have)
                                 or (known is None and len(msgs) == count)})
            if len(msgs) == count:
                # Still ask, so anything newer on the phone comes in as signals.
                try:
                    self.call("requestConversation", (tid, start, start + count), "(xii)")
                except GLib.Error:
                    pass
            return

        def timed_out():
            waiting = self.pending.get(tid, [])
            self.pending[tid] = [w for w in waiting if w[2] != source_holder[0]]
            if not self.pending[tid]:
                self.pending.pop(tid, None)
            msgs, have = self.page(tid, start, count)
            self.out({"ev": "messages", "thread": tid, "start": start, "messages": msgs,
                      "hasMore": False, "timedOut": True})
            return False
        source_holder = [0]
        source_holder[0] = GLib.timeout_add_seconds(LOAD_TIMEOUT_SEC, timed_out)
        self.pending.setdefault(tid, []).append((start, count, source_holder[0]))
        try:
            self.call("requestConversation", (tid, start, start + count), "(xii)")
        except GLib.Error as error:
            self.out({"ev": "error", "cmd": "load", "thread": tid, "message": error.message})

    def command(self, cmd):
        verb = cmd.get("cmd")
        try:
            if verb == "load":
                self.load(int(cmd["thread"]), int(cmd.get("start", 0)), int(cmd.get("count", 30)))
            elif verb == "reply":
                text = str(cmd.get("text", "")).strip()
                if text:
                    self.call("replyToConversation", (int(cmd["thread"]), text, []), "(xsav)")
                    self.out({"ev": "sent", "thread": int(cmd["thread"])})
            elif verb == "send":
                text = str(cmd.get("text", "")).strip()
                addrs = [GLib.Variant("(s)", (str(a),)) for a in cmd.get("addresses", []) if str(a).strip()]
                if text and addrs:
                    self.call("sendWithoutConversation", (addrs, text, []), "(avsav)")
                    self.out({"ev": "sent", "addresses": cmd.get("addresses", [])})
            elif verb == "attachment":
                if cmd.get("mime"):
                    self.file_mimes[str(cmd["id"])] = str(cmd["mime"])
                self.call("requestAttachmentFile", (int(cmd["part"]), str(cmd["id"])), "(xs)")
            elif verb == "refresh":
                self.contacts, self.contact_list = read_contacts(self.device_id)
                self.emit_threads()
                self.call("requestAllConversationThreads")
        except (GLib.Error, KeyError, ValueError, TypeError) as error:
            message = error.message if isinstance(error, GLib.Error) else str(error)
            self.out({"ev": "error", "cmd": verb, "message": message})

    def on_stdin(self, fd, condition):
        if condition & (GLib.IO_HUP | GLib.IO_ERR):
            self.loop.quit()
            return False
        line = sys.stdin.readline()
        if not line:
            self.loop.quit()
            return False
        try:
            self.command(json.loads(line))
        except json.JSONDecodeError:
            self.out({"ev": "error", "message": "unreadable command"})
        return True

    # A restarted daemon starts with an empty cache and knows nothing the
    # phone changed meanwhile (read state included). Once it is back, ask the
    # phone again: every thread's latest message then arrives as a signal and
    # replaces what the old run left here. The device needs a moment to
    # reconnect, so retry until the call goes through.
    RESYNC_RETRY_SEC = 3
    RESYNC_TRIES = 20

    def on_owner_changed(self, conn, sender, path, iface, signal, params):
        name, old_owner, new_owner = params.unpack()
        if name != BUS_NAME or not new_owner:
            return
        tries = [0]

        def attempt():
            tries[0] += 1
            try:
                self.call("requestAllConversationThreads")
                return False
            except GLib.Error:
                return tries[0] < self.RESYNC_TRIES
        GLib.timeout_add_seconds(self.RESYNC_RETRY_SEC, attempt)

    def run(self):
        self.conn.signal_subscribe(BUS_NAME, SMS_IF, None, self.path, None,
                                   Gio.DBusSignalFlags.NONE, self.on_signal)
        self.conn.signal_subscribe("org.freedesktop.DBus", "org.freedesktop.DBus",
                                   "NameOwnerChanged", "/org/freedesktop/DBus",
                                   BUS_NAME, Gio.DBusSignalFlags.NONE, self.on_owner_changed)
        GLib.io_add_watch(sys.stdin.fileno(), GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, self.on_stdin)
        try:
            self.emit_threads()
            # Ask the phone for anything the daemon has not seen yet; updates
            # come back as signals.
            self.call("requestAllConversationThreads")
        except GLib.Error as error:
            self.out({"ev": "error", "cmd": "start", "message": error.message})
        self.loop.run()


def main(argv):
    if not argv:
        return say(__doc__.strip(), EXIT_FAILED)
    if argv[0] == "watch":
        try:
            watch()
        except KeyboardInterrupt:
            pass
        return EXIT_OK
    if argv[0] == "sms":
        if len(argv) < 2:
            return say("sms needs a device id", EXIT_FAILED)
        try:
            Sms(argv[1]).run()
        except KeyboardInterrupt:
            pass
        return EXIT_OK
    if argv[0] == "photos":
        if len(argv) < 2:
            return say("photos needs a device id", EXIT_FAILED)
        count = int(argv[2]) if len(argv) > 2 and argv[2].isdigit() else PHOTO_COUNT
        print(json.dumps(photos(argv[1], count), ensure_ascii=False))
        return EXIT_OK
    if argv[0] == "photos-cached":
        if len(argv) < 2:
            return say("photos-cached needs a device id", EXIT_FAILED)
        print(json.dumps(cached_photos(argv[1]), ensure_ascii=False))
        return EXIT_OK
    if argv[0] == "save-file":
        if len(argv) < 3:
            return say("save-file needs a path and the device's name", EXIT_FAILED)
        return save_file(argv[1], argv[2])
    if argv[0] == "received-dismiss":
        if len(argv) < 3:
            return say("received-dismiss needs a device id and a path", EXIT_FAILED)
        path = received_path(argv[1])
        entries = load_received(path)
        entries[:] = [e for e in entries if e.get("path") != argv[2]]
        save_received(path, entries)
        return EXIT_OK
    if argv[0] == "copy-file":
        return copy_file(argv[1] if len(argv) > 1 else "")
    if argv[0] == "doctor":
        print(json.dumps(doctor()))
        return EXIT_OK
    if argv[0] == "fix":
        return fix(argv[1] if len(argv) > 1 else "")
    if argv[0] == "snapshot":
        print(json.dumps(with_seen(snapshot(bus()), load_seen(seen_path())), indent=2, sort_keys=True, ensure_ascii=False))
        return EXIT_OK
    return act(argv)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
