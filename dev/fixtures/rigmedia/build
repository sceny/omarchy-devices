#!/bin/bash
# Builds rigmedia.apk: an app whose only job is to hold an Android media
# session (title, artist, play/pause/next/seek), so the rig's phone has a real
# player for KDE Connect to export. Needs the Android SDK build-tools, a JDK.
# Usage: dev/fixtures/rigmedia/build OUTPUT_DIR   (prints the apk path)
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
out=${1:?usage: build OUTPUT_DIR}
home=$(getent passwd "$(id -u)" | cut -d: -f6)
sdk=${ANDROID_SDK_ROOT:-${ANDROID_HOME:-$home/Android/Sdk}}
[[ -d $sdk/build-tools ]] || sdk=$home/Android/Sdk
bt=$(ls -d "$sdk"/build-tools/* | sort -V | tail -n1)
aj=$(ls -d "$sdk"/platforms/android-34 2>/dev/null || ls -d "$sdk"/platforms/android-* | sort -V | tail -n1)/android.jar
mkdir -p "$out/classes"
javac -source 8 -target 8 -Xlint:-options -cp "$aj" -d "$out/classes" "$here/src/rig/media/Main.java"
"$bt/d8" --lib "$aj" --output "$out" "$out"/classes/rig/media/*.class
"$bt/aapt2" link -o "$out/base.apk" -I "$aj" --manifest "$here/AndroidManifest.xml" \
  --min-sdk-version 26 --target-sdk-version 34
(cd "$out" && zip -q base.apk classes.dex)
"$bt/zipalign" -f 4 "$out/base.apk" "$out/aligned.apk"
[[ -f $out/debug.keystore ]] || keytool -genkeypair -keystore "$out/debug.keystore" \
  -storepass android -keypass android -alias k -keyalg RSA -keysize 2048 -validity 3650 \
  -dname "CN=rig" >/dev/null 2>&1
"$bt/apksigner" sign --ks "$out/debug.keystore" --ks-pass pass:android --out "$out/rigmedia.apk" "$out/aligned.apk"
echo "$out/rigmedia.apk"
