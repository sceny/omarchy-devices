#!/usr/bin/env python3
"""Run R3, the release regression, for one commit of a plugin, and write its record.

  dev/regression <sha> [--repo OWNER/NAME] [--out DIR] [--timeout SECONDS] [--harness develop|pr]
  dev/regression <sha> [--repo OWNER/NAME] --from-output DIR [--out DIR] [--owner-issues FILE]

The plugin is configured by dev/regression.json at the candidate commit: the
checks script (run by the sandbox after `dev/rig up`), the sandbox steps,
whether the marketplace check runs, and the rows only its owner can judge.
The configuration and the script are read from the candidate itself. This
harness is shared: each plugin runs the same code with its own configuration.

The record (regression-record.md) is built only from what the run measured:
the sandbox's summary.json, the rig's summary.txt, the script's features.tsv
and, when configured, the marketplace check's reports. A row nothing measured
is "not yet", never a pass. A "look" row is a screenshot a person judges; it is
counted in the record and does not change the status. Open issues labelled
needs-owner-setup are listed for the owner and do not change the status.

Exit status: 0 when every row passes; 1 when a row fails or the run left no
evidence; 2 when no row fails but some are not yet checked.

--from-output reads a finished run's output (the same layout) and writes the
record without starting a sandbox. --owner-issues reads the owner-setup issues
from a JSON file (as `gh issue list --json number,title,url` prints them)
instead of GitHub.
"""

import argparse
import datetime
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
SANDBOX = HERE / "sandbox"
MARKETPLACE_CHECK = HERE / "marketplace-check.mjs"
MARKETPLACE_REPO = "https://github.com/omacom/omarchy-plugin-marketplace"
DEFAULT_REPO = "sceny/omarchy-devices"
CONFIG = "dev/regression.json"
OWNER_LABEL = "needs-owner-setup"
PASS, FAIL, NOT_YET, LOOK = "pass", "fail", "not yet", "look"


def fail(message):
    sys.exit(f"regression: {message}")


def git(*args):
    done = subprocess.run(["git", *args], capture_output=True, text=True)
    if done.returncode != 0:
        fail(f"git {' '.join(args)} failed: {done.stderr.strip()}")
    return done.stdout.strip()


def local_commit(sha):
    return subprocess.run(["git", "cat-file", "-e", f"{sha}^{{commit}}"],
                          capture_output=True).returncode == 0


def gh(*args):
    return subprocess.run(["gh", *args], capture_output=True, text=True)


def candidate_file(repo, sha, path):
    """The file at the candidate commit, or None when the commit has no such file."""
    if local_commit(sha):
        done = subprocess.run(["git", "show", f"{sha}:{path}"], capture_output=True, text=True)
        return done.stdout if done.returncode == 0 else None
    done = gh("api", f"repos/{repo}/contents/{path}?ref={sha}", "-H", "Accept: application/vnd.github.raw")
    if done.returncode == 0:
        return done.stdout
    if "HTTP 404" in done.stderr:
        return None
    fail(f"could not read {path} at {sha[:12]} from {repo}: {done.stderr.strip()}")


def candidate_tree(repo, sha):
    if local_commit(sha):
        return git("rev-parse", f"{sha}^{{tree}}")
    done = gh("api", f"repos/{repo}/commits/{sha}", "--jq", ".commit.tree.sha")
    if done.returncode != 0 or not done.stdout.strip():
        fail(f"{sha} is not a commit of {repo}: {done.stderr.strip()}")
    return done.stdout.strip()


def load_config(repo, sha):
    text = candidate_file(repo, sha, CONFIG)
    if text is None:
        fail(f"{repo} at {sha[:12]} has no {CONFIG}")
    try:
        config = json.loads(text)
    except ValueError as error:
        fail(f"{CONFIG} is not JSON: {error}")
    for key, kind in (("script", str), ("steps", str), ("marketplace", bool), ("owner_only", list)):
        if not isinstance(config.get(key), kind):
            fail(f"{CONFIG} needs {key}, a {kind.__name__}")
    return config


def read_summary(output):
    path = output / "summary.json"
    if not path.is_file():
        return None
    try:
        return json.loads(path.read_text())
    except ValueError:
        return None


def sandbox_rows(summary):
    rows = []
    if not summary.get("results"):
        rows.append(("Sandbox: units", "The run ran its units", "dev/sandbox run", FAIL,
                     "summary.json lists no results"))
    for result in summary.get("results", []):
        clean = (result["exit"] == 0 and not result.get("note")
                 and not result.get("oom_killed") and not result.get("timed_out"))
        rows.append((f"Sandbox: {result['step']}", "The step exits 0 in the sandbox",
                     "dev/sandbox run", PASS if clean else FAIL, "summary.json"))
    limits = summary.get("timed_out") or summary.get("oom_killed")
    rows.append(("Sandbox: limits", "The run stays within its time and memory limits",
                 "dev/sandbox run", FAIL if limits else PASS, "summary.json"))
    return rows


def rig_rows(output):
    found = {}
    for path in sorted(output.rglob("summary.txt")):
        with path.open() as handle:
            if not handle.readline().startswith("rig summary for"):
                continue
        evidence = path.relative_to(output).as_posix()
        for line in path.read_text().splitlines():
            match = re.match(r"^(\S+)\s+(pass|FAIL)(\s|$)", line)
            if match:
                name = f"Rig: {match.group(1)}"
                result = PASS if match.group(2) == "pass" else FAIL
                if found.get(name, (PASS, evidence))[0] == FAIL:
                    continue
                found[name] = (result, evidence)
    rows = [(name, "The rig check holds", "dev/rig ci", result, evidence)
            for name, (result, evidence) in found.items()]
    if not rows:
        rows.append(("Rig checks", "The rig checks run", "dev/rig ci", FAIL,
                     "no rig summary in the run's output"))
    return rows


def script_rows(output):
    path = output / "script" / "features.tsv"
    if not path.is_file():
        return [("Script checks", "The script's checks run", "dev/regression.sh", FAIL,
                 "the script wrote no script/features.tsv")]
    rows = []
    for line in path.read_text().splitlines()[1:]:
        if not line.strip():
            continue
        feature, rule, how, result, evidence = (line.split("\t") + [""] * 5)[:5]
        if result not in (PASS, NOT_YET, LOOK):
            result = FAIL
        rows.append((feature, rule, how, result, evidence))
    return rows


def owner_issues(repo, path):
    """The open owner-setup issues, or (None, reason) when they cannot be listed."""
    if path:
        return json.loads(path.read_text()), None
    done = gh("issue", "list", "--repo", repo, "--label", OWNER_LABEL,
              "--state", "open", "--json", "number,title,url")
    if done.returncode != 0:
        return None, done.stderr.strip()
    return json.loads(done.stdout), None


def marketplace_rows(repo, sha, out):
    name = "Marketplace check"
    rule = "The marketplace's validation and security baseline pass on the candidate"
    how = "dev/marketplace-check.mjs"
    source, reports = out / "marketplace-src", out / "marketplace"
    shutil.rmtree(source, ignore_errors=True)
    shutil.rmtree(reports, ignore_errors=True)
    token = gh("auth", "token")
    if token.returncode != 0:
        return [(name, rule, how, FAIL, "gh auth token failed")]
    clone = subprocess.run(["git", "clone", "-q", "--depth", "1", MARKETPLACE_REPO, str(source)],
                           capture_output=True, text=True)
    if clone.returncode != 0:
        return [(name, rule, how, FAIL, "clone of the marketplace failed")]
    install = subprocess.run(["npm", "ci"], cwd=source, capture_output=True, text=True)
    if install.returncode != 0:
        return [(name, rule, how, FAIL, "npm ci in the marketplace clone failed")]
    env = {**os.environ, "GITHUB_TOKEN": token.stdout.strip(), "MARKETPLACE_DIR": str(source),
           "CHECK_REPO_URL": f"https://github.com/{repo}"}
    check = subprocess.run(["node", str(MARKETPLACE_CHECK), sha, str(reports)],
                           env=env, capture_output=True, text=True)
    result = PASS if check.returncode == 0 else FAIL
    return [(name, rule, how, result, f"marketplace/ (exit {check.returncode})")]


def owner_rows(config, issues):
    rows = [(entry["what"], entry["why"], entry["owner"]) for entry in config["owner_only"]]
    rows += [(f"[#{issue['number']} {issue['title']}]({issue['url']})",
              "Only a real Omarchy session can run it",
              "Runs the check on the issue and comments the result")
             for issue in issues]
    return rows


def verdict(rows):
    if any(row[3] == FAIL for row in rows) or not rows:
        return 1
    if any(row[3] == NOT_YET for row in rows):
        return 2
    return 0


def cell(text):
    return str(text).replace("|", "\\|").replace("\n", " ")


def render(repo, sha, tree, when, summary, rows, owner, code):
    verdict_text = {0: "PASS", 1: "FAIL", 2: "NOT PASS (rows not yet checked)"}[code]
    counts = {status: sum(1 for row in rows if row[3] == status) for status in (PASS, FAIL, NOT_YET, LOOK)}
    lines = [
        f"# Regression record for {sha[:12]}",
        "",
        f"- Candidate: [{sha[:7]}](https://github.com/{repo}/commit/{sha}), tree `{tree}`",
        f"- Run: {when}" + (f", {summary['seconds']} s in the sandbox" if summary else ", no sandbox summary"),
        f"- Verdict: **{verdict_text}**: {counts[PASS]} pass, {counts[FAIL]} fail, {counts[NOT_YET]} not yet, {counts[LOOK]} to look at",
        "",
        "| Feature | Rule | How checked | Result | Evidence |",
        "|---|---|---|---|---|",
    ]
    lines += [f"| {' | '.join(cell(c) for c in row[:4])} | {cell(row[4])} |" for row in rows]
    lines += [
        "",
        "## Needs the owner's setup",
        "",
        "| What | Why the rig cannot | What the owner does | Result |",
        "|---|---|---|---|",
    ]
    lines += [f"| {cell(what)} | {cell(why)} | {cell(owner_does)} | |" for what, why, owner_does in owner]
    return "\n".join(lines) + "\n"


def main(argv):
    parser = argparse.ArgumentParser(description="Run R3 for one commit and write its record.")
    parser.add_argument("sha", help="full 40-hex SHA of the candidate commit")
    parser.add_argument("--repo", default=DEFAULT_REPO, help="the plugin's repository, OWNER/NAME")
    parser.add_argument("--out", type=Path,
                        help="record directory (default: under $XDG_STATE_HOME, outside any repository)")
    parser.add_argument("--timeout", type=int, default=3000, help="sandbox run timeout in seconds")
    parser.add_argument("--harness", choices=["develop", "pr"], default="develop",
                        help="dev/ the sandbox runs: develop's (a release candidate) or the commit's own")
    parser.add_argument("--from-output", type=Path, metavar="DIR",
                        help="write the record from a finished run's output, without a sandbox")
    parser.add_argument("--owner-issues", type=Path, metavar="FILE",
                        help="the owner-setup issues as JSON, instead of listing them on GitHub")
    args = parser.parse_args(argv)

    if not re.fullmatch(r"[0-9a-f]{40}", args.sha):
        fail(f"SHA must be 40 lowercase hex characters, got: {args.sha}")
    if not re.fullmatch(r"[\w.-]+/[\w.-]+", args.repo):
        fail(f"--repo must be OWNER/NAME, got: {args.repo}")
    tree = candidate_tree(args.repo, args.sha)
    config = load_config(args.repo, args.sha)

    name = args.repo.split("/")[1]
    out = args.out or Path(Path.home(), ".local", "state", name, "regression", args.sha[:12])
    out.mkdir(parents=True, exist_ok=True)

    if args.from_output:
        output = args.from_output
    else:
        script_text = candidate_file(args.repo, args.sha, config["script"])
        if script_text is None:
            fail(f"{config['script']} is missing at {args.sha[:12]}")
        script = out / "checks.sh"
        script.write_text(script_text)
        output = out / "sandbox-output"
        command = [str(SANDBOX), "run", args.repo, args.sha, "--out", str(output),
                   "--steps", config["steps"], "--script", str(script),
                   "--timeout", str(args.timeout), "--harness", args.harness]
        print(f"regression: {' '.join(command)}", file=sys.stderr)
        subprocess.run(command)

    summary = read_summary(output)
    rows = sandbox_rows(summary) if summary else [
        ("Sandbox: run", "The run leaves its summary", "dev/sandbox run", FAIL, "no summary.json")]
    rows += rig_rows(output) + script_rows(output)
    if config["marketplace"]:
        rows += marketplace_rows(args.repo, args.sha, out)

    issues, reason = owner_issues(args.repo, args.owner_issues)
    if issues is None:
        rows.append(("Owner setup issues", "The open owner-setup issues are listed",
                     f"gh issue list --label {OWNER_LABEL}", FAIL, reason))
        issues = []
    owner = owner_rows(config, issues)

    code = verdict(rows)
    when = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%d %H:%M UTC")
    record = out / "regression-record.md"
    record.write_text(render(args.repo, args.sha, tree, when, summary, rows, owner, code))
    print(f"regression: record written to {record}", file=sys.stderr)
    return code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
