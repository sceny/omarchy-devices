#!/usr/bin/env python3
"""Prepare a release branch so its pull request has the version on the first push.

  dev/release-prepare X.Y.Z                       release-X.Y.Z from origin/develop
  dev/release-prepare X.Y.Z --from main --note "What the fix does"
                                                  fix-X.Y.Z from origin/main
  dev/release-prepare --check-freeze              print whether main is frozen; exit 1 when it is

Both set "version" in manifest.json and commit it with CHANGELOG.md, so the
`release` check on the pull request into develop or main passes at once.

From develop, `## Unreleased` (which must hold entries) becomes
`## X.Y.Z — YYYY-MM-DD`. From main there is no Unreleased section: a new
`## X.Y.Z — YYYY-MM-DD` section is added above the newest version, holding the
`--note` lines (at least one) under `### Fixes`.

A release from develop (minor or patch) is refused while main is frozen: an open
`marketplace-review` issue here points to a marketplace issue that is still open.
The check reads both through `gh`; when it cannot, the release is refused too.
A fix from main is not refused by it (it needs the owner's go) and prints the
freeze as a note.

It refuses: a version already tagged (here or on origin), a version not above
the one in manifest.json on the base, a base whose CHANGELOG already has the
version, an Unreleased section with nothing in it, a branch that exists, and a
working tree with tracked changes. `--no-commit` leaves the edits staged, uncommitted.
It works in any repository with a manifest.json "version" and a CHANGELOG.md
in this format.
"""
import argparse
import datetime
import json
import os
import re
import subprocess
import sys

BRANCHES = {"develop": "release", "main": "fix"}
MARKETPLACE = "omacom/omarchy-plugin-marketplace"


def fail(message):
    sys.exit(f"release-prepare: {message}")


def git(*args, check=True):
    done = subprocess.run(["git", *args], capture_output=True, text=True)
    if check and done.returncode != 0:
        fail(f"git {' '.join(args)} failed: {done.stderr.strip()}")
    return done


def parse_version(text):
    match = re.fullmatch(r"([0-9]+)\.([0-9]+)\.([0-9]+)", text)
    return tuple(int(part) for part in match.groups()) if match else None


def manifest_version(text):
    found = re.findall(r'^\s*"version"\s*:\s*"([^"]*)"', text, re.M)
    if len(found) != 1:
        fail("manifest.json needs exactly one top-level \"version\" line")
    return found[0]


def set_manifest_version(text, version):
    return re.sub(r'^(\s*"version"\s*:\s*")[^"]*(")', rf"\g<1>{version}\g<2>", text, count=1, flags=re.M)


def section_bounds(lines, start):
    end = next((i for i in range(start + 1, len(lines)) if lines[i].startswith("## ")), len(lines))
    return start, end


def changelog_for_develop(text, version, date):
    lines = text.split("\n")
    starts = [i for i, line in enumerate(lines) if line.strip() == "## Unreleased"]
    if len(starts) != 1:
        fail("CHANGELOG.md needs one '## Unreleased' section on develop")
    start, end = section_bounds(lines, starts[0])
    if not any(line.strip() and not line.startswith("#") for line in lines[start + 1:end]):
        fail("'## Unreleased' has no entries: nothing to release")
    lines[start] = f"## {version} — {date}"
    return "\n".join(lines)


def changelog_for_main(text, version, date, notes):
    if not notes:
        fail('a fix from main needs at least one --note "what the fix does"')
    lines = text.split("\n")
    first = next((i for i, line in enumerate(lines) if line.startswith("## ")), None)
    if first is None:
        fail("CHANGELOG.md has no version section to put the new one above")
    if any(line.strip() == "## Unreleased" for line in lines):
        fail("main's CHANGELOG has an Unreleased section: prepare from develop")
    section = [f"## {version} — {date}", "", "### Fixes", "", *[f"- {note}" for note in notes], ""]
    return "\n".join(lines[:first] + section + lines[first:])


def gh_json(*args):
    try:
        done = subprocess.run(["gh", *args], capture_output=True, text=True)
    except OSError as error:
        fail(f"the freeze check needs gh: {error}")
    if done.returncode != 0:
        fail(f"the freeze check could not read GitHub: gh {' '.join(args[:3])} failed: {done.stderr.strip()}")
    try:
        return json.loads(done.stdout)
    except ValueError:
        fail(f"the freeze check could not read gh's answer to: gh {' '.join(args[:3])}")


def freeze_status():
    """Each open marketplace-review issue here, the marketplace issue it points to
    and that issue's state: [(ours, theirs, state)]. theirs is None when the body
    names none."""
    found = []
    for issue in gh_json("issue", "list", "--label", "marketplace-review", "--state", "open", "--limit", "100", "--json", "number,body"):
        match = re.search(re.escape(MARKETPLACE) + r"#([0-9]+)", issue.get("body") or "")
        if not match:
            found.append((issue["number"], None, "UNKNOWN"))
            continue
        theirs = int(match.group(1))
        state = gh_json("issue", "view", str(theirs), "--repo", MARKETPLACE, "--json", "state").get("state", "UNKNOWN")
        found.append((issue["number"], theirs, state))
    return found


def freeze_lines(found):
    lines = []
    for ours, theirs, state in found:
        if theirs is None:
            lines.append(f"#{ours}: no {MARKETPLACE} issue named in its body: main is treated as frozen until it names one")
        elif state == "OPEN":
            lines.append(f"#{ours} -> {MARKETPLACE}#{theirs} OPEN: a review is in progress and main is frozen")
        elif state == "CLOSED":
            lines.append(f"#{ours} -> {MARKETPLACE}#{theirs} CLOSED: out of sync; read the marketplace issue's last report, comment the outcome on #{ours} and close it")
        else:
            lines.append(f"#{ours} -> {MARKETPLACE}#{theirs} {state}: main is treated as frozen")
    return lines


def is_frozen(found):
    return any(state not in ("CLOSED",) for _, _, state in found)


def main():
    parser = argparse.ArgumentParser(description="Prepare a release or fix branch with its version and CHANGELOG section.")
    parser.add_argument("version", nargs="?", help="X.Y.Z")
    parser.add_argument("--check-freeze", action="store_true", help="print whether main is frozen (exit 1) or clear (exit 0), prepare nothing")
    parser.add_argument("--from", dest="base", choices=sorted(BRANCHES), default="develop", help="develop (release-X.Y.Z) or main (fix-X.Y.Z)")
    parser.add_argument("--note", action="append", default=[], help="a CHANGELOG entry, for a fix from main (repeat)")
    parser.add_argument("--date", default=None, help="YYYY-MM-DD, default today")
    parser.add_argument("--remote", default="origin")
    parser.add_argument("--no-commit", action="store_true", help="leave the edits staged, uncommitted, on the new branch")
    args = parser.parse_args()

    if args.check_freeze:
        if args.version:
            fail("--check-freeze takes no version")
        found = freeze_status()
        for line in freeze_lines(found):
            print(line)
        print("main is frozen" if is_frozen(found) else "main is not frozen" + (": nothing is under review" if not found else ""))
        sys.exit(1 if is_frozen(found) else 0)
    if not args.version:
        parser.error("a version X.Y.Z is needed (or --check-freeze)")
    new = parse_version(args.version)
    if new is None:
        fail(f"'{args.version}' is not X.Y.Z")
    date = args.date or datetime.date.today().isoformat()
    if not re.fullmatch(r"[0-9]{4}-[0-9]{2}-[0-9]{2}", date):
        fail(f"'{date}' is not YYYY-MM-DD")
    if args.base == "develop" and args.note:
        fail("--note is for a fix from main; from develop the entries are the Unreleased section")

    os.chdir(git("rev-parse", "--show-toplevel").stdout.strip())
    found = freeze_status()
    if is_frozen(found):
        detail = "\n  ".join(freeze_lines(found))
        if args.base == "develop":
            fail(f"main is frozen, so a release is not prepared (Releasing, step 0):\n  {detail}\n"
                 "a fix users need now is --from main, after the owner's go")
        print(f"release-prepare: note: main is frozen:\n  {detail}", file=sys.stderr)
    if git("status", "--porcelain", "--untracked-files=no").stdout.strip():
        fail("the working tree has tracked changes: commit or set them aside first")

    git("fetch", "--quiet", "--tags", args.remote, args.base)
    tag = f"v{args.version}"
    if git("rev-parse", "-q", "--verify", f"refs/tags/{tag}", check=False).returncode == 0:
        fail(f"{tag} is already tagged")
    if git("ls-remote", "--tags", args.remote, f"refs/tags/{tag}").stdout.strip():
        fail(f"{tag} is already tagged on {args.remote}")

    base = f"{args.remote}/{args.base}"
    branch = f"{BRANCHES[args.base]}-{args.version}"
    if git("rev-parse", "-q", "--verify", f"refs/heads/{branch}", check=False).returncode == 0:
        fail(f"branch {branch} already exists")
    if git("ls-remote", "--heads", args.remote, branch).stdout.strip():
        fail(f"branch {branch} already exists on {args.remote}")

    manifest = git("show", f"{base}:manifest.json").stdout
    changelog = git("show", f"{base}:CHANGELOG.md").stdout
    current = parse_version(manifest_version(manifest))
    if current is None or new <= current:
        fail(f"{args.version} is not above {manifest_version(manifest)}, the version on {base}")
    if re.search(rf"^## {re.escape(args.version)} ", changelog, re.M):
        fail(f"CHANGELOG.md on {base} already has a section for {args.version}")

    if args.base == "develop":
        changelog = changelog_for_develop(changelog, args.version, date)
    else:
        changelog = changelog_for_main(changelog, args.version, date, args.note)
    manifest = set_manifest_version(manifest, args.version)

    git("switch", "-c", branch, "--no-track", base)
    with open("manifest.json", "w") as handle:
        handle.write(manifest)
    with open("CHANGELOG.md", "w") as handle:
        handle.write(changelog)
    git("add", "manifest.json", "CHANGELOG.md")
    if not args.no_commit:
        git("commit", "--quiet", "-m", f"Release {args.version}: CHANGELOG and manifest version")
    print(f"{branch} from {base}: manifest.json {args.version}, CHANGELOG.md '## {args.version} — {date}'"
          + ("" if args.no_commit else ", committed"))
    print(f"next: git push -u {args.remote} {branch}; gh pr create --base {args.base} ...")


if __name__ == "__main__":
    main()
