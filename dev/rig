#!/bin/bash
# Isolated test rig for the Devices plugin (sceny.devices).
#
# Usage:
#   dev/rig up [--visible] [--no-phone] [--bare] [--ttl SECONDS] [--owner PID|none]
#                                        bring the rig up, hidden, and leave it running
#   dev/rig down                         tear it down and prove nothing is left
#   dev/rig ci [--evidence DIR]          up, run every check, tear down (one command)
#   dev/rig check                        run the checks against a running rig
#   dev/rig status                       what is running, and where
#   dev/rig screenshot [file.png]        capture the nested shell (works hidden)
#   dev/rig phone [status|battery N|notify T X|sms 555.. X|call 555..|hangup N|shot|pair|refresh]
#                                        drive the rig's emulator and its KDE Connect link
#   dev/rig sync                         install the working tree as the plugin and enable it
#   dev/rig ipc <function> [args]        call the panel: dev/rig ipc status, dev/rig ipc open
#   dev/rig restart-shell                restart only the nested shell (after a .js change)
#   dev/rig show | hide                  put the rig on the owner's screen / take it off again
#   dev/rig ps [--json]                  every live rig: owner, age, time left
#   dev/rig reap [--dry-run]             end every rig whose owner is gone or whose TTL is up
#   dev/rig adopt [--owner PID|none] [--ttl SECONDS]
#                                        give a running rig a new owner and a fresh TTL
#   dev/rig logs [shell|compositor|emulator|kdeconnectd|bus|adb|keeper|stubs]
#   dev/rig exec -- <command...>         run a command inside the rig (sandbox, bus, namespace)
#   dev/rig verify-clean                 prove no rig has left anything behind
#   dev/rig probe -- <command...>        one-off probe in a private runtime dir, cores off
#   dev/rig selftest                     test the lease, keeper, ps and reap (no compositor needed)
#   dev/rig --rig <id> <command>         act on one named rig (a part of the id is enough)
#
# What it guarantees, and why it exists:
#
#   * HIDDEN BY DEFAULT. The Omarchy shell under test runs in its own Hyprland,
#     inside a headless Wayland parent (labwc). Nothing is mapped on any monitor
#     of the owner's session: no window on their workspaces, no moved or
#     retiled windows, no stolen focus. Screenshots and shell IPC work while
#     hidden. A window appears only on `dev/rig show` (or `up --visible`), and
#     only the owner asks for that: an agent or CI run is refused.
#   * NO ZOMBIES. A rig has one owner process and a TTL. When the owner ends,
#     crashes or is killed, or the TTL is up, the compositor, shell, emulator,
#     daemon and temp dirs go. `dev/rig ps` lists every rig, `dev/rig reap`
#     ends the dead ones, and `down` proves nothing is left.
#   * The owner's Hyprland session, bar, shell, config, KDE Connect daemon, adb
#     server and phone are never restarted, reloaded, reconfigured or written to.
#   * The shell under test has its own HOME, XDG directories and runtime dir,
#     and installs the plugin into a throwaway ~/.config/omarchy/plugins.
#   * THE PHONE IS AN EMULATOR. A headless Android emulator, paired to a
#     kdeconnectd on the rig's own session bus, all inside a network namespace
#     with no route out: the owner's daemon and phone cannot see it, and it
#     cannot see them. `--no-phone` skips all of it.
#   * Two rigs at the same time share nothing: their own runtime dirs, buses,
#     namespaces, sockets and process tags.
#   * The PID namespace is shared with the host: never kill by name.
#
# See README.md ("Testing the plugin") for the walkthrough, and dev/rig.conf
# for the per-plugin settings a second plugin repo changes.

set -uo pipefail

RIG_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

# shellcheck source=rig.conf
source "$RIG_DIR/rig.conf"

RIG_PLUGIN_SRC_ABS=$(cd -- "$RIG_DIR/$RIG_PLUGIN_SRC" && pwd) ||
  {
    echo "dev/rig: RIG_PLUGIN_SRC ($RIG_PLUGIN_SRC) does not resolve" >&2
    exit 1
  }

# shellcheck source=rig.d/lib.sh
source "$RIG_DIR/rig.d/lib.sh"
# shellcheck source=rig.d/lease.sh
source "$RIG_DIR/rig.d/lease.sh"
# shellcheck source=rig.d/display.sh
source "$RIG_DIR/rig.d/display.sh"
# shellcheck source=rig.d/selftest.sh
source "$RIG_DIR/rig.d/selftest.sh"
# shellcheck source=rig.d/phone.sh
source "$RIG_DIR/rig.d/phone.sh"
# shellcheck source=rig.d/checks.sh
source "$RIG_DIR/rig.d/checks.sh"

# ------------------------------------------------------------------ usage ----

rig_usage() {
  awk 'NR > 1 { if (/^#/) print; else exit }' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

# ------------------------------------------------------- dependency check ----

rig_require_tools() {
  local missing=() tool
  for tool in Hyprland quickshell qs omarchy hyprctl grim jq curl git python3 flock setsid prlimit; do
    command -v "$tool" >/dev/null 2>&1 || missing+=("$tool")
  done
  if ((${#missing[@]})); then
    rig_die "missing tools: ${missing[*]}"
  fi
}

# ---------------------------------------------------------------------- up ----

RIG_UP_SUCCEEDED=0

rig_up_cleanup_on_failure() {
  ((RIG_UP_SUCCEEDED)) && return 0
  if [[ -n ${RIG_KEEP_FAILED:-} ]]; then
    rig_warn "bringing the rig up failed; RIG_KEEP_FAILED keeps it for inspection (the TTL still ends it)"
    return 0
  fi
  rig_warn "bringing the rig up failed — tearing down what started"
  # Logs are the only way to see why. One fixed directory, overwritten by the
  # next failure, so a failed run leaves no pile behind.
  local keep="$RIG_TMP_ROOT/last-failed-up"
  rm -rf "$keep"
  rig_teardown "$keep"
}

cmd_up() {
  local view=hidden ttl=${RIG_TTL:-$RIG_DEFAULT_TTL} phone=1 install=1
  while (($#)); do
    case $1 in
    --visible) view=visible ;;
    --hidden) view=hidden ;;
    --no-phone) phone=0 ;;
    --bare) install=0 ;;
    --ttl)
      ttl=${2:?--ttl needs seconds}
      shift
      ;;
    --owner)
      RIG_OWNER_PID=${2:?--owner needs a pid or none}
      shift
      ;;
    *) rig_die "up: unknown option $1" ;;
    esac
    shift
  done
  [[ $ttl =~ ^[0-9]+$ ]] || rig_die "up: --ttl needs a whole number of seconds"
  [[ $view == visible ]] && rig_refuse_unrequested_visible

  rig_require_tools
  ((phone)) && rig_phone_require
  [[ $view == visible ]] || rig_require_headless_parent
  rig_ensure_root
  reap_dead_rigs_quietly

  local owner existing
  owner=$(rig_resolve_owner)
  existing=$( (
    unset OPR_RIG_ID RIG_SELECT
    rig_select >/dev/null 2>&1 && echo "$RIG_ID"
  ))
  [[ -z $existing ]] ||
    rig_die "this owner already has a rig ($existing); run 'dev/rig down', or give the second one its own --owner"

  local session
  session=$(rig_new_session_dir)
  rig_define_paths "$session"
  RIG_VIEW=$view
  RIG_TTL=$ttl
  RIG_HYPR_PID="" RIG_PARENT_PID="" RIG_SHELL_PID="" RIG_NESTED_DISPLAY=""
  RIG_NETNS_PID="" RIG_BUS_PID="" RIG_EMU_PID=""
  rig_guard_sandbox

  rig_say "Bringing up the rig for $RIG_PLUGIN_ID ($RIG_VIEW)"
  rig_create_sandbox
  trap rig_up_cleanup_on_failure EXIT
  trap 'rig_teardown; exit 130' INT TERM

  rig_state_set plugin_id "$RIG_PLUGIN_ID"
  rig_state_set view "$RIG_VIEW"
  rig_state_set phone "$phone"
  rig_state_set source "$RIG_PLUGIN_SRC_ABS"
  rig_lease_init "$owner" "$ttl"
  if [[ $owner == none ]]; then
    RIG_OWNER_DESC="none (only the TTL ends it)"
  else
    RIG_OWNER_DESC="$(rig_proc_comm "$owner") pid $owner"
  fi

  # What the owner's desktop looks like before the rig exists, for `down` to
  # compare against. Read-only queries; there may be no desktop (CI, SSH).
  rig_host_snapshot "$RIG_EVIDENCE/host-before.json" ||
    rig_warn "no desktop session to snapshot; the before/after comparison will be skipped"
  rig_phone_host_snapshot "$RIG_EVIDENCE/host-phone-before.txt"

  rig_seed_omarchy_config
  rig_write_stubs
  rig_export_env
  rig_guard_no_host_systemd
  rig_ok "sandbox at $RIG_SESSION (HOME=$RIG_HOME)"

  # The keeper starts before anything else does, so a run killed halfway
  # through `up` still leaves nothing behind.
  rig_keeper_start

  ((phone)) && rig_phone_start
  rig_start_compositor
  rig_start_shell
  rig_build_package_repo
  ((phone)) && rig_phone_finish
  ((install)) && rig_sync_plugin

  RIG_UP_SUCCEEDED=1
  trap - EXIT
  trap - INT TERM

  rig_say "Rig is up"
  cmd_status
  cat >&2 <<INFO

  Next:
    dev/rig sync                   put the working tree into the rig (after an edit)
    dev/rig ipc status             ask the panel what it shows
    dev/rig check                  run the checks
    dev/rig screenshot shot.png    capture the shell (works while hidden)
    dev/rig phone notify Hi "A test"   post a notification on the emulator
    dev/rig exec -- omarchy plugin list
    dev/rig down                   tear it down

INFO
}

# ------------------------------------------------------------- plugin loop ----

rig_ipc_wait() {
  local i
  for ((i = 0; i < ${1:-40}; i++)); do
    rig_ipc status >/dev/null 2>&1 && return 0
    sleep 0.5
  done
  return 1
}

rig_sync_plugin() {
  # The working tree becomes the installed plugin: built into the package repo,
  # added the way a user adds it, enabled into the bar. Run again after an edit.
  rig_say "Plugin"
  rig_build_package_repo
  if rig_plugin_installed; then
    omarchy plugin remove "$RIG_PLUGIN_ID" --yes >>"$RIG_LOGS/plugin.log" 2>&1 ||
      rig_die "could not remove the installed plugin (see $RIG_LOGS/plugin.log)"
  fi
  omarchy plugin add "file://$RIG_PKG_REPO" --yes >>"$RIG_LOGS/plugin.log" 2>&1 ||
    rig_die "could not add the plugin (see $RIG_LOGS/plugin.log)"
  # The shell takes a moment to rescan: "not known" and "not responding" are
  # retried, anything else fails.
  local i out
  for ((i = 0; i < 30; i++)); do
    out=$(omarchy plugin enable "$RIG_PLUGIN_ID" "$RIG_BAR_SECTION" 2>&1) && break
    printf '%s\n' "$out" >>"$RIG_LOGS/plugin.log"
    [[ $out == *"is not known"* || $out == *"is not responding"* ]] || break
    sleep 1
  done
  for ((i = 0; i < 30; i++)); do
    omarchy plugin list --json 2>/dev/null |
      jq -e --arg id "$RIG_PLUGIN_ID" 'any(.[]; .id == $id and .enabled == true)' >/dev/null 2>&1 && break
    sleep 1
  done
  ((i < 30)) || rig_die "could not enable the plugin (see $RIG_LOGS/plugin.log)"
  rig_ipc_wait 60 || rig_die "the panel does not answer over IPC; read dev/rig logs shell"
  rig_ok "plugin installed and enabled"
}

cmd_sync() {
  rig_select || rig_die "no rig for this owner; run 'dev/rig up' first"
  rig_export_env
  rig_guard_sandbox
  rig_guard_nested_shell
  rig_sync_plugin
}

cmd_ipc() {
  rig_select || rig_die "no rig for this owner; run 'dev/rig up' first"
  rig_export_env
  rig_guard_sandbox
  rig_guard_nested_shell
  (($#)) || rig_die "ipc: a function name (status, open, close, page settings, ...)"
  rig_ipc "$@"
}

# ------------------------------------------------------------------- down ----

rig_report_host() {
  # rig_report_host <before.json> <keep-dir|""> — compare the owner's desktop
  # now with how it was before `up`.
  local before=$1 keep=$2 after diff_out status=0
  after=$(mktemp "${TMPDIR:-/tmp}/rig-host-after.XXXXXX")
  rig_say "The owner's desktop"
  if ! rig_host_snapshot "$after"; then
    rig_warn "no desktop session to compare; skipped"
  else
    diff_out=$(rig_host_compare "$before" "$after") || status=$?
    case $status in
    0) rig_ok "windows, workspaces and focus are exactly as before the rig came up" ;;
    2) rig_warn "no 'before' snapshot to compare against" ;;
    *)
      rig_warn "the desktop differs from before the rig (the owner may have been using it):"
      printf '%s\n' "$diff_out" >&2
      ;;
    esac
    if [[ -n $keep ]]; then
      mkdir -p "$keep"
      cp "$before" "$keep/host-before.json"
      cp "$after" "$keep/host-after.json"
      [[ -z ${diff_out:-} ]] || printf '%s\n' "$diff_out" >"$keep/host-diff.txt"
    fi
  fi
  rm -f "$after"
  rig_report_phone_host "$keep"
}

rig_report_phone_host() {
  # The owner's kdeconnectd, adb server and emulators: the same processes after
  # the rig as before it.
  local keep=${1:-} before="$RIG_EVIDENCE/host-phone-before.txt" out status=0
  rig_say "The owner's KDE Connect and adb"
  out=$(rig_phone_host_unchanged "$before") || status=$?
  case $status in
  0) rig_ok "kdeconnectd, adb and emulator processes of the owner are exactly as before the rig" ;;
  2) rig_warn "no 'before' list of the owner's phone processes; skipped" ;;
  *)
    rig_warn "the owner's phone processes differ from before the rig (the owner may have started or stopped some):"
    printf '%s\n' "$out" >&2
    ;;
  esac
  [[ -z $keep ]] || cp "$before" "$keep/host-phone-before.txt" 2>/dev/null || true
}

cmd_down() {
  local keep=""
  while (($#)); do
    case $1 in
    --keep-evidence)
      keep=${2:?--keep-evidence needs a directory}
      shift
      ;;
    *) rig_die "down: unknown option $1" ;;
    esac
    shift
  done

  rig_select || {
    rig_warn "no rig for this owner (dev/rig ps lists every rig)"
    return 0
  }
  local before status=0
  before=$(mktemp "${TMPDIR:-/tmp}/rig-host-before.XXXXXX")
  cp "$RIG_EVIDENCE/host-before.json" "$before" 2>/dev/null ||
    printf '{"available":false}\n' >"$before"
  rig_teardown "$keep" || status=1
  rig_verify_clean || status=1
  rig_report_host "$before" "$keep"
  rm -f "$before"
  return $status
}

cmd_verify_clean() {
  # Not "is this rig gone" (down proves that) but "has any rig left anything":
  # processes that carry a tag whose rig is gone, runtime dirs with no rig,
  # rigs whose owner has gone and that nobody has reaped yet.
  local stale=0 tag pid rt suffix dir state live=0
  rig_say "Looking for leftovers of any rig"
  while read -r tag pid; do
    [[ -n $tag && ! -d $RIG_TMP_ROOT/$tag ]] || continue
    rig_fail "process $pid ($(rig_proc_comm "$pid")) belongs to $tag, whose rig is gone"
    stale=1
  done < <(rig_tag_scan)
  for rt in "$RIG_RUNTIME_ROOT"/opr.*; do
    [[ -d $rt ]] || continue
    suffix=${rt##*opr.}
    compgen -G "$RIG_TMP_ROOT/*.$suffix" >/dev/null && continue
    rig_fail "runtime dir with no rig: $rt"
    stale=1
  done
  for dir in $(rig_session_dirs); do
    state=$(rig_lease_state "$dir")
    case $state in
    orphaned | expired)
      rig_fail "${dir##*/} is $state and not reaped yet; run 'dev/rig reap'"
      stale=1
      ;;
    *) live=$((live + 1)) ;;
    esac
  done
  ((stale)) && return 1
  rig_ok "no leaked processes or directories ($live live rig(s), all with a live lease)"
}

# ------------------------------------------------------------------ status ----

cmd_status() {
  rig_select || {
    rig_warn "no rig for this owner (dev/rig ps lists every rig)"
    return 1
  }
  {
    printf '  rig         %s\n' "$RIG_ID"
    printf '  plugin      %s\n' "$(rig_state_get plugin_id || echo "$RIG_PLUGIN_ID")"
    printf '  source      %s\n' "$(rig_state_get source || echo '?')"
    printf '  view        %s\n' "$RIG_VIEW"
    printf '  owner       %s pid %s\n' "$(rig_state_get owner_name || echo '-')" "$(rig_state_get owner_pid || echo none)"
    printf '  lease       %s, ttl %s\n' "$(rig_lease_state "$RIG_SESSION")" "$(rig_fmt_duration "$(rig_state_get ttl || echo 0)")"
    printf '  session     %s\n' "$RIG_SESSION"
    printf '  sandbox     HOME=%s\n' "$RIG_HOME"
    printf '  runtime     %s\n' "$RIG_RUNTIME_DIR"
    printf '  hyprland    %s (pacman -Q; never Hyprland --version)\n' "$(rig_hyprland_version)"
    printf '  compositor  pid %s  display %s\n' "${RIG_HYPR_PID:-?}" "${RIG_NESTED_DISPLAY:-?}"
    [[ -n ${RIG_PARENT_PID:-} ]] &&
      printf '  parent      pid %s (headless parent compositor)\n' "$RIG_PARENT_PID"
    printf '  shell       pid %s\n' "${RIG_SHELL_PID:-?}"
    if [[ -n ${RIG_NETNS_PID:-} ]]; then
      printf '  namespace   holder pid %s (%s, no route out)\n' "$RIG_NETNS_PID" "$RIG_NS_ADDR"
      printf '  phone       emulator pid %s, bus pid %s, kdeconnectd pid %s\n' \
        "${RIG_EMU_PID:-?}" "${RIG_BUS_PID:-?}" "$(rig_state_get kdeconnectd_pid || echo '?')"
    else
      printf '  phone       none (started with --no-phone)\n'
    fi
    printf '  evidence    %s\n' "$RIG_EVIDENCE"
    printf '  logs        %s\n' "$RIG_LOGS"
    printf '  plugin dir  %s\n' "$RIG_PLUGINS_DIR"
  } >&2
}

# ------------------------------------------------------------------ checks ----

cmd_check() {
  rig_select || rig_die "no rig for this owner; run 'dev/rig up' first (dev/rig ps lists every rig)"
  rig_export_env
  rig_guard_sandbox
  rig_guard_nested_display
  rig_guard_nested_shell
  rig_guard_no_host_systemd
  rig_guard_stubs
  rig_guard_hidden

  rig_plugin_installed && omarchy plugin remove "$RIG_PLUGIN_ID" --yes >/dev/null 2>&1
  rig_check_host_untouched
  rig_check_lease
  rig_check_shell_services_off
  rig_check_manifest
  rig_check_cold_install
  rig_check_enable
  rig_check_devices
  rig_check_screenshot
  rig_check_hidden
  rig_check_repeat_install
  rig_check_disable
  rig_check_remove
  rig_check_shell_services_off
  rig_check_host_untouched
  rig_check_hidden

  rig_write_summary_file
  rig_check_summary
}

# ---------------------------------------------------------------------- ci ----

cmd_ci() {
  local out="$RIG_DIR/../.rig-evidence" up_args=()
  while (($#)); do
    case $1 in
    --visible) up_args+=(--visible) ;;
    --ttl)
      up_args+=(--ttl "${2:?--ttl needs seconds}")
      shift
      ;;
    --evidence)
      out=${2:?--evidence needs a directory}
      shift
      ;;
    *) rig_die "ci: unknown option $1" ;;
    esac
    shift
  done

  # `ci` owns its rig. If it is killed, the keeper ends the rig within seconds.
  [[ -n ${RIG_OWNER_PID:-} ]] || RIG_OWNER_PID=$$
  [[ " ${up_args[*]} " == *" --ttl "* ]] || up_args+=(--ttl "$RIG_CI_TTL")

  cmd_up "${up_args[@]}" || return 1
  local status=0
  # A subshell: rig_die exits, and an exit here would skip the teardown.
  (cmd_check) || status=$?
  cmd_down --keep-evidence "$out" || status=1
  if ((status)); then
    rig_fail "rig ci failed; evidence in $out"
  else
    rig_ok "rig ci passed; evidence in $out"
  fi
  return $status
}

# ------------------------------------------------------------------- probe ----

cmd_probe() {
  # An ad-hoc probe needs no rig, but it needs the same manners: a private
  # runtime dir and HOME that vanish afterwards, no host display or bus, no cores.
  [[ ${1:-} == -- ]] && shift
  (($#)) || rig_die "probe: nothing to run"
  if [[ ${1##*/} == Hyprland ]]; then
    local arg safe=0
    for arg in "$@"; do
      [[ $arg == --verify-config || $arg == --help || $arg == -h ]] && safe=1
    done
    ((safe)) || rig_die "probe: only 'Hyprland --verify-config' and '--help' are allowed here. A compositor needs a parent and would otherwise reach for the owner's GPU and input devices: use 'dev/rig up'. The version is 'pacman -Q hyprland'."
  fi
  rig_no_cores

  local root status=0
  root=$(mktemp -d "$RIG_RUNTIME_ROOT/opr-p.XXXXXX") || rig_die "probe: cannot create a private runtime dir"
  mkdir -m 700 "$root/home"
  # shellcheck disable=SC2064 # $root is fixed for this probe
  trap "rm -rf '$root'; exit 130" INT TERM
  (
    export HOME="$root/home" XDG_RUNTIME_DIR="$root"
    export XDG_CONFIG_HOME="$HOME/.config" XDG_DATA_HOME="$HOME/.local/share"
    export XDG_STATE_HOME="$HOME/.local/state" XDG_CACHE_HOME="$HOME/.cache"
    unset WAYLAND_DISPLAY HYPRLAND_INSTANCE_SIGNATURE DBUS_SESSION_BUS_ADDRESS \
      DBUS_SYSTEM_BUS_ADDRESS NOTIFY_SOCKET BASH_ENV ENV
    [[ ${1##*/} == Hyprland ]] && rig_guard_compositor_env
    "$@"
  ) || status=$?

  local stray
  for stray in $(pgrep -f -- "$root" 2>/dev/null); do
    [[ $stray == "$$" ]] && continue
    kill -KILL "$stray" 2>/dev/null || true
  done
  rm -rf "$root"
  trap - INT TERM
  [[ ! -e $root ]] || rig_die "probe: $root survived cleanup"
  return "$status"
}

# ------------------------------------------------------------- screenshot ----

cmd_screenshot() {
  rig_select || rig_die "no rig for this owner; run 'dev/rig up' first"
  rig_export_env
  rig_guard_nested_display
  local out=${1:-$RIG_EVIDENCE/nested-shell.png}
  rig_grim_wait "$out" || rig_die "grim failed"
  [[ -s $out ]] || rig_die "grim wrote an empty file"
  rig_ok "wrote $out ($(stat -c %s "$out") bytes, $RIG_VIEW view)"
  printf '%s\n' "$out"
}

# --------------------------------------------------------------- show/hide ----

cmd_view() {
  # cmd_view <hidden|visible> — move the rig's compositor and shell to another
  # parent. HOME, the installed plugin and the phone are not
  # touched, so the rig comes back as it was, in a different place.
  local target=$1
  rig_select || rig_die "no rig for this owner; run 'dev/rig up' first"
  [[ $target == visible ]] && rig_refuse_unrequested_visible
  if [[ $RIG_VIEW == "$target" ]]; then
    rig_ok "the rig is already $target"
    return 0
  fi
  rig_export_env
  rig_guard_sandbox

  rig_say "Moving the rig from $RIG_VIEW to $target"
  rig_stop_display
  RIG_VIEW=$target
  rig_state_set view "$target"
  rig_start_compositor
  rig_start_shell
  if [[ $target == visible ]]; then
    rig_ok "the rig is a window of the owner's session now; 'dev/rig hide' takes it away"
  else
    rig_ok "the rig is hidden again"
  fi
}

# ----------------------------------------------------------- restart-shell ----

cmd_restart_shell() {
  # Quickshell reloads QML on a plugin change but keeps the JS modules it has
  # already imported, so after a .js edit the shell must be started again. The
  # compositor, the phone and shell.json stay as they are, so the
  # installed plugin and its bar placement survive.
  rig_select || rig_die "no rig for this owner; run 'dev/rig up' first"
  rig_export_env
  rig_guard_sandbox
  rig_guard_nested_display
  rig_guard_nested_shell

  local old=$RIG_SHELL_PID
  rig_say "Restarting the nested shell (pid $old)"
  rig_kill_tree "$old" TERM
  rig_wait_gone "$old" 10 || rig_kill_tree "$old" KILL
  rig_wait_gone "$old" 5 || rig_die "the old nested shell (pid $old) will not stop"
  rig_state_set shell_pid ""
  RIG_SHELL_PID=""

  rig_start_shell
}

# ------------------------------------------------------------------- adopt ----

cmd_adopt() {
  rig_select || rig_die "no rig to adopt; name one with --rig <id> (dev/rig ps)"
  local ttl
  ttl=$(rig_state_get ttl || echo "$RIG_DEFAULT_TTL")
  while (($#)); do
    case $1 in
    --owner)
      RIG_OWNER_PID=${2:?--owner needs a pid or none}
      shift
      ;;
    --ttl)
      ttl=${2:?--ttl needs seconds}
      shift
      ;;
    *) rig_die "adopt: unknown option $1" ;;
    esac
    shift
  done
  [[ $ttl =~ ^[0-9]+$ ]] || rig_die "adopt: --ttl needs a whole number of seconds"
  local owner
  owner=$(rig_resolve_owner)
  rig_lease_init "$owner" "$ttl"
  rig_ok "$RIG_ID is now owned by ${owner}, ttl $(rig_fmt_duration "$ttl") from now"
}

# -------------------------------------------------------------------- logs ----

cmd_logs() {
  rig_select || rig_die "no rig for this owner"
  case ${1:-shell} in
  shell) tail -n "${2:-80}" "$RIG_LOGS/shell.log" ;;
  compositor) tail -n "${2:-80}" "$RIG_LOGS/compositor.log" ;;
  emulator) tail -n "${2:-80}" "$RIG_LOGS/emulator.log" ;;
  kdeconnectd) tail -n "${2:-80}" "$RIG_LOGS/kdeconnectd.log" ;;
  bus) tail -n "${2:-80}" "$RIG_LOGS/bus.log" ;;
  adb) tail -n "${2:-80}" "$RIG_LOGS/adb.log" ;;
  keeper) tail -n "${2:-80}" "$RIG_LOGS/keeper.log" ;;
  stubs) cat "$RIG_LOGS/stub-calls.log" ;;
  *) rig_die "logs: unknown target $1" ;;
  esac
}

# -------------------------------------------------------------------- exec ----

cmd_exec() {
  rig_select || rig_die "no rig for this owner"
  rig_export_env
  rig_guard_sandbox
  rig_guard_nested_display
  [[ ${1:-} == -- ]] && shift
  (($#)) || rig_die "exec: nothing to run"
  cd "$RIG_PLUGIN_SRC_ABS" || exit 1
  exec "${RIG_IN_NS[@]}" "$@"
}

# ------------------------------------------------------------------ dispatch ----

# --rig <id> can come before or after the command.
args=()
while (($#)); do
  case $1 in
  --rig)
    RIG_SELECT=${2:?--rig needs a rig id (dev/rig ps lists them)}
    shift
    ;;
  --rig=*) RIG_SELECT=${1#--rig=} ;;
  *) args+=("$1") ;;
  esac
  shift
done
set -- "${args[@]:-help}"

command=$1
shift || true

case $command in
up) cmd_up "$@" ;;
down) cmd_down "$@" ;;
ci) cmd_ci "$@" ;;
check) cmd_check "$@" ;;
status) cmd_status "$@" ;;
screenshot) cmd_screenshot "$@" ;;
show) cmd_view visible ;;
hide) cmd_view hidden ;;
restart-shell) cmd_restart_shell "$@" ;;
phone) cmd_phone "$@" ;;
ipc) cmd_ipc "$@" ;;
sync) cmd_sync "$@" ;;
ps) cmd_ps "$@" ;;
reap) cmd_reap "$@" ;;
adopt) cmd_adopt "$@" ;;
logs) cmd_logs "$@" ;;
exec) cmd_exec "$@" ;;
probe) cmd_probe "$@" ;;
verify-clean) cmd_verify_clean "$@" ;;
selftest) cmd_selftest "$@" ;;
_keeper) cmd_keeper "$@" ;;
help | -h | --help) rig_usage ;;
*)
  rig_fail "unknown command: $command"
  rig_usage
  exit 1
  ;;
esac
