#!/usr/bin/env python3
"""A made-up phone media player, for screenshots.

Demo mode fakes notifications and conversations, but media always comes from
the MPRIS players KDE Connect exports, so a screenshot would show whatever the
real phone plays. This puts one player on the session bus that looks like
KDE Connect's for the demo device ("... - Pixel 8"), playing a made-up track
with a generated cover, until it is stopped (Ctrl+C or SIGTERM).

    tools/demo-player [cover.png]

Every control is accepted and ignored except play/pause, so a click in the
panel still looks right. Nothing reaches a phone.
"""

import os
import signal
import sys
import time

import warnings

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

warnings.simplefilter("ignore", DeprecationWarning)

BUS_NAME = "org.mpris.MediaPlayer2.kdeconnect.mpris_demo"
PATH = "/org/mpris/MediaPlayer2"
LENGTH_US = 214_000_000          # 3:34
START_US = 83_000_000            # 1:23 in

XML = """
<node>
  <interface name="org.mpris.MediaPlayer2">
    <method name="Raise"/><method name="Quit"/>
    <property name="CanQuit" type="b" access="read"/>
    <property name="CanRaise" type="b" access="read"/>
    <property name="HasTrackList" type="b" access="read"/>
    <property name="Identity" type="s" access="read"/>
    <property name="DesktopEntry" type="s" access="read"/>
    <property name="SupportedUriSchemes" type="as" access="read"/>
    <property name="SupportedMimeTypes" type="as" access="read"/>
  </interface>
  <interface name="org.mpris.MediaPlayer2.Player">
    <method name="Next"/><method name="Previous"/><method name="Pause"/>
    <method name="PlayPause"/><method name="Stop"/><method name="Play"/>
    <method name="Seek"><arg direction="in" name="Offset" type="x"/></method>
    <method name="SetPosition">
      <arg direction="in" name="TrackId" type="o"/><arg direction="in" name="Position" type="x"/>
    </method>
    <method name="OpenUri"><arg direction="in" name="Uri" type="s"/></method>
    <signal name="Seeked"><arg name="Position" type="x"/></signal>
    <property name="PlaybackStatus" type="s" access="read"/>
    <property name="Rate" type="d" access="readwrite"/>
    <property name="Metadata" type="a{sv}" access="read"/>
    <property name="Volume" type="d" access="readwrite"/>
    <property name="Position" type="x" access="read"/>
    <property name="MinimumRate" type="d" access="read"/>
    <property name="MaximumRate" type="d" access="read"/>
    <property name="CanGoNext" type="b" access="read"/>
    <property name="CanGoPrevious" type="b" access="read"/>
    <property name="CanPlay" type="b" access="read"/>
    <property name="CanPause" type="b" access="read"/>
    <property name="CanSeek" type="b" access="read"/>
    <property name="CanControl" type="b" access="read"/>
  </interface>
</node>
"""


class Player:
    def __init__(self, cover):
        self.playing = True
        self.started = time.monotonic() - START_US / 1e6
        self.paused_at = START_US
        self.cover = cover
        self.conn = None

    def position(self):
        if not self.playing:
            return self.paused_at
        # Round and round the track, so it never runs past its end.
        return int((time.monotonic() - self.started) * 1e6) % LENGTH_US

    def metadata(self):
        meta = {
            "mpris:trackid": GLib.Variant("o", "/org/mpris/MediaPlayer2/demo"),
            "mpris:length": GLib.Variant("x", LENGTH_US),
            "xesam:title": GLib.Variant("s", "Midnight Drive"),
            "xesam:artist": GLib.Variant("as", ["The Quiet Hours"]),
            "xesam:album": GLib.Variant("s", "Neon Coast"),
        }
        if self.cover:
            meta["mpris:artUrl"] = GLib.Variant("s", "file://" + self.cover)
        return meta

    def prop(self, iface, name):
        root = {
            "CanQuit": GLib.Variant("b", False), "CanRaise": GLib.Variant("b", False),
            "HasTrackList": GLib.Variant("b", False),
            "Identity": GLib.Variant("s", "Spotify - Pixel 8"),
            "DesktopEntry": GLib.Variant("s", ""),
            "SupportedUriSchemes": GLib.Variant("as", []),
            "SupportedMimeTypes": GLib.Variant("as", []),
        }
        player = {
            "PlaybackStatus": GLib.Variant("s", "Playing" if self.playing else "Paused"),
            "Rate": GLib.Variant("d", 1.0),
            "Metadata": GLib.Variant("a{sv}", self.metadata()),
            "Volume": GLib.Variant("d", 0.6),
            "Position": GLib.Variant("x", self.position()),
            "MinimumRate": GLib.Variant("d", 1.0), "MaximumRate": GLib.Variant("d", 1.0),
            "CanGoNext": GLib.Variant("b", True), "CanGoPrevious": GLib.Variant("b", True),
            "CanPlay": GLib.Variant("b", True), "CanPause": GLib.Variant("b", True),
            "CanSeek": GLib.Variant("b", True), "CanControl": GLib.Variant("b", True),
        }
        return (root if iface == "org.mpris.MediaPlayer2" else player).get(name)

    def toggle(self):
        if self.playing:
            self.paused_at = self.position()
        else:
            self.started = time.monotonic() - self.paused_at / 1e6
        self.playing = not self.playing
        self.conn.emit_signal(None, PATH, "org.freedesktop.DBus.Properties", "PropertiesChanged",
                              GLib.Variant("(sa{sv}as)", ("org.mpris.MediaPlayer2.Player",
                                           {"PlaybackStatus": self.prop("org.mpris.MediaPlayer2.Player", "PlaybackStatus")}, [])))

    def on_call(self, conn, sender, path, iface, method, params, invocation):
        if method in ("PlayPause", "Play", "Pause") and (method == "PlayPause" or (method == "Play") != self.playing):
            self.toggle()
        invocation.return_value(None)

    def on_get(self, conn, sender, path, iface, name):
        return self.prop(iface, name)

    def on_set(self, conn, sender, path, iface, name, value):
        return True


def main():
    cover = os.path.abspath(sys.argv[1]) if len(sys.argv) > 1 else ""
    player = Player(cover)
    node = Gio.DBusNodeInfo.new_for_xml(XML)
    loop = GLib.MainLoop()

    def acquired(conn, name):
        player.conn = conn
        for iface in node.interfaces:
            conn.register_object(PATH, iface, player.on_call, player.on_get, player.on_set)

    Gio.bus_own_name(Gio.BusType.SESSION, BUS_NAME, Gio.BusNameOwnerFlags.NONE,
                     acquired, None, lambda *a: loop.quit())
    for sig in (signal.SIGINT, signal.SIGTERM):
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, sig, loop.quit)
    loop.run()


if __name__ == "__main__":
    main()
