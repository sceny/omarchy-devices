#!/usr/bin/env bash
# The marketplace and README image (preview.png), composed from two demo
# screenshots of a 2560x1440 desktop: the panel's main page (Shortcuts
# folded, Apps, notifications, Now playing and the Gallery open), and the
# messages view with a conversation open; and a made-up phone screen
# (tools/phone-screen) as the screen's window. docs/internals/screenshots.md
# says how to take them; demo data only.
#
#   tools/listing-image MAIN.png MESSAGES.png OUT.png
#
# The coordinates below are where the pill and the two cards sit in those
# screenshots; measure again (the card border is the accent colour) if the
# panel's size or the bar changes.
set -euo pipefail

main=$1 msgs=$2 out=$3
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

BG='#111C18' FG='#C1C497' ACCENT='#509475'
BOLD=JetBrainsMono-NF-Bold REGULAR=JetBrainsMono-NF-Regular

MSGS_CARD=1205x907+1350+40   # the messages view in MESSAGES.png
PILL=108x34+2250+0           # the pill in the bar
PILL_BOX="2244,3 2362,35"    # an outline around it

# The messages card, smaller, with a soft shadow.
magick "$msgs" -crop "$MSGS_CARD" +repage -resize 70% "$tmp/msgs.png"
magick "$tmp/msgs.png" \( +clone -background black -shadow 70x24+0+18 \) \
  +swap -background none -layers merge +repage "$tmp/msgs-shadow.png"

# The pill, three times its size, on a card of its own.
magick "$main" -crop "$PILL" +repage -filter Lanczos -resize 300% \
  -bordercolor "$BG" -border 18 -bordercolor "$ACCENT" -border 3 "$tmp/pill.png"

# The phone's screen as a window here: a made-up home screen, framed in the
# accent colour as Omarchy frames a window, with the same shadow.
# Its clock and date are the desktop's when MAIN was taken (the bar's).
"$(dirname "$0")/phone-screen" "$tmp/phone-full.png" 1080x2316 \
  "$(date -r "$main" +%H:%M)" "$(date -r "$main" '+%A, %-d %B')"
magick "$tmp/phone-full.png" -resize x820 -bordercolor "$ACCENT" -border 3 "$tmp/phone.png"
magick "$tmp/phone.png" \( +clone -background black -shadow 70x24+0+18 \) \
  +swap -background none -layers merge +repage "$tmp/phone-shadow.png"

# The desktop, darkened towards the left so the words read over the
# wallpaper; the bar and the panel stay as they are.
magick "$main" \
  \( -size 2020x1406 gradient:'rgba(0,0,0,0.80)'-'rgba(0,0,0,0.45)' -rotate -90 -resize 2020x1406! \) \
  -geometry +0+34 -composite "$tmp/base.png"

# Labels on the right point at the panel's sections (its left edge is at
# x 1990): Apps (outlined, as the pill is: with the screen, what the image
# leads with), the notifications, Now playing, the Gallery.
APPS_BOX="1996,182 2548,352"
magick "$tmp/base.png" \
  -stroke "$ACCENT" -strokewidth 3 -fill none \
  -draw "roundrectangle ${PILL_BOX} 6,6" \
  -draw "roundrectangle ${APPS_BOX} 8,8" \
  -draw "line 1775,328 1994,328" \
  -draw "line 1760,566 1985,566" \
  -draw "line 1835,886 1985,886" \
  -draw "line 1760,1206 1985,1206" \
  -stroke none \
  "$tmp/pill.png" -geometry +1600+60 -composite \
  "$tmp/msgs-shadow.png" -geometry +50+690 -composite \
  "$tmp/phone-shadow.png" -geometry +950+548 -composite \
  -gravity NorthWest -fill "$FG" \
  -font "$BOLD" -pointsize 72 -annotate +110+130 'Your phone,' \
  -annotate +110+216 'in the Omarchy bar' \
  -font "$REGULAR" -pointsize 30 -fill "$FG" \
  -annotate +112+320 'Its screen and apps in windows here, and its' \
  -annotate +112+362 'notifications, texts, calls, media and photos:' \
  -annotate +112+404 'your Android phone or tablet, without picking it up.' \
  -font "$BOLD" -pointsize 24 -fill "$ACCENT" \
  -annotate +1600+222 'NOTIFICATIONS IN YOUR BAR ↗' \
  -annotate +112+620 'YOUR TEXTS' \
  -annotate +1490+520 'NOTIFICATIONS' \
  -annotate +1490+840 'NOW PLAYING' \
  -annotate +1490+1160 'GALLERY' \
  -font "$BOLD" -pointsize 34 -fill "$ACCENT" \
  -annotate +970+468 'ITS SCREEN' \
  -annotate +1490+272 'ITS APPS' \
  -font "$REGULAR" -pointsize 28 -fill "$FG" \
  -annotate +970+510 'in a window here' \
  -annotate +1490+314 'each in a window' \
  -font "$REGULAR" -pointsize 24 -fill "$FG" \
  -annotate +112+654 'every conversation, from the keyboard' \
  -annotate +1490+554 'reply and dismiss' \
  -annotate +1490+874 'cover, seek and volume' \
  -annotate +1490+1194 'its newest photos' \
  -strip "$out"
